// Design system « Alcyon » de Halcyon 1.0 (successeur de « Nocturne », 0.4) — voir
// docs/DESIGN-SYSTEM.md. Halcyon est le martin-pêcheur ; les « jours alcyoniens » sont la mer
// calme d'hiver : fonds bleu d'eau profonde, accent cobalt (plumes), orange (poitrail) réservé
// à ce qui est vivant, et une seule signature, la ligne d'horizon cobalt → orange.
//
// Toutes les valeurs visuelles passent par ce fichier : couleurs (modifiables depuis Rust
// pour les thèmes et l'accent), échelle typographique, espacements, rayons, élévations et
// mouvement. Les noms de la 0.3 sont conservés : les thèmes importés restent compatibles.

export global Theme {
    // ---------------------------------------------------------------- couleurs
    // Couches : bg (fond) < sidebar < surface (cartes) < surface-hover < surface-active.
    in-out property <color> bg: #0c1726;
    in-out property <color> sidebar: #091220;
    in-out property <color> surface: #13223a;
    in-out property <color> surface-hover: #1a2d4a;
    in-out property <color> surface-active: #22395c;
    in-out property <color> border: #9cc3ff12;
    in-out property <color> border-strong: #9cc3ff26;
    /// Verre : panneaux posés sur une illustration (opacité modérée, sans flou coûteux).
    out property <color> glass: self.bg.with-alpha(0.72);
    out property <color> glass-strong: self.bg.with-alpha(0.88);
    /// Voile pour le texte sur une image.
    out property <color> scrim: #000000a6;

    in-out property <color> text: #e9f0f8;
    in-out property <color> text-muted: #9fb3cc;
    in-out property <color> text-dim: #7b93b3;

    in-out property <color> accent: #32b4ff;
    out property <color> accent-hover: self.accent.brighter(0.15);
    out property <color> accent-pressed: self.accent.darker(0.15);
    in-out property <color> on-accent: #04203a;
    out property <color> accent-soft: self.accent.with-alpha(0.12);
    out property <color> accent-glow: self.accent.with-alpha(0.35);
    /// Ligne d'horizon : la signature visuelle (sélection active, progression).
    out property <brush> horizon: @linear-gradient(90deg, self.accent 0%, self.warm 100%);
    out property <brush> horizon-v: @linear-gradient(180deg, self.accent 0%, self.warm 100%);
    /// Anneau de focus (clavier, manette) : toujours visible, jamais seul indicateur d'état.
    out property <color> focus: self.accent;

    in-out property <color> warm: #ff8b3d;
    in-out property <color> danger: #ff6b78;
    in-out property <color> success: #4fd6a0;
    /// Fond du mode Big Picture.
    in-out property <color> bp-bg: #070f1b;

    // ---------------------------------------------------------------- forme
    out property <length> radius-sm: 6px;
    out property <length> radius: 10px;
    out property <length> radius-lg: 18px;
    out property <length> radius-xl: 26px;
    out property <length> focus-width: 2px;

    // ---------------------------------------------------------------- espacements (grille de 4 px)
    /// Densité : 0 confortable, 1 compacte.
    in-out property <int> density: 0;
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: self.density == 1 ? 14px : 16px;
    out property <length> s5: self.density == 1 ? 20px : 24px;
    out property <length> s6: self.density == 1 ? 26px : 32px;
    out property <length> s7: self.density == 1 ? 36px : 48px;
    out property <length> page-padding: self.density == 1 ? 24px : 36px;
    out property <length> nav-height: self.density == 1 ? 34px : 40px;
    out property <length> control-height: self.density == 1 ? 34px : 40px;

    // ---------------------------------------------------------------- typographie
    /// Police d'affichage (titres, chiffres, mode console) ; Inter pour le texte courant.
    out property <string> display: "Sora";
    /// Facteur de taille du texte (accessibilité) : 0,9 à 1,3.
    in-out property <float> text-scale: 1.0;
    out property <length> t-display: 48px * self.text-scale;
    out property <length> t-title: 34px * self.text-scale;
    out property <length> t-heading: 20px * self.text-scale;
    out property <length> t-subheading: 16px * self.text-scale;
    out property <length> t-body: 14px * self.text-scale;
    out property <length> t-small: 13px * self.text-scale;
    out property <length> t-caption: 12px * self.text-scale;
    out property <length> t-overline: 11px * self.text-scale;

    // ---------------------------------------------------------------- mouvement
    /// 0 : complet, 1 : réduit (fondus courts, aucun déplacement), 2 : aucun.
    in-out property <int> motion: 0;
    /// Compatibilité 0.3 : vrai sauf en mode « aucun ».
    in-out property <bool> animations: true;
    out property <duration> fast: self.motion == 2 || !self.animations ? 0ms : self.motion == 1 ? 70ms : 120ms;
    out property <duration> normal: self.motion == 2 || !self.animations ? 0ms : self.motion == 1 ? 100ms : 200ms;
    out property <duration> slow: self.motion == 2 || !self.animations ? 0ms : self.motion == 1 ? 140ms : 320ms;
    /// Amplitude des déplacements animés (0 en mouvement réduit).
    out property <length> motion-distance: self.motion == 0 && self.animations ? 12px : 0px;
    /// Effets coûteux (ombres larges, fond animé) : coupés en mode Performance.
    in-out property <bool> effects: true;

    // ---------------------------------------------------------------- fond
    /// Image de fond facultative (assombrie) et fond animé (désactivé par défaut).
    in-out property <image> background-image;
    in-out property <bool> has-background: false;
    in-out property <float> background-opacity: 0.18;
    in-out property <bool> animated-background: false;
}

/// Masques de fondu (images alpha teintées par `colorize`) : contrairement aux dégradés,
/// une image mise à l'échelle se redessine à l'identique quand seule une partie de l'écran
/// change (rendu logiciel), sans ligne de raccord.
export global Art {
    out property <image> fade-left: @image-url("art/fade-left.png");
    out property <image> fade-bottom: @image-url("art/fade-bottom.png");
    out property <image> fade-top: @image-url("art/fade-top.png");
}

