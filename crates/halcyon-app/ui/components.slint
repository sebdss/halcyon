// Composants du système de design « Berge » (docs/DESIGN-SYSTEM.md).
//
// Règles de construction, vérifiées pour chaque composant :
// - focalisables au clavier et à la manette (Tab, flèches via la manette), activation par
//   Entrée ou Espace, anneau de focus visible ;
// - la racine ne porte ni animation, ni opacité, ni ombre, ni visibilité conditionnelle :
//   sinon le compilateur Slint recopie le composant à chaque utilisation (code généré,
//   mémoire de compilation et temps de création de l'interface multipliés). Les effets
//   animés vivent dans un enfant ;
// - aucune valeur visuelle en dur : tout vient de `Theme` ;
// - géométrie droite (rayons de 3 à 8 px), pas de lueur, pas de dégradé décoratif : l'état
//   se lit à la teinte, à la graisse du texte et à la perche d'accent.

import { Theme, Icons, Layout } from "theme.slint";
import { Sound } from "sound.slint";
import { GameCard, BarItem, MenuEntry } from "types.slint";

/// Icône teintée. Dans une rangée, elle prend la hauteur de la rangée et se dessine
/// centrée verticalement (le texte voisin et l'icône restent alignés à toute échelle).
export component Icon inherits Image {
    in property <length> size: 20px;
    in property <color> tint: Theme.text;
    width: size;
    min-height: size;
    preferred-height: size;
    colorize: tint;
    image-fit: contain;
    vertical-alignment: center;
    horizontal-alignment: center;
}

/// Zone focalisable commune : Entrée / Espace déclenchent `activated`.
component Focusable inherits FocusScope {
    callback activated;
    focus-on-click: false;
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.activated();
            return accept;
        }
        reject
    }
}

/// Anneau de focus (dessiné autour du contrôle, à 3 px).
component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> corner;
    border-radius: corner + 2px;
    border-width: shown ? Theme.focus-width : 0px;
    border-color: Theme.focus;
}

/// Bouton principal : action de validation d'un écran (accent plein).
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <length> font-size: Theme.t-small;
    in property <length> h: Theme.control-height;
    out property <bool> focused: fs.has-focus;
    callback clicked;

    height: h;
    min-width: 88px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: fs;

    bg := Rectangle {
        border-radius: Theme.radius;
        background: !root.enabled ? Theme.surface-active : ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent;
        animate background { duration: Theme.fast; }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; corner: Theme.radius; shown: fs.has-focus; }
    HorizontalLayout {
        padding-left: has-icon ? 14px : 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if has-icon: Icon {
            source: icon;
            size: 16px;
            tint: enabled ? Theme.on-accent : Theme.text-dim;
        }
        Text {
            text: root.text;
            color: enabled ? Theme.on-accent : Theme.text-dim;
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    fs := Focusable {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
}

/// Bouton « Jouer » : le geste de Halcyon, toujours orange, toujours le même dessin.
/// `big` : version des en-têtes (fiche, accueil, console).
export component PlayButton inherits Rectangle {
    in property <string> text: @tr("Jouer");
    in property <bool> enabled: true;
    in property <bool> big: false;
    /// État « en cours » (lancement, jeu ouvert) : libellé conservé, bouton atténué.
    in property <bool> busy: false;
    out property <bool> focused: fs.has-focus;
    callback clicked;

    height: root.big ? 48px : Theme.control-height;
    min-width: root.big ? 156px : 96px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: fs;

    bg := Rectangle {
        border-radius: Theme.radius;
        background: !root.enabled ? Theme.surface-active : root.busy ? Theme.warm.with-alpha(0.35) : ta.pressed ? Theme.warm.darker(0.12) : ta.has-hover ? Theme.warm-hover : Theme.warm;
        animate background { duration: Theme.fast; }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; corner: Theme.radius; shown: fs.has-focus; }
    HorizontalLayout {
        padding-left: root.big ? 22px : 14px;
        padding-right: root.big ? 26px : 18px;
        spacing: root.big ? 12px : 8px;
        alignment: center;
        Icon {
            source: Icons.play;
            size: root.big ? 18px : 14px;
            tint: root.enabled ? Theme.on-warm : Theme.text-dim;
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.on-warm : Theme.text-dim;
            font-family: Theme.display;
            font-size: root.big ? Theme.t-subheading : Theme.t-small;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    fs := Focusable {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
}

/// Bouton secondaire : contour fin, sans fond.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <length> h: Theme.control-height;
    out property <bool> focused: fs.has-focus;
    callback clicked;

    height: h;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: fs;
    property <color> fg: !root.enabled ? Theme.text-dim : root.danger ? Theme.danger : Theme.text;

    bg := Rectangle {
        border-radius: Theme.radius;
        background: !root.enabled ? transparent : ta.pressed ? Theme.surface-active : ta.has-hover ? Theme.surface-hover : transparent;
        border-width: 1px;
        border-color: root.danger && root.enabled ? Theme.danger.with-alpha(0.45) : ta.has-hover ? Theme.border-strong.with-alpha(0.3) : Theme.border-strong;
        animate background { duration: Theme.fast; }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; corner: Theme.radius; shown: fs.has-focus; }
    HorizontalLayout {
        // Icône seule : bouton carré, sans marge vide à droite.
        padding-left: root.text == "" ? 9px : has-icon ? 12px : 16px;
        padding-right: root.text == "" ? 9px : 16px;
        spacing: root.text == "" ? 0px : 8px;
        alignment: center;
        if has-icon: Icon {
            source: icon;
            size: 16px;
            tint: root.fg;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.t-small;
            font-weight: 550;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    fs := Focusable {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
}

/// Lien d'action en texte (« Tout voir », « Modifier ») : accent, souligné au survol.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> tint: Theme.accent;
    callback clicked;
    height: 28px;
    width: lbl.preferred-width + 4px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: fs;
    lbl := Text {
        x: 2px;
        text: root.text;
        color: !root.enabled ? Theme.text-dim : root.tint;
        font-size: Theme.t-small;
        font-weight: 600;
        vertical-alignment: center;
    }
    Rectangle {
        x: 2px;
        y: root.height / 2 + lbl.preferred-height / 2;
        width: ta.has-hover || fs.has-focus ? lbl.preferred-width : 0px;
        height: 1px;
        background: root.tint;
    }
    if fs.has-focus: Rectangle { x: -3px; width: root.width + 6px; border-radius: Theme.radius-sm; border-width: Theme.focus-width; border-color: Theme.focus; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    fs := Focusable {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
}

/// Bouton carré contenant une icône. L'infobulle apparaît au survol et au focus.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 34px;
    in property <length> icon-size: 18px;
    in property <color> tint: Theme.text-muted;
    in property <color> active-tint: Theme.text;
    in property <bool> active: false;
    /// Posé sur une image : fond sombre opaque pour rester lisible.
    in property <bool> glass: false;
    in property <bool> enabled: true;
    in property <string> tooltip;
    /// Petit compteur en exposant (centre de commandes).
    in property <string> badge;
    out property <bool> focused: fs.has-focus;
    callback clicked;

    width: size;
    height: size;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;

    bg := Rectangle {
        border-radius: Theme.radius;
        background: root.glass ? (ta.has-hover || fs.has-focus ? #000000b8 : #00000080) : (ta.pressed ? Theme.surface-active : ta.has-hover || root.active ? Theme.surface-hover : transparent);
        animate background { duration: Theme.fast; }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; corner: Theme.radius; shown: fs.has-focus; }
    Icon {
        source: icon;
        size: icon-size;
        tint: !root.enabled ? Theme.text-dim.with-alpha(0.5) : root.active || ta.has-hover || fs.has-focus ? root.active-tint : root.tint;
    }
    // Repère d'état actif : trait d'accent sous l'icône.
    if root.active && !root.glass: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 4px;
        width: 12px;
        height: 2px;
        background: root.active-tint == Theme.text ? Theme.accent : root.active-tint;
    }
    if root.badge != "": Rectangle {
        x: root.width - self.width + 3px;
        y: -3px;
        width: max(15px, bt.preferred-width + 8px);
        height: 15px;
        border-radius: Theme.radius-sm;
        background: Theme.accent;
        bt := Text { text: root.badge; color: Theme.on-accent; font-size: 10px; font-weight: 700; }
    }
    if root.tooltip != "" && (ta.has-hover || fs.has-focus): Rectangle {
        y: root.height + 6px;
        x: (root.width - self.width) / 2;
        width: tt.preferred-width + 16px;
        height: 26px;
        border-radius: Theme.radius-sm;
        background: Theme.text;
        tt := Text { text: root.tooltip; color: Theme.bg; font-size: Theme.t-caption; font-weight: 500; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    fs := Focusable {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }
}

/// Puce activable (filtres).
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback toggled;

    height: 30px;
    min-width: row.preferred-width;
    accessible-role: checkbox;
    accessible-checked: checked;
    accessible-label: text;
    accessible-action-default => { root.toggled(); }
    forward-focus: fs;

    bg := Rectangle {
        border-radius: Theme.radius-sm;
        background: root.checked ? Theme.accent-soft : ta.has-hover ? Theme.surface-hover : transparent;
        border-width: 1px;
        border-color: root.checked ? Theme.accent.with-alpha(0.5) : Theme.border-strong;
        animate background, border-color { duration: Theme.fast; }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; corner: Theme.radius-sm; shown: fs.has-focus; }
    row := HorizontalLayout {
        padding-left: 11px;
        padding-right: 12px;
        spacing: 6px;
        if root.checked || root.has-icon: Icon {
            source: root.has-icon ? root.icon : Icons.check;
            size: 14px;
            tint: root.checked ? Theme.accent : Theme.text-muted;
        }
        Text {
            text: root.text;
            color: root.checked ? Theme.text : Theme.text-muted;
            font-size: Theme.t-small;
            font-weight: root.checked ? 600 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    fs := Focusable { activated => { root.toggled(); } }
}

/// Sélecteur segmenté (un seul choix). Flèches gauche/droite quand il a le focus.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    callback activated(int);

    height: 32px;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: fs.has-focus ? Theme.focus-width : 0px;
    border-color: Theme.focus;
    accessible-role: tab-list;
    forward-focus: fs;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            seg-bg := Rectangle {
                border-radius: Theme.radius-sm;
                background: root.selected == i ? Theme.surface-active : seg-ta.has-hover ? Theme.surface-hover : transparent;
                animate background { duration: Theme.fast; }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: item;
                    font-size: Theme.t-small;
                    font-weight: root.selected == i ? 600 : 500;
                    color: root.selected == i ? Theme.text : Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    Sound.play("ui.setting");
                    root.activated(i);
                }
            }
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.RightArrow && root.selected < root.items.length - 1) {
                root.selected += 1;
                root.activated(root.selected);
                return accept;
            }
            if (event.text == Key.LeftArrow && root.selected > 0) {
                root.selected -= 1;
                root.activated(root.selected);
                return accept;
            }
            reject
        }
    }
}

/// Onglets de contenu : texte seul, perche d'accent sous l'onglet actif.
export component Tabs inherits HorizontalLayout {
    in property <[string]> items;
    /// Onglets masqués (section indisponible) : même longueur que `items`, vide = tous visibles.
    in property <[bool]> hidden;
    in-out property <int> selected;
    callback activated(int);
    spacing: 24px;
    alignment: start;
    for item[i] in root.items: Rectangle {
        width: root.hidden.length > i && root.hidden[i] ? 0px : tab-text.preferred-width;
        height: 44px;
        accessible-role: tab;
        accessible-label: item;
        accessible-action-default => { root.selected = i; root.activated(i); }
        tab-text := Text {
            x: 0;
            visible: !(root.hidden.length > i && root.hidden[i]);
            text: item;
            color: root.selected == i ? Theme.text : tab-ta.has-hover || tab-fs.has-focus ? Theme.text : Theme.text-muted;
            font-size: Theme.t-body;
            font-weight: root.selected == i ? 600 : 500;
        }
        Rectangle {
            x: 0;
            y: parent.height - 2px;
            height: 2px;
            width: root.selected == i ? parent.width : 0px;
            background: Theme.accent;
            animate width { duration: Theme.normal; easing: ease-out; }
        }
        if tab-fs.has-focus: Rectangle { x: -6px; width: parent.width + 12px; y: 6px; height: parent.height - 12px; border-radius: Theme.radius-sm; border-width: Theme.focus-width; border-color: Theme.focus; }
        tab-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected = i; root.activated(i); }
        }
        tab-fs := FocusScope {
            enabled: !(root.hidden.length > i && root.hidden[i]);
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") {
                    root.selected = i;
                    root.activated(i);
                    return accept;
                }
                reject
            }
        }
    }
}

/// Champ de saisie mono-ligne.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> mono: false;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    height: 36px;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: placeholder;

    bg := Rectangle {
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: input.has-focus ? Theme.focus : ta.has-hover ? Theme.border-strong : Theme.border;
        animate border-color { duration: Theme.fast; }
    }
    // Focus : trait d'accent sous le champ, en plus du contour.
    if input.has-focus: Rectangle { y: root.height - 2px; height: 2px; background: Theme.focus; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: has-icon ? 10px : 12px;
        padding-right: 12px;
        spacing: 8px;
        if has-icon: Icon {
            source: root.icon;
            size: 16px;
            tint: input.has-focus ? Theme.text-muted : Theme.text-dim;
        }
        Rectangle {
            clip: true;
            Text {
                x: 0;
                width: parent.width;
                text: root.text == "" ? root.placeholder : "";
                color: Theme.text-dim;
                font-size: Theme.t-small;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                text <=> root.text;
                single-line: true;
                color: Theme.text;
                font-size: Theme.t-small;
                font-family: root.mono ? "Consolas" : "";
                vertical-alignment: center;
                selection-background-color: Theme.accent.with-alpha(0.4);
                selection-foreground-color: Theme.text;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
    }
}

/// Champ de saisie multi-ligne.
export component TextArea inherits Rectangle {
    in-out property <string> text;
    forward-focus: input;
    accessible-role: text-input;
    bg := Rectangle {
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: input.has-focus ? Theme.focus : Theme.border;
    }
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    Rectangle {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: parent.height - 20px;
        clip: true;
        input := TextInput {
            text <=> root.text;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text;
            font-size: Theme.t-small;
            selection-background-color: Theme.accent.with-alpha(0.4);
        }
    }
}

/// Interrupteur on/off : piste droite, curseur carré (dessin propre à Halcyon).
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 38px;
    height: 20px;
    accessible-role: switch;
    accessible-checked: checked;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(root.checked); } }
    forward-focus: fs;

    track := Rectangle {
        border-radius: Theme.radius-sm + 1px;
        background: !root.enabled ? Theme.surface : root.checked ? Theme.accent : Theme.surface-active;
        border-width: root.checked || !root.enabled ? 0px : 1px;
        border-color: Theme.border-strong;
        animate background { duration: Theme.fast; }
    }
    FocusRing { x: -3px; y: -3px; width: root.width + 6px; height: root.height + 6px; corner: Theme.radius-sm + 1px; shown: fs.has-focus; }
    knob := Rectangle {
        width: 14px;
        height: 14px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 2px;
        background: !root.enabled ? Theme.text-dim : root.checked ? Theme.on-accent : Theme.text-muted;
        animate x { duration: Theme.fast; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            Sound.play(root.checked ? "ui.toggle-on" : "ui.toggle-off");
            root.toggled(root.checked);
        }
    }
    fs := Focusable {
        enabled: root.enabled;
        activated => {
            root.checked = !root.checked;
            Sound.play(root.checked ? "ui.toggle-on" : "ui.toggle-off");
            root.toggled(root.checked);
        }
    }
}

/// Étiquette (plateforme, état) : rectangle discret, texte court.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text-muted;
    in property <bool> solid: false;

    height: 20px;
    min-width: lbl.preferred-width + 12px;
    border-radius: Theme.radius-sm;
    background: solid ? tint.with-alpha(0.16) : transparent;
    border-width: solid ? 0px : 1px;
    border-color: tint == Theme.text-muted ? Theme.border-strong : tint.with-alpha(0.45);
    lbl := Text {
        text: root.text;
        color: root.tint;
        font-size: Theme.t-overline;
        font-weight: 600;
    }
}

/// Raccourci de manette ou de clavier affiché dans les barres d'aide.
export component KeyHint inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    spacing: 8px;
    alignment: start;
    Rectangle {
        width: max(26px, k.preferred-width + 12px);
        height: 24px;
        y: 0;
        border-radius: Theme.radius-sm;
        background: Theme.surface-active;
        border-width: 1px;
        border-color: Theme.border-strong;
        k := Text { text: root.key; color: Theme.text; font-size: Theme.t-caption; font-weight: 700; }
    }
    Text { text: root.label; color: Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; }
}

/// Bloc de chargement : pulsation lente de la teinte, figée si les animations sont coupées.
export component Skeleton inherits Rectangle {
    in property <length> corner: Theme.radius;
    border-radius: corner;
    background: Theme.surface;
    clip: true;
    if Theme.motion == 0 && Theme.animations: Rectangle {
        border-radius: root.corner;
        background: Theme.text.with-alpha(0.04 * (1 + sin(mod(animation-tick(), 1600ms) / 1600ms * 360deg)));
    }
}

/// Indicateur d'activité (rotation), immobile sans animations.
export component Spinner inherits Rectangle {
    in property <length> size: 18px;
    in property <color> tint: Theme.accent;
    width: size;
    height: size;
    Image {
        width: root.size;
        height: root.size;
        source: Icons.spinner;
        colorize: root.tint;
        transform-rotation: Theme.animations && Theme.motion < 2 ? (mod(animation-tick(), 900ms) / 900ms) * 360deg : 0deg;
    }
}

/// Barre de progression ; `value` < 0 : progression inconnue (segment qui parcourt la piste).
export component ProgressBar inherits Rectangle {
    in property <float> value: -1;
    in property <color> tint: Theme.accent;
    height: 4px;
    border-radius: 1px;
    background: Theme.surface-active;
    clip: true;
    if root.value >= 0: Rectangle {
        x: 0;
        width: root.width * min(1, max(0, root.value));
        background: root.tint;
        animate width { duration: Theme.normal; }
    }
    if root.value < 0: Rectangle {
        width: root.width * 0.3;
        x: Theme.animations && Theme.motion < 2 ? (mod(animation-tick(), 1300ms) / 1300ms) * (root.width * 1.3) - root.width * 0.3 : root.width * 0.35;
        background: root.tint;
    }
}

/// Jaquette d'un jeu. Sans image : planche typographique générée (couleur propre au jeu,
/// initiales en filigrane, titre composé en bas à gauche).
export component GameCover inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <color> color-a;
    in property <color> color-b;
    in property <string> initials;
    in property <string> title;
    in property <length> corner: Theme.radius-cover;
    in property <bool> show-title: true;

    border-radius: corner;
    clip: true;
    background: has-image ? Theme.surface : root.color-a.mix(#101215, 0.55);

    if !root.has-image: Rectangle {
        // Bande de la seconde couleur : repère de la planche.
        y: 0;
        height: max(3px, root.height * 0.025);
        background: root.color-b;
    }
    if !root.has-image: Text {
        x: root.width * 0.08;
        y: root.height * 0.07;
        text: root.initials;
        color: #ffffff2e;
        font-family: Theme.display;
        font-size: root.width * 0.34;
        font-weight: 800;
    }
    if !root.has-image && root.show-title: Text {
        x: root.width * 0.08;
        width: root.width * 0.84;
        y: root.height - self.height - root.width * 0.08;
        text: root.title;
        color: #ffffffee;
        font-family: Theme.display;
        font-size: max(10px, root.width * 0.082);
        font-weight: 700;
        wrap: word-wrap;
        overflow: elide;
    }
    if root.has-image: Image {
        width: root.width;
        height: root.height;
        source: root.source;
        image-fit: cover;
        image-rendering: smooth;
    }
    Rectangle {
        border-radius: root.corner;
        border-width: 1px;
        border-color: #ffffff12;
    }
}

/// Tuile d'un jeu (grille, étagères) : jaquette, puis légende (titre, source, temps de
/// jeu). `selected` : sélection au clavier ou à la manette (cadre d'accent).
export component GameTile inherits Rectangle {
    in property <GameCard> game;
    in property <length> cover-width: 168px;
    in property <bool> selected: false;
    in property <bool> show-text: true;
    /// Tuile atteignable par Tab / manette (étagères). La grille gère sa propre sélection.
    in property <bool> focusable: false;
    callback open(int);
    callback play(int);
    callback context(int, length, length);

    width: cover-width;
    height: show-text ? cover-width * 1.5 + 52px : cover-width * 1.5;
    accessible-role: button;
    accessible-label: game.title;

    property <bool> lifted: ta.has-hover || play-ta.has-hover || root.selected || fs.has-focus;
    property <bool> hovered: ta.has-hover;
    changed hovered => {
        if (self.hovered) {
            Sound.play("ui.hover");
        }
    }

    fs := FocusScope {
        enabled: root.focusable;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.open(root.game.id);
                return accept;
            }
            if (event.text == " " && root.game.installed) {
                root.play(root.game.id);
                return accept;
            }
            if (event.text == Key.Menu) {
                root.context(root.game.id, self.absolute-position.x + root.width / 2, self.absolute-position.y + root.cover-width * 0.6);
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(root.game.id); }
        double-clicked => { root.play(root.game.id); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context(root.game.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    cover := GameCover {
        x: 0;
        y: 0;
        width: root.cover-width;
        height: root.cover-width * 1.5;
        source: root.game.cover;
        has-image: root.game.has-cover;
        color-a: root.game.color-a;
        color-b: root.game.color-b;
        initials: root.game.initials;
        title: root.game.title;
        show-title: root.show-text || !root.game.has-cover;

        // Jeu non installé : voile, et mention en bas de la jaquette.
        if !root.game.installed: Rectangle {
            background: Theme.bg.with-alpha(0.5);
        }
        if !root.game.installed: Rectangle {
            x: 0;
            y: parent.height - self.height;
            height: 24px;
            background: #000000b8;
            Text {
                x: 8px;
                text: @tr("Non installé");
                color: Theme.text-muted;
                font-size: Theme.t-overline;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        if root.game.badge != "": Rectangle {
            x: 0;
            y: 10px;
            height: 20px;
            width: badge-text.preferred-width + 14px;
            background: Theme.accent;
            badge-text := Text {
                text: root.game.badge;
                color: Theme.on-accent;
                font-size: Theme.t-overline - 1px;
                font-weight: 700;
            }
        }
        if root.game.favorite: Rectangle {
            x: parent.width - 26px;
            y: 6px;
            width: 20px;
            height: 20px;
            border-radius: Theme.radius-sm;
            background: #000000a0;
            Icon {
                source: Icons.star-filled;
                size: 12px;
                tint: Theme.warm;
            }
        }
        // Survol : léger éclaircissement.
        Rectangle { background: root.lifted ? #ffffff0f : transparent; animate background { duration: Theme.fast; } }
        // « Jouer » au survol, dans le coin : un clic au centre ouvre la fiche, jamais un
        // lancement accidentel.
        play-btn := Rectangle {
            width: 34px;
            height: 34px;
            border-radius: Theme.radius;
            x: parent.width - self.width - 8px;
            y: parent.height - self.height - 8px;
            opacity: root.game.installed && root.lifted ? 1 : 0;
            background: play-ta.has-hover ? Theme.warm-hover : Theme.warm;
            animate opacity { duration: Theme.fast; }
            Icon {
                source: Icons.play;
                size: 14px;
                tint: Theme.on-warm;
                x: (parent.width - self.width) / 2 + 1px;
            }
            play-ta := TouchArea {
                enabled: parent.opacity > 0.5;
                mouse-cursor: pointer;
                clicked => { root.play(root.game.id); }
            }
        }
    }
    // Sélection clavier / manette : cadre d'accent à 3 px de la jaquette.
    ring := Rectangle {
        y: -4px;
        x: -4px;
        width: root.cover-width + 8px;
        height: root.cover-width * 1.5 + 8px;
        border-radius: Theme.radius-cover + 3px;
        border-width: root.selected || fs.has-focus ? 2px : 0px;
        border-color: Theme.focus;
    }

    if root.show-text: Text {
        x: 0;
        y: root.cover-width * 1.5 + 9px;
        width: root.width;
        text: root.game.title;
        color: Theme.text;
        font-size: Theme.t-small;
        font-weight: 600;
        overflow: elide;
    }
    if root.show-text: Text {
        x: 0;
        y: root.cover-width * 1.5 + 28px;
        width: root.width - (root.game.playtime != "" ? pt.preferred-width + 8px : 0px);
        text: root.game.source;
        color: Theme.text-dim;
        font-size: Theme.t-caption;
        overflow: elide;
    }
    pt := Text {
        visible: root.show-text && root.game.playtime != "";
        x: root.width - self.preferred-width;
        y: root.cover-width * 1.5 + 28px;
        text: root.game.playtime;
        color: Theme.text-muted;
        font-size: Theme.t-caption;
        font-weight: 500;
    }
}

/// Titre de section : police d'affichage, commun à toutes les pages.
export component SectionTitle inherits Text {
    vertical-alignment: center;
    color: Theme.text;
    font-family: Theme.display;
    font-size: Theme.t-subheading + 1px;
    font-weight: 700;
}

/// En-tête de section : titre, compteur facultatif (chiffre discret) et actions à droite.
export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    in property <string> note;
    spacing: 12px;
    height: 32px;
    SectionTitle { text: root.title; }
    if root.count != "": Text {
        text: root.count;
        color: Theme.text-dim;
        font-family: Theme.display;
        font-size: Theme.t-subheading + 1px;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.note != "": Text {
        text: root.note;
        color: Theme.text-dim;
        font-size: Theme.t-small;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

/// Rubrique : filet de tête, titre, actions facultatives, contenu. Remplace la carte : le
/// filet et le titre suffisent à séparer les sujets d'une page.
export component Rubric inherits VerticalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 14px;
    alignment: start;
    Rectangle { height: 1px; background: Theme.border-strong; }
    HorizontalLayout {
        spacing: 12px;
        SectionTitle { text: root.title; overflow: elide; }
        if root.note != "": Text { text: root.note; color: Theme.text-dim; font-size: Theme.t-small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    @children
}

/// Petit titre de groupe : casse normale, couleur atténuée.
export component Overline inherits Text {
    color: Theme.text-dim;
    font-size: Theme.t-caption;
    font-weight: 600;
}

/// Élément de liste : rangée ouverte sur la page, filet de pied, perche si `active`.
export component ListItem inherits Rectangle {
    in property <bool> active;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    if root.active: Rectangle { x: 0; y: 14px; width: Theme.perch; height: parent.height - 28px; background: Theme.accent; }
}

/// Zone groupée (réglages, informations) : simple changement de teinte, sans contour.
export component Panel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-lg;
}

/// Ligne « libellé : valeur » (fiches techniques).
export component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text {
        text: root.label;
        color: Theme.text-dim;
        font-size: Theme.t-small;
        min-width: 120px;
        horizontal-stretch: 0;
    }
    Text {
        text: root.value == "" ? "—" : root.value;
        color: Theme.text;
        font-size: Theme.t-small;
        font-weight: 500;
        horizontal-alignment: right;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

/// Rangée de réglage : libellé et explication à gauche, contrôle à droite.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    spacing: 24px;
    padding-top: 10px;
    padding-bottom: 10px;
    min-height: Theme.row-height;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 3px;
        Text { text: root.label; color: Theme.text; font-size: Theme.t-body; font-weight: 500; wrap: word-wrap; }
        if root.description != "": Text { text: root.description; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
    }
    @children
}

/// Liste déroulante compacte (clavier : Entrée ouvre, flèches changent la valeur).
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <string> prefix;
    in property <length> popup-width: 220px;
    /// Menu aligné à gauche (formulaires) ; par défaut aligné à droite (barres d'outils).
    in property <bool> align-left: false;
    callback changed(int);
    property <length> row-h: root.options.length > 10 ? 28px : 34px;

    height: 32px;
    min-width: dd-row.preferred-width;
    accessible-role: combobox;
    accessible-label: prefix;
    accessible-value: options[selected];
    forward-focus: fs;

    bg := Rectangle {
        border-radius: Theme.radius;
        background: ta.has-hover ? Theme.surface-hover : Theme.surface;
        border-width: fs.has-focus ? Theme.focus-width : 1px;
        border-color: fs.has-focus ? Theme.focus : Theme.border;
        animate background { duration: Theme.fast; }
    }
    dd-row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.prefix;
            color: Theme.text-dim;
            font-size: Theme.t-small;
            vertical-alignment: center;
        }
        Text {
            text: root.options[root.selected];
            color: Theme.text;
            font-size: Theme.t-small;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            source: Icons.chevron-down;
            size: 15px;
            tint: Theme.text-muted;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                popup.show();
                return accept;
            }
            if (event.text == Key.DownArrow && root.selected < root.options.length - 1) {
                root.selected += 1;
                root.changed(root.selected);
                return accept;
            }
            if (event.text == Key.UpArrow && root.selected > 0) {
                root.selected -= 1;
                root.changed(root.selected);
                return accept;
            }
            reject
        }
    }
    popup := PopupWindow {
        x: root.align-left ? 0px : min(0px, root.width - root.popup-width);
        y: root.height + 4px;
        width: root.popup-width;
        height: root.options.length * root.row-h + 10px;
        Rectangle {
            background: Theme.surface-hover;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 5px;
                for option[i] in root.options: Rectangle {
                    height: root.row-h;
                    border-radius: Theme.radius-sm;
                    background: item-ta.has-hover ? Theme.surface-active : transparent;
                    // Choix courant : perche d'accent à gauche.
                    if i == root.selected: Rectangle { x: 0; width: Theme.perch; y: 7px; height: parent.height - 14px; background: Theme.accent; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        Text {
                            text: option;
                            color: i == root.selected ? Theme.text : Theme.text-muted;
                            font-size: Theme.t-small;
                            font-weight: i == root.selected ? 600 : 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected = i;
                            root.changed(i);
                        }
                    }
                }
            }
        }
    }
}

/// Menu contextuel (clic droit, bouton « … », touche Menu de la manette).
export component ContextMenu inherits Rectangle {
    in property <[MenuEntry]> entries;
    in property <length> menu-width: 240px;
    callback selected(int);
    width: 0px;
    height: 0px;
    public function open(px: length, py: length) {
        menu.x = px;
        menu.y = py;
        menu.show();
    }
    menu := PopupWindow {
        width: root.menu-width;
        height: col.preferred-height;
        Rectangle {
            background: Theme.surface-hover;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 6px;
            col := VerticalLayout {
                padding: 5px;
                spacing: 1px;
                for e[i] in root.entries: VerticalLayout {
                    if e.separator-before: Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.border; } }
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: e.enabled && m-ta.has-hover ? (e.danger ? Theme.danger.with-alpha(0.14) : Theme.surface-active) : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Icon { source: e.icon; size: 16px; tint: !e.enabled ? Theme.text-dim : e.danger ? Theme.danger : Theme.text-muted; }
                            Text {
                                text: e.label;
                                color: !e.enabled ? Theme.text-dim : e.danger ? Theme.danger : Theme.text;
                                font-size: Theme.t-small;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        m-ta := TouchArea {
                            enabled: e.enabled;
                            mouse-cursor: pointer;
                            clicked => { root.selected(i); }
                        }
                    }
                }
            }
        }
    }
}

/// Grand chiffre et sa légende : le chiffre parle, la légende le nomme.
export component BigStat inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    spacing: 2px;
    Text { text: root.value; color: Theme.text; font-family: Theme.display; font-size: Theme.t-title - 6px; font-weight: 700; overflow: elide; }
    Text { text: root.label; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
}

/// Histogramme vertical simple.
export component BarChart inherits HorizontalLayout {
    in property <[BarItem]> items;
    in property <color> bar-color: Theme.accent;
    in property <bool> show-values: true;
    spacing: 6px;
    for m in root.items: VerticalLayout {
        spacing: 6px;
        if root.show-values: Text {
            text: m.ratio > 0 ? m.value : "";
            color: Theme.text-muted;
            font-size: Theme.t-overline - 1px;
            horizontal-alignment: center;
            overflow: elide;
        }
        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                y: parent.height - self.height;
                height: m.ratio > 0 ? max(3px, parent.height * m.ratio) : 1px;
                border-radius: 1px;
                background: m.ratio > 0 ? root.bar-color : Theme.border-strong;
                animate height { duration: Theme.slow; easing: ease-out; }
            }
        }
        Text { text: m.label; color: Theme.text-dim; font-size: Theme.t-overline - 1px; horizontal-alignment: center; overflow: elide; }
    }
}

/// Barre horizontale avec libellé et valeur.
export component MeterRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> ratio;
    in property <color> bar-color: Theme.accent;
    spacing: 6px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.text; font-size: Theme.t-small; font-weight: 500; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.value; color: Theme.text-muted; font-size: Theme.t-caption; }
    }
    ProgressBar { value: root.ratio; tint: root.bar-color; }
}

/// En-tête de page : titre, sous-titre et zone d'actions.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 14px;
    VerticalLayout {
        spacing: 6px;
        horizontal-stretch: 1;
        alignment: center;
        if !Layout.tabbed: Text { text: root.title; color: Theme.text; font-family: Theme.display; font-size: Theme.t-title; font-weight: 700; overflow: elide; }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.text-muted; font-size: Theme.t-small; wrap: word-wrap; }
    }
    @children
}

/// Note en marge (limites d'une intégration, explications) : trait vertical et texte,
/// sans encadré.
export component Notice inherits Rectangle {
    in property <string> text;
    in property <bool> warning: false;
    height: row.preferred-height;
    Rectangle { x: 0; width: 2px; background: root.warning ? Theme.warm : Theme.accent; }
    row := HorizontalLayout {
        padding-left: 14px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 10px;
        Icon { source: root.warning ? Icons.alert : Icons.info; size: 16px; tint: root.warning ? Theme.warm : Theme.accent; }
        Text { text: root.text; color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
    }
}

/// État vide : ce qui manque et comment le remplir, aligné à gauche dans le flux.
export component EmptyState inherits VerticalLayout {
    in property <image> icon: Icons.info;
    in property <string> title;
    in property <string> text;
    in property <string> action;
    callback action-clicked;
    spacing: 8px;
    alignment: center;
    padding: 32px;
    HorizontalLayout {
        alignment: center;
        Icon { source: root.icon; size: 28px; tint: Theme.text-dim; }
    }
    Text { text: root.title; color: Theme.text; font-family: Theme.display; font-size: Theme.t-subheading; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
    if root.text != "": Text { text: root.text; color: Theme.text-muted; font-size: Theme.t-small; wrap: word-wrap; horizontal-alignment: center; }
    if root.action != "": HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        PrimaryButton { text: root.action; clicked => { root.action-clicked(); } }
    }
}

/// Voile sombre d'une fenêtre modale (un clic à l'extérieur la ferme).
export component Modal inherits Rectangle {
    callback dismissed;
    background: #000000a8;
    TouchArea { clicked => { root.dismissed(); } }
}

/// Panneau centré d'une fenêtre modale.
export component ModalPanel inherits Rectangle {
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 40px;
    drop-shadow-color: #000000b0;
    clip: true;
    // Les clics dans le panneau ne ferment pas la fenêtre.
    TouchArea { }
}

/// Curseur de valeur (0 à 1) : souris, flèches gauche/droite (pas de 5 %), Début/Fin.
export component ValueSlider inherits Rectangle {
    in-out property <float> value;
    in property <bool> enabled: true;
    in property <string> label;
    /// Valeur relâchée (glisser terminé, clic ou touche).
    callback committed(float);
    height: 28px;
    min-width: 160px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: @tr("{} %", round(root.value * 100));
    forward-focus: fs;
    property <length> track-w: root.width - 14px;
    Rectangle {
        x: 7px;
        y: (root.height - 4px) / 2;
        width: root.track-w;
        height: 4px;
        border-radius: 1px;
        background: Theme.surface-active;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0, 1);
            background: root.enabled ? Theme.accent : Theme.text-dim;
        }
    }
    knob := Rectangle {
        x: root.track-w * clamp(root.value, 0, 1);
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 2px;
        background: root.enabled ? Theme.text : Theme.text-dim;
        border-width: fs.has-focus ? Theme.focus-width : 0px;
        border-color: Theme.focus;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        // Appui : la valeur suit le pointeur ; relâchement : une seule validation.
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.value = clamp((self.mouse-x - 7px) / root.track-w, 0, 1);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                root.committed(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = clamp((self.mouse-x - 7px) / root.track-w, 0, 1);
            }
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.value = min(1, round(root.value * 20 + 1) / 20);
                root.committed(root.value);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.value = max(0, round(root.value * 20 - 1) / 20);
                root.committed(root.value);
                return accept;
            }
            if (event.text == Key.Home) { root.value = 0; root.committed(0); return accept; }
            if (event.text == Key.End) { root.value = 1; root.committed(1); return accept; }
            reject
        }
    }
}
