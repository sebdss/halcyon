    in property <string> nexus-key;
    in property <string> steamgriddb-key;
    in property <bool> offline-forced;
    in property <string> backup-status;
    in property <string> backups-dir;
    callback export-config(bool, bool);
    callback import-config(string);
    callback set-text(string, string);
    callback clear-cache();
    callback open-logs();
    callback open-data();
}

export global AppUi {
    in property <NavVisibility> nav: {
        big-picture: true, assistant: true, achievements: true, stats: true, journal: true, updates: true, saves: true,
        emulators: true, controllers: true, remote: true, plugins: true
    };
    in property <bool> scanning;
    /// Connexion Internet détectée (et mode hors ligne non forcé).
    in property <bool> online: true;
    in property <string> scan-status;
    in-out property <bool> toast-visible;
    in property <string> toast;
    in property <bool> toast-error;
    in property <bool> can-browse;
    in-out property <bool> add-dialog-open;
    in property <string> update-version;
    in property <string> update-url;
    // Notification de succès dans l'interface.
    in-out property <bool> ach-toast-visible;
    in property <AchievementRow> ach-toast;
    // Confirmation des opérations destructives.
    in-out property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-button: @tr("Confirmer");
    callback confirm-accepted();
    /// Mode d'interface : 0 standard, 1 minimaliste, 2 cinéma.
    in property <int> ui-mode;
    /// Page à grande illustration défilée : la barre supérieure redevient opaque.
    in-out property <bool> top-solid;
    /// Mode Performance (manuel ou automatique pendant une partie).
    in property <bool> performance;
    in property <bool> performance-auto;
    in-out property <bool> sidebar-collapsed;
    /// Une partie lancée par Halcyon est en cours (nom du jeu).
    in property <string> playing;
    callback set-ui-mode(int);
    callback set-performance(bool);
    callback sidebar-changed(bool);
    callback browse-file() -> string;
    callback browse-folder() -> string;
    /// nom, exécutable, arguments, répertoire de travail → true si ajouté
    callback add-game(string, string, string, string) -> bool;
}

