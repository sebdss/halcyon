/// Intégration au système, raccourcis et fenêtres annexes.
export global SystemUi {
    in property <bool> autostart;
    in property <bool> close-to-tray;
    in property <bool> minimize-to-tray;
    in property <bool> tray-available;
    in property <string> tray-status;
    in property <bool> global-enabled;
    in property <string> global-hotkey;
    in property <string> global-status;
    in property <bool> companion;
    in property <[ShortcutRow]> shortcuts;
    in property <string> integrity-status;
    /// Niveau de vérification des mises à jour de cette compilation.
    in property <bool> integrity-running;
    /// Combinaison saisie, transmise à Rust qui l'interprète (texte, Ctrl, Alt, Maj, Méta).
    pure callback shortcut(string, bool, bool, bool, bool) -> bool;
    pure callback combo-of(string, bool, bool, bool, bool) -> string;
    callback set-option(string, bool);
    callback set-shortcut(string, string);
    callback reset-shortcuts();
    callback set-global-hotkey(string);
    callback check-integrity();
    callback create-shortcut(int);
    callback mini-mode();
    /// Incrémenté par Rust pour donner le focus à la recherche de la bibliothèque.
    in property <int> focus-search-tick;
}

/// Centre de commandes : tâches, téléchargements, synchronisations, notifications, erreurs.
export global CommandUi {
    in-out property <bool> open;
    /// Erreurs dans l'historique récent.
    in property <int> errors;
    in property <[TaskRow]> active;
    in property <[TaskRow]> history;
    in property <int> running;
    in property <int> unread;
    callback opened();
    callback task-action(int);
    callback clear-history();
}

/// Menu contextuel d'un jeu, partagé par toutes les vues (souris, clavier, manette).
/// Les entrées sont construites en Rust d'après l'état réel du jeu.
export global GameMenu {
    in-out property <bool> open;
    in property <int> game-id: -1;
    in property <string> title;
    in property <[MenuEntry]> entries;
    in property <[string]> codes;
    in-out property <int> selected;
    in-out property <length> x;
    in-out property <length> y;
    /// Demande d'ouverture : (jeu, position x, position y dans la fenêtre).
    callback request(int, length, length);
    callback chosen(string);
}
