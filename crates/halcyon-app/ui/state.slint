// Singletons partagés entre les pages et accessibles depuis Rust
// (`app.global::<LibraryUi>()`…). Les `callback` sont implémentés côté Rust,
// les `function` sont de la pure logique d'interface.

import {
    GameCard, GridRow, GameDetail, SourceInfo, LibraryStats, AchievementRow, ProviderStat, MonthBar, CollectionItem,
    EmulatorRow, PlatformRow, PlatformChoice, McProfileRow, McVersionRow, McModRow, McProjectRow, BpRow, SessionRow, VersionRow, CompanionRow, ProfileRow, ActivityRow, BarItem, TopGame,
    UpdateRow, SmartRow, RuleRow, SaveLocRow, SaveCandRow, SnapshotRow, SaveGameRow, ModRow, WorkshopRow, StoryPage, StorageDisk, StorageGame, ThemeRow, ToggleRow,
    PluginRow, PadRow, PadProfileRow, MappingRow, EmuArgRow, HostRow, SuggestRow, LinkRow, QuickRow, ShortcutRow,
    StripItem, TaskRow, WidgetSlot, WidgetRow, KeyValue, MenuEntry, CaptureItem, NewsRow
} from "types.slint";

/// Éléments de la barre latérale affichés (personnalisation).
export struct NavVisibility {
    big-picture: bool,
    assistant: bool,
    achievements: bool,
    stats: bool,
    journal: bool,
    updates: bool,
    saves: bool,
    emulators: bool,
    controllers: bool,
    remote: bool,
    plugins: bool,
}

export enum Page {
    home, library, game, achievements, emulators, settings, stats, journal, updates, saves, assistant, controllers,
    remote, plugins, appearance, minecraft, performance, downloads, recap, storage
}

export global Nav {
    in-out property <Page> page: Page.home;
    in-out property <Page> return-page: Page.home;
    /// Historique (géré en Rust) : précédent / suivant disponibles.
    in property <bool> can-back;
    in property <bool> can-forward;
    /// Nouvelle page visitée (ajoutée à l'historique).
    callback navigated(Page);
    /// -1 : précédent, +1 : suivant.
    callback history(int);

    public function go(p: Page) {
        if (p != Page.game) {
            self.return-page = p;
        }
        if (p != self.page) {
            self.page = p;
            self.navigated(p);
        }
    }

    public function back() {
        self.history(-1);
    }
}

export global Actions {
    callback open-game(int);
    callback play(int);
    callback toggle-favorite(int);
    callback toggle-hidden(int);
    callback open-folder(string);
    callback rescan();
    callback open-url(string);
    callback enter-big-picture();
    /// Une page devient visible (rafraîchissement des données affichées).
    callback page-shown(Page);
}

export global LibraryUi {
    in property <[GridRow]> rows;
    in property <[GameCard]> items;
    in property <int> result-count;
    in property <int> total;
    in-out property <string> search;
    /// Autres launchers présents dans la bibliothèque (index 7 et suivants de `source`).
    in property <[string]> extra-sources;
    /// 0 = toutes, 1 = Steam, 2 = Epic, 3 = émulation, 4 = autres, 5 = Minecraft, 6 = GOG,
    /// 7 et suivants : `extra-sources`.
    in-out property <int> source;
    in property <[string]> collection-labels: [@tr("Toutes les collections")];
    in-out property <int> collection;
    in property <[string]> genre-labels: [@tr("Tous les genres")];
    in-out property <int> genre;
    in-out property <bool> installed-only;
    in-out property <bool> favorites-only;
    in-out property <bool> show-hidden;
    in-out property <int> sort;
    in property <[string]> sort-labels: [@tr("Nom"), @tr("Dernier lancement"), @tr("Ajout récent"), @tr("Temps de jeu")];
    in-out property <bool> list-view;
    /// Vue : 0 grille, 1 liste, 2 carrousel, 3 immersive, 4 compacte.
    in-out property <int> view-mode;
    in-out property <length> card-width: 168px;
    /// Sélection clavier / manette : position dans la liste filtrée (-1 : aucune).
    in property <int> selected: -1;
    in property <int> selected-id: -1;
    /// Ligne de la grille à rendre visible (changement de sélection).
    in property <int> scroll-row: -1;
    in property <int> scroll-tick;
    /// Bande du carrousel / du mode immersif et fiche du jeu sélectionné.
    in property <[StripItem]> strip;
    in property <GameDetail> focus-game;
    in property <string> focus-meta;
    in property <image> focus-ambient;
    callback move-selection(int, int);
    callback select-index(int);
    callback activate-selection(bool);
    /// Filtres de recherche non reconnus (« statut:xyz »), affichés sous la barre.
    in property <string> search-warning;
    callback query-changed();
    callback columns-changed(int);
    /// Taille des jaquettes (largeur en pixels logiques).
    callback card-size(int);
    callback view-changed();
}

