export global SettingsUi {
    /// Sections affichées (recherche, filtre) : Plateformes, Dossiers, Comptes, Comportement,
    /// Hors ligne, Système, Raccourcis, Configuration, Mises à jour, Stockage, Son, Langue.
    in property <[bool]> shown: [true, true, true, true, true, true, true, true, true, true, true, true];
    in property <int> match-count: 12;
    /// Langues proposées : « Automatique (…) » puis chaque langue sous son nom natif.
    in property <[string]> languages;
    /// Index dans `languages` (0 : automatique).
    in property <int> language-index;
    /// Langue détectée sur le système (affichée sous « Automatique »).
    in property <string> language-detected;
    /// La langue du système n'est pas proposée : l'anglais est utilisé.
    in property <bool> language-fallback;
    /// Code de la langue du système (« ja-JP »…).
    in property <string> language-system;
    callback set-language(int);
    // Son : général, navigation, interactions, notifications, actions importantes.
    in property <bool> sound-enabled: true;
    in property <bool> sound-muted;
    in property <bool> sound-hover;
    in property <int> sound-in-game;
    in property <[float]> sound-volumes: [0.7, 0.8, 0.9, 0.9, 1.0];
    callback sound-toggle(string, bool);
    /// (index, valeur) : 0 à 4 volumes ; 5 comportement pendant une partie.
    callback sound-volume(int, float);
    callback sound-preview(int);
    callback sound-reset();
    /// Section choisie (-1 : toutes).
    in-out property <int> section: 0;
    in-out property <string> search;
    callback search-changed(string);
    in property <SourceInfo> steam;
    in property <SourceInfo> epic;
    in property <SourceInfo> gog;
    /// Autres launchers (Ubisoft, EA, Xbox, Battle.net, Riot, Amazon, itch.io), 1.1.
    in property <[SourceInfo]> launchers;
    in property <[string]> folders;
    in property <bool> online-artwork;
    in property <bool> scan-on-startup;
    in property <bool> minimize-on-launch;
    in property <bool> launch-screen;
    /// Rappel de pause : 0 désactivé, sinon toutes les N heures (1 à 3).
    in property <int> break-reminder;
    callback set-break-reminder(int);
    in property <bool> free-games;
    in property <bool> disk-alerts;
    in property <string> cache-size;
    in property <string> data-dir;
    in property <string> log-dir;
    in property <string> version;
    callback set-source-enabled(string, bool);
    callback set-source-path(string, string);
    callback add-folder(string);
    callback remove-folder(int);
    callback set-option(string, bool);
    in property <bool> is-linux;
    in property <string> windows-runner;
    in property <string> steam-key;
    in property <string> steam-id;
    in property <string> steam-id-detected;
    /// Client Steam et compte trouvés : succès lus sur le disque, sans clé.
    in property <bool> steam-local;
    in property <string> ra-user;
    in property <string> ra-key;
    in property <bool> online-metadata;
    in property <bool> notifications;
    in property <bool> polling;
    in property <bool> sync-on-startup;
    in property <bool> check-updates;
    in property <string> update-repo;
