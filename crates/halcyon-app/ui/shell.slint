// Coque de l'application : barre latérale (repliable), barre supérieure (historique,
// recherche universelle, modes, centre de commandes) et centre de commandes.

import { Theme, Icons } from "theme.slint";
import { TaskRow } from "types.slint";
import { Nav, Page, Actions, AppUi, LibraryUi, AchUi, EmuUi, UpdatesUi, PadsUi, QuickUi, CommandUi, SystemUi, McUi } from "state.slint";
import { Icon, IconButton, Overline, ProgressBar, Spinner, SecondaryButton, Badge } from "components.slint";

/// Entrée de navigation. Repliée : icône seule, libellé en infobulle.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <string> trailing;
    in property <bool> muted-trailing: true;
    in property <bool> collapsed;
    callback clicked;

    height: Theme.nav-height;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;

    bg := Rectangle {
        border-radius: Theme.radius;
        background: root.active ? Theme.surface-active : ta.has-hover || fs.has-focus ? Theme.surface : transparent;
        border-width: fs.has-focus ? Theme.focus-width : 0px;
        border-color: Theme.focus;
        animate background { duration: Theme.fast; }
    }
    pill := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.active ? 20px : 0px;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: Theme.normal; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: root.collapsed ? 16px : 14px;
        padding-right: 12px;
        spacing: 12px;
        Icon {
            source: root.icon;
            size: 20px;
            tint: root.active ? Theme.accent : ta.has-hover || fs.has-focus ? Theme.text : Theme.text-muted;
            y: (parent.height - self.height) / 2;
        }
        if !root.collapsed: Text {
            text: root.text;
            color: root.active || ta.has-hover || fs.has-focus ? Theme.text : Theme.text-muted;
            font-size: Theme.t-body;
            font-weight: root.active ? 650 : 550;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.collapsed && root.trailing != "": Text {
            text: root.trailing;
            color: root.muted-trailing ? Theme.text-dim : Theme.warm;
            font-size: root.muted-trailing ? Theme.t-caption : 10px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    // Repliée : pastille d'alerte et infobulle.
    if root.collapsed && root.trailing != "" && !root.muted-trailing: Rectangle {
        x: root.width - 18px;
        y: 6px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.warm;
    }
    if root.collapsed && (ta.has-hover || fs.has-focus): Rectangle {
        x: root.width + 10px;
        y: (root.height - self.height) / 2;
        width: tip.preferred-width + 20px;
        height: 30px;
        border-radius: Theme.radius-sm;
        background: Theme.surface-active;
        border-width: 1px;
        border-color: Theme.border-strong;
        tip := Text { text: root.text + (root.trailing != "" ? "  ·  " + root.trailing : ""); color: Theme.text; font-size: Theme.t-small; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component NavGroup inherits Rectangle {
    in property <string> text;
    in property <bool> collapsed;
    height: root.collapsed ? 14px : 30px;
    if root.collapsed: Rectangle { x: 18px; y: 7px; width: root.width - 36px; height: 1px; background: Theme.border; }
    if !root.collapsed: Overline { x: 14px; y: 12px; text: root.text; }
}

export component Sidebar inherits Rectangle {
    in property <bool> collapsed;
    background: Theme.sidebar;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: root.collapsed ? 10px : 14px;
        padding-top: 18px;
        spacing: 2px;

        HorizontalLayout {
            padding-left: root.collapsed ? 0px : 8px;
            padding-bottom: 16px;
            spacing: 10px;
            alignment: root.collapsed ? center : start;
            Image {
                source: Icons.logo;
                width: 32px;
                height: 32px;
            }
            if !root.collapsed: Text {
                text: "Halcyon";
                color: Theme.text;
                font-size: Theme.t-heading;
                font-weight: 800;
                letter-spacing: -0.3px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: nav.preferred-height;
            nav := VerticalLayout {
                width: parent.width;
                spacing: 2px;
                alignment: start;
                NavItem {
                    collapsed: root.collapsed;
                    text: "Accueil";
                    icon: Icons.home;
                    active: Nav.page == Page.home;
                    clicked => { Nav.go(Page.home); }
                }
                NavItem {
                    collapsed: root.collapsed;
                    text: "Bibliothèque";
                    icon: Icons.library;
                    active: Nav.page == Page.library || (Nav.page == Page.game && Nav.return-page == Page.library);
                    trailing: LibraryUi.total > 0 ? LibraryUi.total : "";
                    clicked => { Nav.go(Page.library); }
                }
                if AppUi.nav.assistant: NavItem {
                    collapsed: root.collapsed;
                    text: "Que jouer ?";
                    icon: Icons.sparkle;
                    active: Nav.page == Page.assistant;
                    clicked => { Nav.go(Page.assistant); }
                }
                if AppUi.nav.big-picture: NavItem {
                    collapsed: root.collapsed;
                    text: "Big Picture";
                    icon: Icons.tv;
                    trailing: "F11";
                    clicked => { Actions.enter-big-picture(); }
                }
                NavItem {
                    collapsed: root.collapsed;
                    text: "Minecraft";
                    icon: Icons.cube;
                    active: Nav.page == Page.minecraft;
                    trailing: McUi.playing ? "En jeu" : "";
                    clicked => { Nav.go(Page.minecraft); }
                }
                NavItem {
                    collapsed: root.collapsed;
                    text: "Performances";
                    icon: Icons.gauge;
                    active: Nav.page == Page.performance;
                    clicked => { Nav.go(Page.performance); }
                }
                if AppUi.nav.achievements || AppUi.nav.stats || AppUi.nav.journal: NavGroup { collapsed: root.collapsed; text: "SUIVI"; }
                if AppUi.nav.achievements: NavItem {
                    collapsed: root.collapsed;
                    text: "Succès";
                    icon: Icons.trophy;
                    active: Nav.page == Page.achievements;
                    trailing: AchUi.total > 0 ? round(AchUi.percent * 100) + " %" : "";
                    clicked => { Nav.go(Page.achievements); }
                }
                if AppUi.nav.stats: NavItem {
                    collapsed: root.collapsed;
                    text: "Statistiques";
                    icon: Icons.chart;
                    active: Nav.page == Page.stats;
                    clicked => { Nav.go(Page.stats); }
                }
                if AppUi.nav.journal: NavItem {
                    collapsed: root.collapsed;
                    text: "Journal";
                    icon: Icons.journal;
                    active: Nav.page == Page.journal;
                    clicked => { Nav.go(Page.journal); }
                }
                NavGroup { collapsed: root.collapsed; text: "OUTILS"; }
                if AppUi.nav.updates: NavItem {
                    collapsed: root.collapsed;
                    text: "Mises à jour";
                    icon: Icons.download;
                    active: Nav.page == Page.updates;
                    trailing: UpdatesUi.pending.length > 0 ? UpdatesUi.pending.length : "";
                    muted-trailing: UpdatesUi.pending.length == 0;
                    clicked => { Nav.go(Page.updates); }
                }
                if AppUi.nav.saves: NavItem {
                    collapsed: root.collapsed;
                    text: "Sauvegardes";
                    icon: Icons.save;
                    active: Nav.page == Page.saves;
                    clicked => { Nav.go(Page.saves); }
                }
                if AppUi.nav.emulators: NavItem {
                    collapsed: root.collapsed;
                    text: "Émulateurs";
                    icon: Icons.gamepad;
                    active: Nav.page == Page.emulators;
                    trailing: EmuUi.rom-count > 0 ? EmuUi.rom-count : "";
                    clicked => { Nav.go(Page.emulators); }
                }
                if AppUi.nav.controllers: NavItem {
                    collapsed: root.collapsed;
                    text: "Manettes";
                    icon: Icons.gamepad;
                    active: Nav.page == Page.controllers;
                    trailing: PadsUi.pads.length > 0 ? PadsUi.pads.length : "";
                    clicked => { Nav.go(Page.controllers); }
                }
                if AppUi.nav.remote: NavItem {
                    collapsed: root.collapsed;
                    text: "Jeu à distance";
                    icon: Icons.monitor;
                    active: Nav.page == Page.remote;
                    clicked => { Nav.go(Page.remote); }
                }
                if AppUi.nav.plugins: NavItem {
                    collapsed: root.collapsed;
                    text: "Extensions";
                    icon: Icons.puzzle;
                    active: Nav.page == Page.plugins;
                    clicked => { Nav.go(Page.plugins); }
                }
            }
        }

        if AppUi.update-version != "": NavItem {
            collapsed: root.collapsed;
            text: "Version " + AppUi.update-version;
            icon: Icons.download;
            trailing: "NOUVEAU";
            muted-trailing: false;
            clicked => { Nav.go(Page.settings); }
        }
        NavItem {
            collapsed: root.collapsed;
            text: AppUi.scanning ? "Analyse en cours…" : "Analyser les sources";
            icon: Icons.refresh;
            clicked => { if (!AppUi.scanning) { Actions.rescan(); } }
        }
        NavItem {
            collapsed: root.collapsed;
            text: "Apparence";
            icon: Icons.palette;
            active: Nav.page == Page.appearance;
            clicked => { Nav.go(Page.appearance); }
        }
        NavItem {
            collapsed: root.collapsed;
            text: "Paramètres";
            icon: Icons.settings;
            active: Nav.page == Page.settings;
            clicked => { Nav.go(Page.settings); }
        }
    }
}

/// Pastille de recherche universelle : ouvre la palette de commandes.
component SearchPill inherits Rectangle {
    in property <bool> compact;
    height: 38px;
    accessible-role: button;
    accessible-label: "Rechercher";
    accessible-action-default => { QuickUi.open = true; }
    forward-focus: fs;
    bg := Rectangle {
        border-radius: 19px;
        background: ta.has-hover || fs.has-focus ? Theme.surface-hover : Theme.surface.with-alpha(0.85);
        border-width: fs.has-focus ? Theme.focus-width : 1px;
        border-color: fs.has-focus ? Theme.focus : Theme.border;
        animate background { duration: Theme.fast; }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        Icon { y: 10px; source: Icons.search; size: 18px; tint: Theme.text-muted; }
        if !root.compact: Text {
            text: "Rechercher un jeu, une page, un réglage…";
            color: Theme.text-dim;
            font-size: Theme.t-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.compact: Rectangle {
            width: kbd.preferred-width + 14px;
            height: 22px;
            y: 8px;
            border-radius: 6px;
            background: Theme.surface-active;
            kbd := Text { text: "Ctrl K"; color: Theme.text-muted; font-size: Theme.t-overline; font-weight: 700; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { QuickUi.open = true; } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                QuickUi.open = true;
                return accept;
            }
            reject
        }
    }
}

/// Barre supérieure : précédent / suivant, recherche universelle, modes, centre de commandes.
export component TopBar inherits Rectangle {
    in property <bool> transparent-bg;
    in property <bool> narrow;
    height: 60px;
    // Fond verre sur les pages ordinaires ; dégradé discret sur les pages à grande illustration.
    background: root.transparent-bg ? @linear-gradient(180deg, Theme.bg.with-alpha(0.55) 0%, transparent 100%) : Theme.bg.with-alpha(0.92);
    if !root.transparent-bg: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        IconButton {
            y: 12px;
            icon: Icons.chevron-left;
            enabled: Nav.can-back;
            tint: Nav.can-back ? Theme.text-muted : Theme.text-dim.with-alpha(0.5);
            tooltip: "Précédent (Alt+←)";
            clicked => { Nav.history(-1); }
        }
        IconButton {
            y: 12px;
            icon: Icons.chevron-right;
            enabled: Nav.can-forward;
            tint: Nav.can-forward ? Theme.text-muted : Theme.text-dim.with-alpha(0.5);
            tooltip: "Suivant (Alt+→)";
            clicked => { Nav.history(1); }
        }
        Rectangle { width: 8px; }
        SearchPill {
            y: 11px;
            compact: root.narrow;
            width: root.narrow ? 38px : min(520px, max(240px, root.width * 0.38));
        }
        Rectangle { horizontal-stretch: 1; }
        if AppUi.playing != "": Rectangle {
            y: 13px;
            height: 34px;
            width: pl.preferred-width + 24px;
            border-radius: 17px;
            background: Theme.success.with-alpha(0.12);
            border-width: 1px;
            border-color: Theme.success.with-alpha(0.35);
            pl := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Rectangle { y: 13px; width: 8px; height: 8px; border-radius: 4px; background: Theme.success; }
                Text { text: root.narrow ? "En jeu" : "En jeu : " + AppUi.playing; color: Theme.text; font-size: Theme.t-caption; font-weight: 600; vertical-alignment: center; overflow: elide; }
            }
        }
        if AppUi.performance: Badge {
            y: 19px;
            text: AppUi.performance-auto ? "PERFORMANCE · AUTO" : "PERFORMANCE";
            tint: Theme.warm;
            solid: true;
        }
        if !AppUi.online: Badge { y: 19px; text: "HORS LIGNE"; tint: Theme.warm; }
        IconButton {
            y: 12px;
            icon: Icons.gauge;
            active: AppUi.performance;
            active-tint: Theme.warm;
            tooltip: AppUi.performance ? "Quitter le mode Performance" : "Mode Performance";
            clicked => { AppUi.set-performance(!AppUi.performance); }
        }
        IconButton {
            y: 12px;
            icon: AppUi.ui-mode == 1 ? Icons.minimal : AppUi.ui-mode == 2 ? Icons.film : Icons.sidebar;
            active: AppUi.ui-mode != 0;
            tooltip: AppUi.ui-mode == 0 ? "Mode standard (clic : minimaliste)" : AppUi.ui-mode == 1 ? "Mode minimaliste (clic : cinéma)" : "Mode cinéma (clic : standard)";
            clicked => { AppUi.set-ui-mode(mod(AppUi.ui-mode + 1, 3)); }
        }
        IconButton {
            y: 12px;
            icon: Icons.bell;
            active: CommandUi.open;
            badge: CommandUi.running > 0 ? CommandUi.running : CommandUi.unread > 0 ? "•" : "";
            tooltip: "Centre de commandes";
            clicked => {
                CommandUi.open = !CommandUi.open;
                if (CommandUi.open) { CommandUi.opened(); }
            }
        }
    }
}

component TaskItem inherits Rectangle {
    in property <TaskRow> task;
    height: col.preferred-height;
    col := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            if root.task.state == 0: Spinner { y: 1px; size: 16px; }
            if root.task.state == 1: Icon { source: Icons.check; size: 16px; tint: Theme.success; }
            if root.task.state == 2: Icon { source: Icons.alert; size: 16px; tint: Theme.danger; }
            if root.task.state == 3: Icon { source: Icons.info; size: 16px; tint: Theme.text-muted; }
            Text {
                text: root.task.title;
                color: Theme.text;
                font-size: Theme.t-small;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text { text: root.task.time; color: Theme.text-dim; font-size: Theme.t-overline; }
        }
        if root.task.detail != "": Text {
            text: root.task.detail;
            color: root.task.state == 2 ? Theme.danger.brighter(0.2) : Theme.text-muted;
            font-size: Theme.t-caption;
            wrap: word-wrap;
        }
        if root.task.state == 0 && root.task.progress >= 0: ProgressBar { value: root.task.progress; }
        if root.task.state == 0 && root.task.progress < 0: ProgressBar { value: -1; }
        if root.task.action != "": HorizontalLayout {
            alignment: start;
            SecondaryButton { h: 30px; text: root.task.action; clicked => { CommandUi.task-action(root.task.id); } }
        }
    }
    Rectangle { y: parent.height - 1px; x: 12px; width: parent.width - 24px; height: 1px; background: Theme.border; }
}

/// Centre de commandes (panneau latéral droit).
export component CommandCenter inherits Rectangle {
    width: 400px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 40px;
    drop-shadow-color: #000000a0;
    TouchArea { }
    VerticalLayout {
        HorizontalLayout {
            padding: 18px;
            padding-bottom: 10px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: "Centre de commandes"; color: Theme.text; font-size: Theme.t-heading; font-weight: 750; }
                Text {
                    text: (CommandUi.running > 0 ? CommandUi.running + " tâche(s) en cours" : "Aucune tâche en cours") + (CommandUi.errors > 0 ? "  ·  " + CommandUi.errors + " erreur(s) récente(s)" : "");
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                }
            }
            IconButton { icon: Icons.close; tooltip: "Fermer (Échap)"; clicked => { CommandUi.open = false; } }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 18px;
                alignment: start;
                if CommandUi.active.length > 0: HorizontalLayout { padding-left: 12px; height: 28px; Overline { vertical-alignment: center; text: "EN COURS"; } }
                for t in CommandUi.active: TaskItem { task: t; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    height: 40px;
                    Overline { text: "RÉCENT"; vertical-alignment: center; horizontal-stretch: 1; }
                    if CommandUi.history.length > 0: SecondaryButton { y: 6px; h: 28px; text: "Effacer"; clicked => { CommandUi.clear-history(); } }
                }
                if CommandUi.history.length == 0: HorizontalLayout { padding-left: 12px; padding-right: 12px; Text {
                    text: "Les analyses, téléchargements, synchronisations, sauvegardes, notifications et erreurs apparaîtront ici.";
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                    wrap: word-wrap;
                } }
                for t in CommandUi.history: TaskItem { task: t; }
            }
        }
    }
}
