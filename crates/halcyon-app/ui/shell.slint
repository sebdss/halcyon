// Coque de l'application : rail de six espaces, barre d'espace à onglets, barre supérieure (historique,
// recherche universelle, modes, centre de commandes) et centre de commandes.

import { Theme, Icons } from "theme.slint";
import { TaskRow } from "types.slint";
import { Nav, Page, Actions, AppUi, LibraryUi, AchUi, EmuUi, UpdatesUi, PadsUi, QuickUi, CommandUi, SystemUi, McUi } from "state.slint";
import { Icon, IconButton, Overline, ProgressBar, Spinner, SecondaryButton, Badge } from "components.slint";
import { DownloadsUi } from "downloads_state.slint";

/// Entrée de navigation. Repliée : icône seule, libellé en infobulle.
/// Entrée du rail : icône, libellé court dessous, ligne d'horizon pour l'espace actif.
component RailItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> labels: true;
    /// Pastille (compteur, état) affichée sur l'icône.
    in property <string> badge;
    in property <bool> warm-badge;
    callback clicked;

    height: root.labels ? 64px : 52px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;

    pill := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.labels ? 4px : (parent.height - self.height) / 2;
        width: 52px;
        height: 36px;
        border-radius: 18px;
        background: root.active ? Theme.accent.with-alpha(0.16) : ta.has-hover || fs.has-focus ? Theme.surface-hover : transparent;
        border-width: fs.has-focus ? Theme.focus-width : 0px;
        border-color: Theme.focus;
        animate background { duration: Theme.fast; }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: 22px;
            tint: root.active ? Theme.accent : ta.has-hover || fs.has-focus ? Theme.text : Theme.text-muted;
        }
    }
    // Signature : la ligne d'horizon marque l'espace actif, au bord du rail.
    Rectangle {
        x: 0;
        y: pill.y + 6px;
        width: 3px;
        height: root.active ? pill.height - 12px : 0px;
        border-radius: 2px;
        background: Theme.horizon-v;
        animate height { duration: Theme.normal; easing: ease-out; }
    }
    if root.badge != "": Rectangle {
        x: pill.x + pill.width - self.width + 4px;
        y: pill.y - 3px;
        width: max(18px, bt.preferred-width + 10px);
        height: 18px;
        border-radius: 9px;
        background: root.warm-badge ? Theme.warm : Theme.accent;
        bt := Text { text: root.badge; color: Theme.on-accent; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.labels: Text {
        y: pill.y + pill.height + 4px;
        width: parent.width;
        text: root.text;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 11px;
        font-weight: root.active ? 650 : 500;
        horizontal-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

/// Espaces de navigation du bureau (1.0) : 0 Accueil, 1 Bibliothèque, 2 Minecraft,
/// 3 Activité, 4 Outils, 5 Système.
export global Spaces {
    /// Espace de la page affichée.
    out property <int> current: Spaces.of(Nav.page);
    // Dernière page visitée dans chaque espace à onglets (retour au même onglet).
    in-out property <Page> last-activity: Page.achievements;
    in-out property <Page> last-tools: Page.downloads;
    in-out property <Page> last-system: Page.performance;

    public pure function of(p: Page) -> int {
        if (p == Page.home) { return 0; }
        if (p == Page.library || p == Page.game) { return 1; }
        if (p == Page.minecraft) { return 2; }
        if (p == Page.assistant || p == Page.achievements || p == Page.stats || p == Page.journal) { return 3; }
        if (p == Page.performance || p == Page.appearance || p == Page.settings) { return 5; }
        return 4;
    }

    public function open(space: int) {
        if (space == 0) { Nav.go(Page.home); }
        if (space == 1) { Nav.go(Page.library); }
        if (space == 2) { Nav.go(Page.minecraft); }
        if (space == 3) { Nav.go(Spaces.last-activity); }
        if (space == 4) { Nav.go(Spaces.last-tools); }
        if (space == 5) { Nav.go(Spaces.last-system); }
    }
}

/// Rail de navigation : six espaces, puis le mode console et l'analyse des sources.
export component Sidebar inherits Rectangle {
    /// Vrai : icônes seules (réglage « Libellés du menu » désactivé).
    in property <bool> collapsed;
    property <bool> labels: !root.collapsed;
    background: Theme.sidebar;
    // Mémorise l'onglet ouvert dans chaque espace à onglets.
    property <Page> page: Nav.page;
    changed page => {
        if (Spaces.of(self.page) == 3) { Spaces.last-activity = self.page; }
        if (Spaces.of(self.page) == 4) { Spaces.last-tools = self.page; }
        if (Spaces.of(self.page) == 5) { Spaces.last-system = self.page; }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding-top: 16px;
        padding-bottom: 14px;
        spacing: 6px;

        HorizontalLayout {
            alignment: center;
            padding-bottom: 14px;
            Image { source: Icons.logo; width: 34px; height: 34px; }
        }
        RailItem { labels: root.labels; text: "Accueil"; icon: Icons.home; active: Spaces.current == 0; clicked => { Spaces.open(0); } }
        RailItem { labels: root.labels; text: "Bibliothèque"; icon: Icons.library; active: Spaces.current == 1; clicked => { Spaces.open(1); } }
        RailItem { labels: root.labels; text: "Minecraft"; icon: Icons.cube; active: Spaces.current == 2; badge: McUi.playing ? "●" : ""; warm-badge: true; clicked => { Spaces.open(2); } }
        RailItem { labels: root.labels; text: "Activité"; icon: Icons.chart; active: Spaces.current == 3; clicked => { Spaces.open(3); } }
        RailItem {
            labels: root.labels;
            text: "Outils";
            icon: Icons.layers;
            active: Spaces.current == 4;
            badge: DownloadsUi.active.length > 0 ? DownloadsUi.active.length : UpdatesUi.pending.length > 0 ? UpdatesUi.pending.length : "";
            warm-badge: DownloadsUi.active.length == 0;
            clicked => { Spaces.open(4); }
        }
        RailItem { labels: root.labels; text: "Système"; icon: Icons.sliders; active: Spaces.current == 5; badge: AppUi.update-version != "" ? "1" : ""; warm-badge: true; clicked => { Spaces.open(5); } }
        Rectangle { vertical-stretch: 1; }
        if AppUi.nav.big-picture: RailItem { labels: root.labels; text: "Console"; icon: Icons.tv; clicked => { Actions.enter-big-picture(); } }
        RailItem { labels: root.labels; text: AppUi.scanning ? "Analyse…" : "Analyser"; icon: Icons.refresh; clicked => { if (!AppUi.scanning) { Actions.rescan(); } } }
    }
}

/// Onglet d'un espace.
component SpaceTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <string> count;
    callback clicked;
    // Positions calculées (pas de mise en page automatique) : la pastille du compteur
    // reste dans le bouton quelle que soit la mise à l'échelle de l'écran ou la police.
    property <length> count-w: root.count == "" ? 0px : max(20px, cm.preferred-width + 12px);
    height: 36px;
    width: 14px + tt.preferred-width + (root.count == "" ? 0px : 7px + root.count-w) + 14px;
    border-radius: 18px;
    background: root.active ? Theme.surface-active : ta.has-hover || fs.has-focus ? Theme.surface : transparent;
    border-width: fs.has-focus ? Theme.focus-width : 0px;
    border-color: Theme.focus;
    accessible-role: tab;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;
    cm := Text { visible: false; text: root.count; font-size: 11px; font-weight: 650; }
    tt := Text {
        x: 14px;
        y: 0px;
        width: self.preferred-width;
        height: root.height;
        text: root.text;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.t-small;
        font-weight: root.active ? 650 : 500;
        vertical-alignment: center;
    }
    if root.count != "": Rectangle {
        x: tt.x + tt.width + 7px;
        y: (root.height - self.height) / 2;
        width: root.count-w;
        height: 20px;
        border-radius: 10px;
        background: root.active ? Theme.accent.with-alpha(0.22) : Theme.surface-active;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.count;
            color: root.active ? Theme.accent : Theme.text-muted;
            font-size: 11px;
            font-weight: 650;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
}

/// Barre d'un espace à onglets (Activité, Outils, Système) : titre et onglets communs, sous
/// la barre supérieure. Les pages n'y répètent pas leur titre (`Layout.tabbed`).
export component SpaceBar inherits Rectangle {
    height: 76px;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: Theme.page-padding;
        padding-right: Theme.page-padding;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 28px;
        Text {
            text: Spaces.current == 3 ? "Activité" : Spaces.current == 4 ? "Outils" : "Système";
            color: Theme.text;
            font-family: Theme.display;
            font-size: 26px;
            font-weight: 700;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            horizontal-stretch: 1;
            if Spaces.current == 3 && AppUi.nav.assistant: SpaceTab { y: 6px; text: "Que jouer ?"; active: Nav.page == Page.assistant; clicked => { Nav.go(Page.assistant); } }
            if Spaces.current == 3 && AppUi.nav.achievements: SpaceTab { y: 6px; text: "Succès"; active: Nav.page == Page.achievements; count: AchUi.unlocked > 0 ? AchUi.unlocked : ""; clicked => { Nav.go(Page.achievements); } }
            if Spaces.current == 3 && AppUi.nav.stats: SpaceTab { y: 6px; text: "Statistiques"; active: Nav.page == Page.stats; clicked => { Nav.go(Page.stats); } }
            if Spaces.current == 3 && AppUi.nav.journal: SpaceTab { y: 6px; text: "Journal"; active: Nav.page == Page.journal; clicked => { Nav.go(Page.journal); } }
            if Spaces.current == 4: SpaceTab { y: 6px; text: "Téléchargements"; active: Nav.page == Page.downloads; count: DownloadsUi.active.length > 0 ? DownloadsUi.active.length : ""; clicked => { Nav.go(Page.downloads); } }
            if Spaces.current == 4 && AppUi.nav.updates: SpaceTab { y: 6px; text: "Mises à jour"; active: Nav.page == Page.updates; count: UpdatesUi.pending.length > 0 ? UpdatesUi.pending.length : ""; clicked => { Nav.go(Page.updates); } }
            if Spaces.current == 4 && AppUi.nav.saves: SpaceTab { y: 6px; text: "Sauvegardes"; active: Nav.page == Page.saves; clicked => { Nav.go(Page.saves); } }
            if Spaces.current == 4 && AppUi.nav.emulators: SpaceTab { y: 6px; text: "Émulateurs"; active: Nav.page == Page.emulators; count: EmuUi.rom-count > 0 ? EmuUi.rom-count : ""; clicked => { Nav.go(Page.emulators); } }
            if Spaces.current == 4 && AppUi.nav.controllers: SpaceTab { y: 6px; text: "Manettes"; active: Nav.page == Page.controllers; count: PadsUi.pads.length > 0 ? PadsUi.pads.length : ""; clicked => { Nav.go(Page.controllers); } }
            if Spaces.current == 4 && AppUi.nav.remote: SpaceTab { y: 6px; text: "Jeu à distance"; active: Nav.page == Page.remote; clicked => { Nav.go(Page.remote); } }
            if Spaces.current == 4 && AppUi.nav.plugins: SpaceTab { y: 6px; text: "Extensions"; active: Nav.page == Page.plugins; clicked => { Nav.go(Page.plugins); } }
            if Spaces.current == 5: SpaceTab { y: 6px; text: "Performances"; active: Nav.page == Page.performance; clicked => { Nav.go(Page.performance); } }
            if Spaces.current == 5: SpaceTab { y: 6px; text: "Apparence"; active: Nav.page == Page.appearance; clicked => { Nav.go(Page.appearance); } }
            if Spaces.current == 5: SpaceTab { y: 6px; text: "Paramètres"; active: Nav.page == Page.settings; count: AppUi.update-version != "" ? "Nouvelle version" : ""; clicked => { Nav.go(Page.settings); } }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

/// Pastille de recherche universelle : ouvre la palette de commandes.
component SearchPill inherits Rectangle {
    in property <bool> compact;
    height: 38px;
    accessible-role: button;
    accessible-label: "Rechercher";
    accessible-action-default => { QuickUi.open = true; }
    forward-focus: fs;
    bg := Rectangle {
        border-radius: 19px;
        background: ta.has-hover || fs.has-focus ? Theme.surface-hover : Theme.surface.with-alpha(0.85);
        border-width: fs.has-focus ? Theme.focus-width : 1px;
        border-color: fs.has-focus ? Theme.focus : Theme.border;
        animate background { duration: Theme.fast; }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        Icon { source: Icons.search; size: 18px; tint: Theme.text-muted; }
        if !root.compact: Text {
            text: "Rechercher un jeu, une page, un réglage…";
            color: Theme.text-dim;
            font-size: Theme.t-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.compact: Rectangle {
            width: kbd.preferred-width + 14px;
            height: 22px;
            y: 8px;
            border-radius: 6px;
            background: Theme.surface-active;
            kbd := Text { text: "Ctrl K"; color: Theme.text-muted; font-size: Theme.t-overline; font-weight: 700; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { QuickUi.open = true; } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                QuickUi.open = true;
                return accept;
            }
            reject
        }
    }
}

/// Barre supérieure : précédent / suivant, recherche universelle, modes, centre de commandes.
export component TopBar inherits Rectangle {
    in property <bool> transparent-bg;
    in property <bool> narrow;
    height: 60px;
    // Fond verre sur les pages ordinaires ; dégradé discret sur les pages à grande illustration.
    background: root.transparent-bg ? @linear-gradient(180deg, Theme.bg.with-alpha(0.55) 0%, transparent 100%) : Theme.bg.with-alpha(0.92);
    if !root.transparent-bg: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        IconButton {
            y: 12px;
            icon: Icons.chevron-left;
            enabled: Nav.can-back;
            tint: Nav.can-back ? Theme.text-muted : Theme.text-dim.with-alpha(0.5);
            tooltip: "Précédent (Alt+←)";
            clicked => { Nav.history(-1); }
        }
        IconButton {
            y: 12px;
            icon: Icons.chevron-right;
            enabled: Nav.can-forward;
            tint: Nav.can-forward ? Theme.text-muted : Theme.text-dim.with-alpha(0.5);
            tooltip: "Suivant (Alt+→)";
            clicked => { Nav.history(1); }
        }
        Rectangle { width: 8px; }
        SearchPill {
            y: 11px;
            compact: root.narrow;
            width: root.narrow ? 38px : min(520px, max(240px, root.width * 0.38));
        }
        Rectangle { horizontal-stretch: 1; }
        if AppUi.playing != "": Rectangle {
            y: 13px;
            height: 34px;
            width: pl.preferred-width + 24px;
            border-radius: 17px;
            background: Theme.success.with-alpha(0.12);
            border-width: 1px;
            border-color: Theme.success.with-alpha(0.35);
            pl := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Rectangle { y: 13px; width: 8px; height: 8px; border-radius: 4px; background: Theme.success; }
                Text { text: root.narrow ? "En jeu" : "En jeu : " + AppUi.playing; color: Theme.text; font-size: Theme.t-caption; font-weight: 600; vertical-alignment: center; overflow: elide; }
            }
        }
        if AppUi.performance: Badge {
            y: 19px;
            text: AppUi.performance-auto ? "Performance · auto" : "Performance";
            tint: Theme.warm;
            solid: true;
        }
        if !AppUi.online: Badge { y: 19px; text: "Hors ligne"; tint: Theme.warm; }
        IconButton {
            y: 12px;
            icon: Icons.gauge;
            active: AppUi.performance;
            active-tint: Theme.warm;
            tooltip: AppUi.performance ? "Quitter le mode Performance" : "Mode Performance";
            clicked => { AppUi.set-performance(!AppUi.performance); }
        }
        IconButton {
            y: 12px;
            icon: AppUi.ui-mode == 1 ? Icons.minimal : AppUi.ui-mode == 2 ? Icons.film : Icons.sidebar;
            active: AppUi.ui-mode != 0;
            tooltip: AppUi.ui-mode == 0 ? "Mode standard (clic : minimaliste)" : AppUi.ui-mode == 1 ? "Mode minimaliste (clic : cinéma)" : "Mode cinéma (clic : standard)";
            clicked => { AppUi.set-ui-mode(mod(AppUi.ui-mode + 1, 3)); }
        }
        IconButton {
            y: 12px;
            icon: Icons.bell;
            active: CommandUi.open;
            badge: CommandUi.running > 0 ? CommandUi.running : CommandUi.unread > 0 ? "•" : "";
            tooltip: "Centre de commandes";
            clicked => {
                CommandUi.open = !CommandUi.open;
                if (CommandUi.open) { CommandUi.opened(); }
            }
        }
    }
}

component TaskItem inherits Rectangle {
    in property <TaskRow> task;
    height: col.preferred-height;
    col := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            if root.task.state == 0: Spinner { y: 1px; size: 16px; }
            if root.task.state == 1: Icon { source: Icons.check; size: 16px; tint: Theme.success; }
            if root.task.state == 2: Icon { source: Icons.alert; size: 16px; tint: Theme.danger; }
            if root.task.state == 3: Icon { source: Icons.info; size: 16px; tint: Theme.text-muted; }
            Text {
                text: root.task.title;
                color: Theme.text;
                font-size: Theme.t-small;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text { text: root.task.time; color: Theme.text-dim; font-size: Theme.t-overline; }
        }
        if root.task.detail != "": Text {
            text: root.task.detail;
            color: root.task.state == 2 ? Theme.danger.brighter(0.2) : Theme.text-muted;
            font-size: Theme.t-caption;
            wrap: word-wrap;
        }
        if root.task.state == 0 && root.task.progress >= 0: ProgressBar { value: root.task.progress; }
        if root.task.state == 0 && root.task.progress < 0: ProgressBar { value: -1; }
        if root.task.action != "": HorizontalLayout {
            alignment: start;
            SecondaryButton { h: 30px; text: root.task.action; clicked => { CommandUi.task-action(root.task.id); } }
        }
    }
    Rectangle { y: parent.height - 1px; x: 12px; width: parent.width - 24px; height: 1px; background: Theme.border; }
}

/// Centre de commandes (panneau latéral droit).
export component CommandCenter inherits Rectangle {
    width: 400px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 40px;
    drop-shadow-color: #000000a0;
    TouchArea { }
    VerticalLayout {
        HorizontalLayout {
            padding: 18px;
            padding-bottom: 10px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text { text: "Centre de commandes"; color: Theme.text; font-size: Theme.t-heading; font-weight: 750; }
                Text {
                    text: (CommandUi.running > 0 ? CommandUi.running + " tâche(s) en cours" : "Aucune tâche en cours") + (CommandUi.errors > 0 ? "  ·  " + CommandUi.errors + " erreur(s) récente(s)" : "");
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                }
            }
            IconButton { icon: Icons.close; tooltip: "Fermer (Échap)"; clicked => { CommandUi.open = false; } }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                padding-left: 6px;
                padding-right: 6px;
                padding-bottom: 18px;
                alignment: start;
                if CommandUi.active.length > 0: HorizontalLayout { padding-left: 12px; height: 28px; Overline { vertical-alignment: center; text: "En cours"; } }
                for t in CommandUi.active: TaskItem { task: t; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    height: 40px;
                    Overline { text: "Récent"; vertical-alignment: center; horizontal-stretch: 1; }
                    if CommandUi.history.length > 0: SecondaryButton { y: 6px; h: 28px; text: "Effacer"; clicked => { CommandUi.clear-history(); } }
                }
                if CommandUi.history.length == 0: HorizontalLayout { padding-left: 12px; padding-right: 12px; Text {
                    text: "Les analyses, téléchargements, synchronisations, sauvegardes, notifications et erreurs apparaîtront ici.";
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                    wrap: word-wrap;
                } }
                for t in CommandUi.history: TaskItem { task: t; }
            }
        }
    }
}
