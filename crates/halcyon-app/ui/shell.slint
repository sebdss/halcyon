// Coque de l'application : colonne de navigation (six espaces), barre d'espace à onglets,
// barre supérieure (historique, recherche universelle, état, modes, centre de commandes)
// et centre de commandes.

import { Theme, Icons, Art } from "theme.slint";
import { TaskRow } from "types.slint";
import { Nav, Page, Actions, AppUi, LibraryUi, AchUi, EmuUi, UpdatesUi, QuickUi, CommandUi, SystemUi, McUi } from "state.slint";
import { Icon, IconButton, Overline, ProgressBar, Spinner, SecondaryButton, TextButton } from "components.slint";
import { DownloadsUi } from "downloads_state.slint";

/// Entrée de la colonne de navigation. Étendue : icône et libellé ; repliée : icône seule,
/// libellé en infobulle. L'espace actif prend la teinte de la page (il « entre » dans la
/// page) et porte la perche d'accent.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> collapsed;
    /// Secondaire (Console, Analyser) : plus discret.
    in property <bool> quiet;
    /// Compteur (téléchargements, mises à jour) ou repère d'état.
    in property <string> badge;
    in property <bool> warm-badge;
    callback clicked;

    height: root.quiet ? 36px : 40px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;

    bg := Rectangle {
        x: 8px;
        width: parent.width - 8px;
        border-radius: Theme.radius;
        background: root.active ? Theme.bg : ta.has-hover ? Theme.surface : transparent;
        animate background { duration: Theme.fast; }
    }
    // L'entrée active rejoint la page sans arrondi à droite.
    if root.active: Rectangle { x: parent.width - 8px; width: 8px; background: Theme.bg; }
    if fs.has-focus: Rectangle {
        x: 6px;
        width: parent.width - 10px;
        y: -2px;
        height: parent.height + 4px;
        border-radius: Theme.radius + 1px;
        border-width: Theme.focus-width;
        border-color: Theme.focus;
    }
    // La perche.
    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: Theme.perch;
        height: root.active ? 18px : 0px;
        background: Theme.accent;
        animate height { duration: Theme.normal; easing: ease-out; }
    }
    ico := Icon {
        x: root.collapsed ? (parent.width + 8px - self.width) / 2 : 24px;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        size: root.quiet ? 16px : 18px;
        tint: root.active ? Theme.accent : ta.has-hover || fs.has-focus ? Theme.text : Theme.text-muted;
    }
    if !root.collapsed: Text {
        x: 54px;
        width: parent.width - 54px - 44px;
        height: parent.height;
        text: root.text;
        color: root.active || ta.has-hover || fs.has-focus ? Theme.text : root.quiet ? Theme.text-dim : Theme.text-muted;
        font-size: root.quiet ? Theme.t-small : Theme.t-body;
        font-weight: root.active ? 650 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    // Compteur : chiffre dans la police d'affichage, sans pastille.
    if root.badge != "" && !root.collapsed: Text {
        x: parent.width - self.width - 16px;
        width: self.preferred-width;
        height: parent.height;
        text: root.badge;
        color: root.warm-badge ? Theme.warm : Theme.accent;
        font-family: Theme.display;
        font-size: Theme.t-caption;
        font-weight: 700;
        vertical-alignment: center;
    }
    if root.badge != "" && root.collapsed: Rectangle {
        x: ico.x + ico.width - 2px;
        y: ico.y - 4px;
        width: 7px;
        height: 7px;
        background: root.warm-badge ? Theme.warm : Theme.accent;
    }
    if root.collapsed && (ta.has-hover || fs.has-focus): Rectangle {
        x: parent.width + 6px;
        y: (parent.height - self.height) / 2;
        width: tip.preferred-width + 16px;
        height: 26px;
        border-radius: Theme.radius-sm;
        background: Theme.text;
        tip := Text { text: root.text; color: Theme.bg; font-size: Theme.t-caption; font-weight: 500; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

/// Espaces de navigation du bureau (1.0) : 0 Accueil, 1 Bibliothèque, 2 Minecraft,
/// 3 Activité, 4 Outils, 5 Système.
export global Spaces {
    /// Espace de la page affichée.
    out property <int> current: Spaces.of(Nav.page);
    // Dernière page visitée dans chaque espace à onglets (retour au même onglet).
    in-out property <Page> last-activity: Page.achievements;
    in-out property <Page> last-tools: Page.downloads;
    in-out property <Page> last-system: Page.performance;

    public pure function of(p: Page) -> int {
        if (p == Page.home) { return 0; }
        if (p == Page.library || p == Page.game || p == Page.collections) { return 1; }
        if (p == Page.minecraft) { return 2; }
        if (p == Page.assistant || p == Page.achievements || p == Page.stats || p == Page.recap || p == Page.journal) { return 3; }
        if (p == Page.performance || p == Page.appearance || p == Page.settings) { return 5; }
        return 4;
    }

    public function open(space: int) {
        if (space == 0) { Nav.go(Page.home); }
        if (space == 1) { Nav.go(Page.library); }
        if (space == 2) { Nav.go(Page.minecraft); }
        if (space == 3) { Nav.go(Spaces.last-activity); }
        if (space == 4) { Nav.go(Spaces.last-tools); }
        if (space == 5) { Nav.go(Spaces.last-system); }
    }
}

/// Colonne de navigation : les six espaces, puis le mode console et l'analyse des sources.
export component Sidebar inherits Rectangle {
    /// Vrai : icônes seules (réglage « Libellés du menu » désactivé, fenêtre étroite).
    in property <bool> collapsed;
    background: Theme.sidebar;
    // Mémorise l'onglet ouvert dans chaque espace à onglets.
    property <Page> page: Nav.page;
    changed page => {
        if (Spaces.of(self.page) == 3) { Spaces.last-activity = self.page; }
        if (Spaces.of(self.page) == 4) { Spaces.last-tools = self.page; }
        if (Spaces.of(self.page) == 5) { Spaces.last-system = self.page; }
    }

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 2px;

        // Marque : logo et nom composé dans la police d'affichage.
        Rectangle {
            height: 60px;
            Image {
                x: root.collapsed ? (parent.width - self.width) / 2 + 4px : 22px;
                y: 8px;
                source: Icons.logo;
                width: 28px;
                height: 28px;
            }
            if !root.collapsed: Text {
                x: 60px;
                y: 8px;
                height: 28px;
                text: "Halcyon";
                color: Theme.text;
                font-family: Theme.display;
                font-size: 15px;
                font-weight: 800;
                vertical-alignment: center;
            }
        }
        NavItem { collapsed: root.collapsed; text: @tr("Accueil"); icon: Icons.home; active: Spaces.current == 0; clicked => { Spaces.open(0); } }
        NavItem { collapsed: root.collapsed; text: @tr("Bibliothèque"); icon: Icons.library; active: Spaces.current == 1; clicked => { Spaces.open(1); } }
        NavItem { collapsed: root.collapsed; text: "Minecraft"; icon: Icons.cube; active: Spaces.current == 2; badge: McUi.playing ? @tr("en jeu") : ""; warm-badge: true; clicked => { Spaces.open(2); } }
        NavItem { collapsed: root.collapsed; text: @tr("Activité"); icon: Icons.chart; active: Spaces.current == 3; clicked => { Spaces.open(3); } }
        NavItem {
            collapsed: root.collapsed;
            text: @tr("Outils");
            icon: Icons.layers;
            active: Spaces.current == 4;
            badge: DownloadsUi.active.length > 0 ? DownloadsUi.active.length : UpdatesUi.pending.length > 0 ? UpdatesUi.pending.length : "";
            warm-badge: DownloadsUi.active.length > 0;
            clicked => { Spaces.open(4); }
        }
        NavItem { collapsed: root.collapsed; text: @tr("Système"); icon: Icons.sliders; active: Spaces.current == 5; badge: AppUi.update-version != "" ? "1" : ""; warm-badge: false; clicked => { Spaces.open(5); } }
        Rectangle { vertical-stretch: 1; }
        if AppUi.nav.big-picture: NavItem { quiet: true; collapsed: root.collapsed; text: @tr("Console"); icon: Icons.tv; clicked => { Actions.enter-big-picture(); } }
        NavItem { quiet: true; collapsed: root.collapsed; text: AppUi.scanning ? @tr("Analyse…") : @tr("Analyser"); icon: Icons.refresh; clicked => { if (!AppUi.scanning) { Actions.rescan(); } } }
    }
}

/// Onglet d'un espace : libellé, compteur discret, perche sous l'onglet actif.
component SpaceTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <string> count;
    /// Compteur signalant une action à faire (orange).
    in property <bool> warm;
    callback clicked;
    // Positions calculées : le compteur reste collé au libellé à toute échelle.
    height: 56px;
    width: tt.preferred-width + (root.count == "" ? 0px : 6px + cn.preferred-width);
    accessible-role: tab;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;
    tt := Text {
        x: 0px;
        width: self.preferred-width;
        height: root.height;
        text: root.text;
        color: root.active || ta.has-hover || fs.has-focus ? Theme.text : Theme.text-muted;
        font-size: Theme.t-body;
        font-weight: root.active ? 650 : 500;
        vertical-alignment: center;
    }
    cn := Text {
        visible: root.count != "";
        x: tt.width + 6px;
        width: self.preferred-width;
        height: root.height;
        text: root.count;
        color: root.warm ? Theme.warm : Theme.text-dim;
        font-family: Theme.display;
        font-size: Theme.t-caption;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 0;
        y: root.height - 2px;
        height: 2px;
        width: root.active ? root.width : 0px;
        background: Theme.accent;
        animate width { duration: Theme.normal; easing: ease-out; }
    }
    if fs.has-focus: Rectangle { x: -6px; width: root.width + 12px; y: 12px; height: root.height - 24px; border-radius: Theme.radius-sm; border-width: Theme.focus-width; border-color: Theme.focus; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
}

/// Barre d'un espace à onglets (Activité, Outils, Système) : titre et onglets communs, sous
/// la barre supérieure. Les pages n'y répètent pas leur titre (`Layout.tabbed`).
export component SpaceBar inherits Rectangle {
    height: 56px;
    background: Theme.bg;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: Theme.page-padding;
        padding-right: Theme.page-padding;
        spacing: 36px;
        Text {
            text: Spaces.current == 3 ? @tr("Activité") : Spaces.current == 4 ? @tr("Outils") : @tr("Système");
            color: Theme.text;
            font-family: Theme.display;
            font-size: 20px;
            font-weight: 800;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 26px;
            alignment: start;
            horizontal-stretch: 1;
            if Spaces.current == 3 && AppUi.nav.assistant: SpaceTab { text: @tr("Que jouer ?"); active: Nav.page == Page.assistant; clicked => { Nav.go(Page.assistant); } }
            if Spaces.current == 3 && AppUi.nav.achievements: SpaceTab { text: @tr("Succès"); active: Nav.page == Page.achievements; count: AchUi.unlocked > 0 ? AchUi.unlocked : ""; clicked => { Nav.go(Page.achievements); } }
            if Spaces.current == 3 && AppUi.nav.stats: SpaceTab { text: @tr("Statistiques"); active: Nav.page == Page.stats; clicked => { Nav.go(Page.stats); } }
            if Spaces.current == 3 && AppUi.nav.stats: SpaceTab { text: @tr("Récap"); active: Nav.page == Page.recap; clicked => { Nav.go(Page.recap); } }
            if Spaces.current == 3 && AppUi.nav.journal: SpaceTab { text: @tr("Journal"); active: Nav.page == Page.journal; clicked => { Nav.go(Page.journal); } }
            if Spaces.current == 4: SpaceTab { text: @tr("Téléchargements"); active: Nav.page == Page.downloads; count: DownloadsUi.active.length > 0 ? DownloadsUi.active.length : ""; warm: true; clicked => { Nav.go(Page.downloads); } }
            if Spaces.current == 4 && AppUi.nav.updates: SpaceTab { text: @tr("Mises à jour"); active: Nav.page == Page.updates; count: UpdatesUi.pending.length > 0 ? UpdatesUi.pending.length : ""; warm: true; clicked => { Nav.go(Page.updates); } }
            if Spaces.current == 4: SpaceTab { text: @tr("Stockage"); active: Nav.page == Page.storage; clicked => { Nav.go(Page.storage); } }
            if Spaces.current == 4 && AppUi.nav.saves: SpaceTab { text: @tr("Sauvegardes"); active: Nav.page == Page.saves; clicked => { Nav.go(Page.saves); } }
            if Spaces.current == 4 && AppUi.nav.emulators: SpaceTab { text: @tr("Émulateurs"); active: Nav.page == Page.emulators; count: EmuUi.rom-count > 0 ? EmuUi.rom-count : ""; clicked => { Nav.go(Page.emulators); } }
            if Spaces.current == 5: SpaceTab { text: @tr("Performances"); active: Nav.page == Page.performance; clicked => { Nav.go(Page.performance); } }
            if Spaces.current == 5: SpaceTab { text: @tr("Apparence"); active: Nav.page == Page.appearance; clicked => { Nav.go(Page.appearance); } }
            if Spaces.current == 5: SpaceTab { text: @tr("Paramètres"); active: Nav.page == Page.settings; count: AppUi.update-version != "" ? @tr("nouvelle version") : ""; clicked => { Nav.go(Page.settings); } }
        }
    }
}

/// Champ de recherche universelle : ouvre la palette de commandes.
component SearchPill inherits Rectangle {
    in property <bool> compact;
    in property <bool> on-image;
    height: 34px;
    accessible-role: button;
    accessible-label: @tr("Rechercher");
    accessible-action-default => { QuickUi.open = true; }
    forward-focus: fs;
    bg := Rectangle {
        border-radius: Theme.radius;
        background: root.on-image ? #000000a0 : ta.has-hover ? Theme.surface-hover : Theme.surface;
        border-width: fs.has-focus ? Theme.focus-width : 1px;
        border-color: fs.has-focus ? Theme.focus : root.on-image ? #ffffff1f : Theme.border;
        animate background { duration: Theme.fast; }
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 6px;
        spacing: 10px;
        Icon { source: Icons.search; size: 16px; tint: Theme.text-muted; }
        if !root.compact: Text {
            text: @tr("Rechercher un jeu, une page, un réglage");
            color: Theme.text-dim;
            font-size: Theme.t-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.compact: Rectangle {
            width: kbd.preferred-width + 12px;
            height: 22px;
            y: 6px;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            kbd := Text { text: @tr("Ctrl K"); color: Theme.text-muted; font-size: Theme.t-overline; font-weight: 600; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { QuickUi.open = true; } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                QuickUi.open = true;
                return accept;
            }
            reject
        }
    }
}

/// État affiché dans la barre supérieure : repère carré et libellé.
component StatusMark inherits HorizontalLayout {
    in property <string> text;
    in property <color> tint;
    spacing: 8px;
    Rectangle { y: (parent.height - 7px) / 2; width: 7px; height: 7px; background: root.tint; }
    Text { text: root.text; color: Theme.text; font-size: Theme.t-caption; font-weight: 600; vertical-alignment: center; overflow: elide; }
}

/// Barre supérieure : précédent / suivant, recherche universelle, état, modes, centre de commandes.
export component TopBar inherits Rectangle {
    in property <bool> transparent-bg;
    in property <bool> narrow;
    height: 56px;
    // Fond de page ; sur les pages à grande illustration, voile progressif (masque teinté).
    background: root.transparent-bg ? transparent : Theme.bg;
    if root.transparent-bg: Image {
        width: parent.width;
        height: parent.height + 24px;
        source: Art.fade-top;
        image-fit: fill;
        colorize: #000000a0;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 4px;
        IconButton {
            y: 11px;
            icon: Icons.chevron-left;
            glass: root.transparent-bg;
            enabled: Nav.can-back;
            tooltip: @tr("Précédent (Alt+←)");
            clicked => { Nav.history(-1); }
        }
        IconButton {
            y: 11px;
            icon: Icons.chevron-right;
            glass: root.transparent-bg;
            enabled: Nav.can-forward;
            tooltip: @tr("Suivant (Alt+→)");
            clicked => { Nav.history(1); }
        }
        Rectangle { width: 12px; }
        SearchPill {
            y: 11px;
            compact: root.narrow;
            on-image: root.transparent-bg;
            width: root.narrow ? 34px : min(460px, max(240px, root.width * 0.36));
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 20px;
            padding-right: 16px;
            if AppUi.playing != "": StatusMark { text: root.narrow ? @tr("En jeu") : @tr("En jeu : {}", AppUi.playing); tint: Theme.warm; }
            if AppUi.performance: StatusMark { text: AppUi.performance-auto ? @tr("Performance (auto)") : @tr("Performance"); tint: Theme.accent; }
            if !AppUi.online: StatusMark { text: @tr("Hors ligne"); tint: Theme.text-dim; }
        }
        IconButton {
            y: 11px;
            icon: Icons.gauge;
            glass: root.transparent-bg;
            active: AppUi.performance;
            tooltip: AppUi.performance ? @tr("Quitter le mode Performance") : @tr("Mode Performance");
            clicked => { AppUi.set-performance(!AppUi.performance); }
        }
        IconButton {
            y: 11px;
            icon: AppUi.ui-mode == 1 ? Icons.minimal : AppUi.ui-mode == 2 ? Icons.film : Icons.sidebar;
            glass: root.transparent-bg;
            active: AppUi.ui-mode != 0;
            tooltip: AppUi.ui-mode == 0 ? @tr("Mode standard (clic : minimaliste)") : AppUi.ui-mode == 1 ? @tr("Mode minimaliste (clic : cinéma)") : @tr("Mode cinéma (clic : standard)");
            clicked => { AppUi.set-ui-mode(mod(AppUi.ui-mode + 1, 3)); }
        }
        IconButton {
            y: 11px;
            icon: Icons.bell;
            glass: root.transparent-bg;
            active: CommandUi.open;
            badge: CommandUi.running > 0 ? CommandUi.running : CommandUi.unread > 0 ? "•" : "";
            tooltip: @tr("Centre de commandes");
            clicked => {
                CommandUi.open = !CommandUi.open;
                if (CommandUi.open) { CommandUi.opened(); }
            }
        }
    }
    if !root.transparent-bg: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

component TaskItem inherits Rectangle {
    in property <TaskRow> task;
    height: col.preferred-height;
    // État : repère vertical à gauche (accent en cours, rouge en erreur).
    Rectangle {
        x: 0;
        y: 14px;
        width: 2px;
        height: parent.height - 28px;
        background: root.task.state == 0 ? Theme.accent : root.task.state == 2 ? Theme.danger : transparent;
    }
    col := VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            if root.task.state == 0: Spinner { size: 15px; }
            if root.task.state == 1: Icon { source: Icons.check; size: 15px; tint: Theme.success; }
            if root.task.state == 2: Icon { source: Icons.alert; size: 15px; tint: Theme.danger; }
            if root.task.state == 3: Icon { source: Icons.info; size: 15px; tint: Theme.text-dim; }
            Text {
                text: root.task.title;
                color: Theme.text;
                font-size: Theme.t-small;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            Text { text: root.task.time; color: Theme.text-dim; font-size: Theme.t-overline; vertical-alignment: center; }
        }
        if root.task.detail != "": Text {
            text: root.task.detail;
            color: root.task.state == 2 ? Theme.danger.brighter(0.2) : Theme.text-muted;
            font-size: Theme.t-caption;
            wrap: word-wrap;
        }
        if root.task.state == 0 && root.task.progress >= 0: ProgressBar { value: root.task.progress; }
        if root.task.state == 0 && root.task.progress < 0: ProgressBar { value: -1; }
        if root.task.action != "": HorizontalLayout {
            alignment: start;
            SecondaryButton { h: 28px; text: root.task.action; clicked => { CommandUi.task-action(root.task.id); } }
        }
    }
}

/// Centre de commandes : tiroir à droite, sous la barre supérieure.
export component CommandCenter inherits Rectangle {
    width: 380px;
    background: Theme.surface;
    drop-shadow-blur: Theme.effects ? 24px : 0px;
    drop-shadow-color: #00000080;
    Rectangle { x: 0; width: 1px; background: Theme.border-strong; }
    TouchArea { }
    VerticalLayout {
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 12px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: @tr("Centre de commandes"); color: Theme.text; font-family: Theme.display; font-size: Theme.t-subheading; font-weight: 700; }
                Text {
                    text: (CommandUi.running > 0 ? @tr("{n} tâche en cours" | "{n} tâches en cours" % CommandUi.running) : @tr("Aucune tâche en cours")) + (CommandUi.errors > 0 ? ", " + @tr("{n} erreur récente" | "{n} erreurs récentes" % CommandUi.errors) : "");
                    color: CommandUi.errors > 0 ? Theme.danger.brighter(0.2) : Theme.text-dim;
                    font-size: Theme.t-caption;
                }
            }
            IconButton { icon: Icons.close; tooltip: @tr("Fermer (Échap)"); clicked => { CommandUi.open = false; } }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                padding-bottom: 18px;
                alignment: start;
                if CommandUi.active.length > 0: HorizontalLayout { padding-left: 18px; height: 30px; Overline { vertical-alignment: center; text: @tr("En cours"); } }
                for t in CommandUi.active: TaskItem { task: t; }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    height: 38px;
                    Overline { text: @tr("Récent"); vertical-alignment: center; horizontal-stretch: 1; }
                    if CommandUi.history.length > 0: TextButton { y: 5px; text: @tr("Effacer"); clicked => { CommandUi.clear-history(); } }
                }
                if CommandUi.history.length == 0: HorizontalLayout { padding-left: 18px; padding-right: 18px; Text {
                    text: @tr("Les analyses, téléchargements, synchronisations, sauvegardes, notifications et erreurs apparaîtront ici.");
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                    wrap: word-wrap;
                } }
                for t in CommandUi.history: TaskItem { task: t; }
            }
        }
    }
}
