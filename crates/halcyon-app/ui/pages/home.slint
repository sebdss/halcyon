// Accueil : « Reprendre » en tête, puis les widgets choisis par l'utilisateur.
//
// La disposition (rangées de 3 colonnes, largeur de chaque widget) est calculée en Rust
// d'après la configuration enregistrée ; seuls les widgets affichés reçoivent des données.
// Codes des widgets : voir `halcyon_storage::settings::widget`.
//
// Composition « Berge » : pas de cartes. Les étagères de jaquettes reposent sur la page ;
// les widgets de données sont des colonnes ouvertes par un filet et un titre, comme les
// rubriques d'un carnet. En mode édition seulement, chaque widget montre son cadre.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { GameCard, WidgetSlot, KeyValue } from "../types.slint";
import { Nav, Page, Actions, HomeUi, AppUi, LibraryUi, GameMenu, QuickUi } from "../state.slint";
import {
    GameTile, PrimaryButton, PlayButton, SecondaryButton, TextButton, SectionTitle, Icon, IconButton, BarChart, MeterRow, BigStat,
    Chip, Overline
} from "../components.slint";

/// Rangée de jaquettes : n'affiche que celles qui tiennent sur la largeur.
component Shelf inherits Rectangle {
    in property <[GameCard]> games;
    in property <length> tile: 150px;
    property <length> gap: 20px;
    height: root.tile * 1.5 + 52px;
    for g[i] in root.games: GameTile {
        x: i * (root.tile + root.gap);
        y: 0px;
        visible: (i + 1) * (root.tile + root.gap) - root.gap <= root.width;
        game: g;
        cover-width: root.tile;
        focusable: self.visible;
        open(id) => { Actions.open-game(id); }
        play(id) => { Actions.play(id); }
        context(id, x, y) => { GameMenu.request(id, x, y); }
    }
}

/// Fait d'une fiche : légende au-dessus, valeur composée dans la police d'affichage.
component Fact inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 4px;
    Text { text: root.label; color: Theme.text-dim; font-size: Theme.t-caption; }
    Text { text: root.value == "" ? "—" : root.value; color: Theme.text; font-family: Theme.display; font-size: Theme.t-subheading; font-weight: 700; overflow: elide; }
}

/// Planche du jeu à reprendre : bannière, sinon jaquette recadrée, sinon planche générée.
component HeroArt inherits Rectangle {
    clip: true;
    border-radius: Theme.radius-cover;
    background: HomeUi.hero.color-a.mix(#101215, 0.55);
    if HomeUi.hero.has-banner: Image { width: parent.width; height: parent.height; source: HomeUi.hero.banner; image-fit: cover; }
    if !HomeUi.hero.has-banner && HomeUi.hero.has-cover: Image { width: parent.width; height: parent.height; source: HomeUi.hero.cover; image-fit: cover; }
    if !HomeUi.hero.has-banner && !HomeUi.hero.has-cover: Rectangle {
        y: 0;
        height: 4px;
        background: HomeUi.hero.color-b;
    }
    if !HomeUi.hero.has-banner && !HomeUi.hero.has-cover: Text {
        x: 28px;
        y: 18px;
        text: HomeUi.hero.initials;
        color: #ffffff24;
        font-family: Theme.display;
        font-size: parent.height * 0.5;
        font-weight: 800;
    }
    // Logo officiel du jeu, posé en bas à gauche de la planche.
    if HomeUi.hero.has-logo: Image {
        x: 24px;
        y: parent.height - self.height - 22px;
        width: min(parent.width * 0.42, 320px);
        height: parent.height * 0.32;
        source: HomeUi.hero.logo;
        image-fit: contain;
        horizontal-alignment: left;
        vertical-alignment: bottom;
    }
    Rectangle { border-radius: Theme.radius-cover; border-width: 1px; border-color: #ffffff12; }
}

/// « Reprendre » : le dernier jeu installé lancé. En tête de page : texte à gauche, planche
/// à droite ; en widget (`card`) ou dans une fenêtre étroite : planche au-dessus, texte dessous.
component Hero inherits Rectangle {
    in property <bool> card: false;
    property <bool> stacked: root.card || root.width < 860px;
    height: root.stacked ? root.width * 0.42 + text-col.preferred-height + 20px : 360px;

    art := HeroArt {
        x: root.stacked ? 0px : root.width * 0.42;
        y: 0px;
        width: root.stacked ? root.width : root.width * 0.58;
        height: root.stacked ? root.width * 0.42 : root.height;
    }
    text-col := VerticalLayout {
        x: 0px;
        y: root.stacked ? art.height + 20px : 0px;
        width: root.stacked ? root.width : root.width * 0.42 - 40px;
        height: root.stacked ? self.preferred-height : root.height;
        spacing: 14px;
        alignment: root.stacked ? LayoutAlignment.start : LayoutAlignment.end;

        Text { text: HomeUi.hero-kicker; color: Theme.accent; font-size: Theme.t-small; font-weight: 600; }
        Text {
            text: HomeUi.hero.title;
            color: Theme.text;
            font-family: Theme.display;
            font-size: root.card ? Theme.t-heading + 4px : Theme.t-title + 6px;
            font-weight: 800;
            wrap: word-wrap;
        }
        HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 10px;
            spacing: 28px;
            alignment: start;
            Fact { label: @tr("Temps de jeu"); value: HomeUi.hero.playtime; }
            Fact { label: @tr("Dernière partie"); value: HomeUi.hero.last-played; }
            if !root.card: Fact { label: @tr("Source"); value: HomeUi.hero.source; }
        }
        HorizontalLayout {
            spacing: Theme.s3;
            alignment: start;
            PlayButton {
                big: !root.card;
                text: HomeUi.hero.installed ? @tr("Jouer") : @tr("Non installé");
                enabled: HomeUi.hero.installed;
                clicked => { Actions.play(HomeUi.hero.id); }
            }
            SecondaryButton {
                text: @tr("Voir la fiche");
                h: root.card ? Theme.control-height : 48px;
                clicked => { Actions.open-game(HomeUi.hero.id); }
            }
        }
    }
}

/// Première ouverture : aucune donnée, on propose de détecter les jeux.
component Welcome inherits Rectangle {
    VerticalLayout {
        x: Theme.page-padding;
        width: min(660px, root.width - 2 * Theme.page-padding);
        alignment: center;
        spacing: 16px;
        Image { source: Icons.logo; width: 56px; height: 56px; horizontal-alignment: left; }
        Text {
            text: @tr("Bienvenue dans Halcyon");
            color: Theme.text;
            font-family: Theme.display;
            font-size: Theme.t-title;
            font-weight: 800;
        }
        Text {
            text: @tr("Toute votre ludothèque au même endroit. Halcyon détecte les jeux installés via Steam et Epic Games, et les jeux rangés dans vos propres dossiers.");
            color: Theme.text-muted;
            font-size: Theme.t-body;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            padding-top: 10px;
            PrimaryButton {
                text: AppUi.scanning ? @tr("Analyse en cours…") : @tr("Rechercher mes jeux");
                icon: Icons.refresh;
                has-icon: true;
                enabled: !AppUi.scanning;
                h: 40px;
                clicked => { Actions.rescan(); }
            }
            SecondaryButton {
                text: @tr("Ajouter un dossier de jeux");
                icon: Icons.folder;
                has-icon: true;
                h: 40px;
                clicked => { Nav.go(Page.settings); }
            }
            SecondaryButton {
                text: @tr("Ajouter un jeu");
                icon: Icons.plus;
                has-icon: true;
                h: 40px;
                clicked => { AppUi.add-dialog-open = true; }
            }
        }
    }
}

/// Ligne « libellé … valeur » compacte.
component KvLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Theme.s2;
    height: 28px;
    Text { text: root.label; color: Theme.text-muted; font-size: Theme.t-small; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
    Text { text: root.value; color: Theme.text; font-size: Theme.t-small; font-weight: 600; vertical-alignment: center; }
}

/// Note d'absence de données, sans valeur inventée.
component NoData inherits Text {
    color: Theme.text-dim;
    font-size: Theme.t-small;
    wrap: word-wrap;
}

/// Cadre d'un widget : filet de tête, titre, action, barre d'édition (déplacer, taille,
/// masquer). Les étagères de jeux (`bare`) n'ont pas de filet : les jaquettes suffisent.
component WidgetFrame inherits Rectangle {
    in property <WidgetSlot> slot;
    in property <bool> first;
    in property <bool> last;
    in property <string> action;
    in property <bool> bare;
    callback action-clicked;
    border-radius: Theme.radius;
    border-width: HomeUi.editing ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.5);
    background: HomeUi.editing ? Theme.accent.with-alpha(0.04) : transparent;
    if !root.bare && !HomeUi.editing: Rectangle { y: 0; height: 1px; background: Theme.border-strong; }

    VerticalLayout {
        padding-left: HomeUi.editing ? Theme.s4 : 0px;
        padding-right: HomeUi.editing ? Theme.s4 : 0px;
        padding-bottom: HomeUi.editing ? Theme.s4 : 0px;
        padding-top: HomeUi.editing ? Theme.s4 : root.bare ? 0px : 14px;
        spacing: Theme.s4;
        alignment: start;
        HorizontalLayout {
            spacing: Theme.s2;
            height: 30px;
            Text { text: root.slot.title; color: Theme.text; font-family: Theme.display; font-size: root.bare ? Theme.t-subheading + 2px : Theme.t-subheading; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if !HomeUi.editing && root.action != "": TextButton {
                y: 1px;
                text: root.action;
                clicked => { root.action-clicked(); }
            }
            if HomeUi.editing: IconButton {
                icon: Icons.chevron-left;
                size: 30px;
                icon-size: 16px;
                tooltip: @tr("Déplacer avant");
                enabled: !root.first;
                clicked => { HomeUi.widget-move(root.slot.kind, -1); }
            }
            if HomeUi.editing: IconButton {
                icon: Icons.chevron-right;
                size: 30px;
                icon-size: 16px;
                tooltip: @tr("Déplacer après");
                enabled: !root.last;
                clicked => { HomeUi.widget-move(root.slot.kind, 1); }
            }
            if HomeUi.editing: IconButton {
                icon: Icons.resize;
                size: 30px;
                icon-size: 16px;
                tooltip: root.slot.span == 1 ? @tr("Taille : 1/3 (cliquer pour agrandir)") : root.slot.span == 2 ? @tr("Taille : 2/3 (cliquer pour agrandir)") : @tr("Taille : pleine largeur (cliquer pour réduire)");
                clicked => { HomeUi.widget-resize(root.slot.kind, root.slot.span >= 3 ? 1 : root.slot.span + 1); }
            }
            if HomeUi.editing: IconButton {
                icon: Icons.eye-off;
                size: 30px;
                icon-size: 16px;
                tooltip: @tr("Masquer ce widget");
                clicked => { HomeUi.widget-toggle(root.slot.kind, false); }
            }
        }
        @children
    }
}

export component HomePage inherits Rectangle {
    /// Largeur utile et gouttière : la largeur de chaque widget en découle (pas de
    /// dépendance au contenu, donc pas de boucle de mise en page).
    property <length> pad: Theme.page-padding;
    property <length> gap: Theme.s6;
    property <length> inner: root.width - 2 * root.pad;
    property <length> colw: (root.inner - 2 * root.gap) / 3;
    property <bool> hero-on-top: HomeUi.hero-first && HomeUi.has-hero && !HomeUi.minimal && !HomeUi.editing;

    if HomeUi.stats.total == 0: Welcome { }

    if HomeUi.stats.total > 0: sv := ScrollView {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.width;
            spacing: Theme.s7 - 8px;
            padding-top: Theme.s6;
            padding-bottom: 48px;

            if root.hero-on-top: HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                Hero { }
            }

            // Mode minimaliste : recherche immédiate et lancement en un clic.
            if HomeUi.minimal: HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                Rectangle {
                    height: 52px;
                    border-radius: Theme.radius;
                    background: ms-ta.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;
                        Icon { source: Icons.search; size: 20px; tint: Theme.text-muted; }
                        Text { text: @tr("Lancer un jeu"); color: Theme.text-muted; font-size: Theme.t-subheading; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: @tr("Ctrl K"); color: Theme.text-dim; font-size: Theme.t-caption; font-weight: 600; vertical-alignment: center; }
                    }
                    ms-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { QuickUi.query = ""; QuickUi.open = true; QuickUi.query-changed(""); }
                    }
                }
            }

            // Mode édition : consigne et actions, en tête de page.
            if HomeUi.editing: HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: Theme.s2;
                height: 36px;
                Text {
                    text: @tr("Personnalisation de l'accueil : déplacez, redimensionnez ou masquez les widgets.");
                    color: Theme.text-muted;
                    font-size: Theme.t-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                SecondaryButton {
                    text: @tr("Réinitialiser");
                    icon: Icons.restore;
                    has-icon: true;
                    clicked => { HomeUi.widgets-reset(); }
                }
                PrimaryButton {
                    text: @tr("Terminé");
                    icon: Icons.check;
                    has-icon: true;
                    clicked => { HomeUi.editing = false; }
                }
            }

            // Widgets masqués : réactivables en mode édition.
            if HomeUi.editing && HomeUi.hidden-widgets.length > 0: VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: Theme.s2;
                Overline { text: @tr("Widgets masqués : cliquer pour ajouter"); }
                for hr in HomeUi.hidden-widgets: HorizontalLayout {
                    spacing: Theme.s2;
                    alignment: start;
                    for w in hr.slots: Chip {
                        text: w.title;
                        icon: Icons.plus;
                        has-icon: true;
                        toggled => { HomeUi.widget-toggle(w.kind, true); }
                    }
                }
            }

            // Le bandeau en tête est déjà affiché en pleine largeur (hors édition).
            for row[ri] in HomeUi.widget-rows: HorizontalLayout {
                visible: !(ri == 0 && HomeUi.hero-first && HomeUi.has-hero && !HomeUi.editing);
                height: self.visible ? self.preferred-height : 0px;
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: root.gap;
                alignment: start;
                for s[si] in row.slots: VerticalLayout {
                    width: root.colw * s.span + root.gap * (s.span - 1);
                    property <length> w: self.width;
                    property <bool> is-first: ri == 0 && si == 0;
                    property <bool> is-last: ri == HomeUi.widget-rows.length - 1 && si == row.slots.length - 1;

                    // « Continuer à jouer » ailleurs qu'en tête de page.
                    if s.kind == 0: VerticalLayout {
                        if HomeUi.has-hero && !HomeUi.editing: Hero { card: s.span < 3; }
                        if HomeUi.editing: WidgetFrame {
                            slot: s;
                            first: is-first;
                            last: is-last;
                        }
                        if !HomeUi.has-hero && !HomeUi.editing: WidgetFrame {
                            slot: s;
                            first: is-first;
                            last: is-last;
                            NoData { text: @tr("Aucun jeu installé à reprendre pour l'instant."); }
                        }
                    }

                    // Étagères de jeux.
                    if s.kind == 1 || s.kind == 2 || s.kind == 11 || s.kind == 12 || s.kind == 13: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        action: @tr("Tout voir");
                        bare: true;
                        action-clicked => {
                            if (s.kind == 1) {
                                LibraryUi.sort = 1;
                                LibraryUi.favorites-only = false;
                                LibraryUi.query-changed();
                                Nav.go(Page.library);
                            } else if (s.kind == 2) {
                                LibraryUi.favorites-only = true;
                                LibraryUi.query-changed();
                                Nav.go(Page.library);
                            } else if (s.kind == 12) {
                                LibraryUi.sort = 2;
                                LibraryUi.favorites-only = false;
                                LibraryUi.query-changed();
                                Nav.go(Page.library);
                            } else if (s.kind == 11) {
                                Nav.go(Page.assistant);
                            } else {
                                Nav.go(Page.library);
                            }
                        }
                        property <[GameCard]> games: s.kind == 1 ? HomeUi.recent : s.kind == 2 ? HomeUi.favorites : s.kind == 11 ? HomeUi.suggested : s.kind == 12 ? HomeUi.added : HomeUi.playing;
                        if self.games.length > 0: Shelf { games: parent.games; tile: AppUi.ui-mode == 1 ? 120px : 148px; }
                        if self.games.length == 0: NoData {
                            text: s.kind == 1 ? @tr("Aucun jeu lancé depuis Halcyon pour l'instant.") : s.kind == 2 ? @tr("Aucun favori. Ajoutez-en depuis le menu d'un jeu (clic droit).") : s.kind == 11 ? @tr("Pas assez de données pour proposer des suggestions.") : s.kind == 13 ? @tr("Aucun jeu marqué « En cours ».") : @tr("Aucun jeu.");
                        }
                    }

                    // Bibliothèque : chiffres et répartition par source.
                    if s.kind == 3: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        action: @tr("Ouvrir");
                        action-clicked => { Nav.go(Page.library); }
                        // Temps de jeu sur sa propre ligne : la colonne est étroite et le texte
                        // (« Jamais joué », « Nie gespielt »…) varie beaucoup selon la langue.
                        HorizontalLayout {
                            spacing: Theme.s6;
                            alignment: start;
                            BigStat { value: HomeUi.stats.total; label: @tr("jeux"); }
                            BigStat { value: HomeUi.stats.installed; label: @tr("installés"); }
                        }
                        BigStat { value: HomeUi.stats.playtime; label: @tr("de jeu"); }
                        for kv in HomeUi.library-summary: MeterRow { label: kv.label; value: kv.value; ratio: kv.ratio; }
                    }

                    // Succès récents (données réelles des fournisseurs ou succès personnalisés).
                    if s.kind == 4: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        action: @tr("Tous les succès");
                        action-clicked => { Nav.go(Page.achievements); }
                        if HomeUi.recent-achievements.length == 0: NoData {
                            text: @tr("Aucun succès débloqué connu. Les succès sont récupérés depuis Steam ou RetroAchievements une fois les comptes configurés.");
                        }
                        for a in HomeUi.recent-achievements: Rectangle {
                            height: 48px;
                            border-radius: Theme.radius-sm;
                            background: a-ta.has-hover ? Theme.surface : transparent;
                            a-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Actions.open-game(a.game-id); }
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    y: 6px;
                                    border-radius: Theme.radius-sm;
                                    clip: true;
                                    background: Theme.surface-active;
                                    if a.has-icon: Image { source: a.icon; width: 36px; height: 36px; image-fit: cover; }
                                    if !a.has-icon: Icon { source: Icons.trophy; size: 18px; tint: Theme.warm; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: a.name; color: Theme.text; font-size: Theme.t-small; font-weight: 600; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: a.game; color: Theme.text-muted; font-size: Theme.t-caption; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: a.date; color: Theme.text-dim; font-size: Theme.t-caption; }
                                    }
                                }
                            }
                        }
                    }

                    // Statistiques : sept derniers jours (sessions suivies par Halcyon).
                    if s.kind == 5: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        action: @tr("Statistiques");
                        action-clicked => { Nav.go(Page.stats); }
                        HorizontalLayout {
                            BigStat { value: HomeUi.week-total; label: @tr("ces 7 derniers jours (suivi local)"); }
                        }
                        BarChart { items: HomeUi.week-bars; height: 120px; }
                    }

                    // Temps de jeu : jeux les plus joués.
                    if s.kind == 6: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        if HomeUi.playtime-summary.length == 0: NoData { text: @tr("Aucun temps de jeu connu."); }
                        for kv in HomeUi.playtime-summary: MeterRow { label: kv.label; value: kv.value; ratio: kv.ratio; }
                    }

                    // Activité récente (journal).
                    if s.kind == 7: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        action: @tr("Journal");
                        action-clicked => { Nav.go(Page.journal); }
                        if HomeUi.recent-activity.length == 0: NoData { text: @tr("Aucune activité enregistrée."); }
                        for e in HomeUi.recent-activity: HorizontalLayout {
                            spacing: Theme.s3;
                            Text { text: e.time; color: Theme.text-dim; font-size: Theme.t-caption; width: 92px; overflow: elide; }
                            VerticalLayout {
                                spacing: 1px;
                                Text { text: e.title; color: Theme.text; font-size: Theme.t-small; font-weight: 600; overflow: elide; }
                                if e.detail != "": Text { text: e.detail; color: Theme.text-dim; font-size: Theme.t-caption; overflow: elide; }
                            }
                        }
                    }

                    // Stockage : disques réels et taille déclarée des jeux installés.
                    if s.kind == 8: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        if HomeUi.storage.length == 0: NoData { text: @tr("Aucune information de stockage disponible."); }
                        for kv in HomeUi.storage: MeterRow {
                            label: kv.label;
                            value: kv.value;
                            ratio: kv.ratio;
                            bar-color: kv.ratio > 0.9 ? Theme.danger : kv.ratio > 0.75 ? Theme.warm : Theme.accent;
                        }
                    }

                    // Émulateurs détectés.
                    if s.kind == 9: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        action: @tr("Gérer");
                        action-clicked => { Nav.go(Page.emulators); }
                        if HomeUi.emulator-summary.length == 0: NoData { text: @tr("Aucun émulateur détecté. Ajoutez un dossier de ROM et installez un émulateur pris en charge."); }
                        for kv in HomeUi.emulator-summary: KvLine { label: kv.label; value: kv.value; }
                    }

                    // Captures d'écran locales.
                    if s.kind == 10: WidgetFrame {
                        slot: s;
                        first: is-first;
                        last: is-last;
                        property <length> inner-w: w - (HomeUi.editing ? 2 * Theme.s4 : 0px);
                        property <int> per-row: max(1, floor((self.inner-w + Theme.s2) / (200px + Theme.s2)));
                        property <length> thumb: (self.inner-w - (self.per-row - 1) * Theme.s2) / self.per-row;
                        if HomeUi.captures.length == 0: NoData { text: HomeUi.captures-note; }
                        if HomeUi.captures.length > 0: Rectangle {
                            height: ceil(min(HomeUi.captures.length, parent.per-row * 2) / parent.per-row) * (parent.thumb * 9 / 16 + Theme.s2) - Theme.s2;
                            for c[i] in HomeUi.captures: Rectangle {
                                property <length> iw: w - (HomeUi.editing ? 2 * Theme.s4 : 0px);
                                property <int> pr: max(1, floor((self.iw + Theme.s2) / (200px + Theme.s2)));
                                property <length> tw: (self.iw - (self.pr - 1) * Theme.s2) / self.pr;
                                visible: i < self.pr * 2;
                                x: mod(i, self.pr) * (self.tw + Theme.s2);
                                y: floor(i / self.pr) * (self.tw * 9 / 16 + Theme.s2);
                                width: self.tw;
                                height: self.tw * 9 / 16;
                                border-radius: Theme.radius-cover;
                                clip: true;
                                background: Theme.surface-active;
                                Image { source: c.image; width: parent.width; height: parent.height; image-fit: cover; }
                                Rectangle {
                                    y: parent.height - 26px;
                                    height: 26px;
                                    background: Theme.scrim;
                                    opacity: cap-ta.has-hover ? 1 : 0;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text { text: c.title; color: #fff; font-size: Theme.t-caption; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                        Text { text: c.date; color: #ffffffb0; font-size: Theme.t-caption; vertical-alignment: center; }
                                    }
                                }
                                cap-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { HomeUi.open-capture(i); }
                                }
                            }
                        }
                    }
                }
            }

            // Personnalisation : en pied de page, discrète.
            if !HomeUi.editing && !HomeUi.minimal: HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                alignment: start;
                SecondaryButton {
                    text: @tr("Personnaliser l'accueil");
                    icon: Icons.edit;
                    has-icon: true;
                    clicked => { HomeUi.editing = true; }
                }
            }
        }
    }
}
