// Bibliothèque : cinq vues (grille, liste, carrousel, immersive, compacte), sélection
// commune au clavier et à la manette, menu contextuel, filtres et tri.
//
// Composition « Berge » : un index de filtres à gauche (sources, affichage, collections,
// genre), comme la marge d'un catalogue ; à droite, le titre, la barre d'outils et les
// jeux. Les vues de mise au point (carrousel, immersive) rendent toute la largeur au jeu.
//
// La sélection est tenue par Rust (`LibraryUi.selected`, position dans la liste filtrée) :
// elle survit aux changements de vue et de filtre. Le carrousel et le mode immersif ne
// reçoivent qu'une fenêtre d'une vingtaine de jeux autour de la sélection (`strip`).

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Art } from "../theme.slint";
import { GameCard, StripItem } from "../types.slint";
import { Actions, LibraryUi, AppUi, SmartUi, GameMenu } from "../state.slint";
import {
    GameTile, GameCover, PrimaryButton, PlayButton, SecondaryButton, TextButton, IconButton, Chip, Segmented, TextField,
    Dropdown, Icon, Overline, KeyHint
} from "../components.slint";

/// Ligne de la vue en liste.
component ListRow inherits Rectangle {
    in property <GameCard> game;
    in property <bool> selected;
    height: 60px;
    background: root.selected ? Theme.surface-active : ta.has-hover ? Theme.surface : transparent;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    if root.selected: Rectangle { x: 0; width: Theme.perch; background: Theme.accent; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Actions.open-game(root.game.id); }
        double-clicked => { Actions.play(root.game.id); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                GameMenu.request(root.game.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 16px;
        GameCover {
            y: 6px;
            width: 32px;
            height: 48px;
            corner: 2px;
            show-title: false;
            source: root.game.cover;
            has-image: root.game.has-cover;
            color-a: root.game.color-a;
            color-b: root.game.color-b;
            initials: root.game.initials;
            title: root.game.title;
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.game.title; color: Theme.text; font-size: Theme.t-body; font-weight: 600; overflow: elide; }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Text { text: root.game.source; color: Theme.text-dim; font-size: Theme.t-caption; overflow: elide; }
                if root.game.badge != "": Text { text: root.game.badge; color: Theme.accent; font-size: Theme.t-caption; font-weight: 600; }
                if !root.game.installed: Text { text: @tr("Non installé"); color: Theme.text-dim; font-size: Theme.t-caption; }
            }
        }
        // Temps de jeu : chiffre composé dans la police d'affichage ; « Jamais joué » en texte discret.
        Text {
            property <bool> played: root.game.last-played != "—" && root.game.playtime != "";
            width: 120px;
            text: root.game.playtime == "" ? "—" : root.game.playtime;
            color: self.played ? Theme.text : Theme.text-dim;
            font-family: self.played ? Theme.display : Theme.font;
            font-size: Theme.t-small;
            font-weight: self.played ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Text { width: 150px; text: root.game.last-played; color: Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; overflow: elide; }
        Rectangle {
            width: 34px;
            IconButton {
                icon: root.game.favorite ? Icons.star-filled : Icons.star;
                tint: root.game.favorite ? Theme.warm : Theme.text-dim;
                active-tint: Theme.warm;
                icon-size: 16px;
                tooltip: root.game.favorite ? @tr("Retirer des favoris") : @tr("Ajouter aux favoris");
                clicked => { Actions.toggle-favorite(root.game.id); }
            }
        }
        Rectangle {
            width: 34px;
            IconButton {
                icon: Icons.play;
                icon-size: 14px;
                enabled: root.game.installed;
                tint: Theme.warm;
                active-tint: Theme.warm-hover;
                tooltip: root.game.installed ? @tr("Jouer") : @tr("Non installé");
                clicked => { Actions.play(root.game.id); }
            }
        }
        Rectangle {
            width: 34px;
            IconButton {
                icon: Icons.more;
                icon-size: 16px;
                tooltip: @tr("Plus d'actions (touche Menu)");
                clicked => { GameMenu.request(root.game.id, self.absolute-position.x - 220px, self.absolute-position.y + 36px); }
            }
        }
    }
}

/// Bande de jaquettes centrée sur la sélection (carrousel, mode immersif). Les positions
/// suivent une valeur animée : le défilement glisse au lieu de sauter.
component Strip inherits Rectangle {
    in property <length> tile: 190px;
    in property <length> gap: 22px;
    in property <bool> show-text: true;
    in property <float> anchor: 0.5;
    property <float> pos: LibraryUi.selected;
    animate pos { duration: Theme.normal; easing: ease-out; }
    height: root.show-text ? root.tile * 1.5 * 1.08 + 60px : root.tile * 1.5 * 1.08 + 12px;
    clip: true;

    for item in LibraryUi.strip: GameTile {
        property <bool> is-sel: item.index == LibraryUi.selected;
        x: root.width * root.anchor - root.tile / 2 + (item.index - root.pos) * (root.tile + root.gap) - (self.is-sel ? root.tile * 0.04 : 0px);
        y: self.is-sel ? 6px : root.tile * 1.5 * 0.04 + 6px;
        cover-width: self.is-sel ? root.tile * 1.08 : root.tile;
        visible: self.x + self.width > -20px && self.x < root.width + 20px;
        game: item.card;
        selected: self.is-sel;
        show-text: root.show-text;
        animate cover-width, y { duration: Theme.fast; easing: ease-out; }
        open(id) => {
            if (self.is-sel) {
                Actions.open-game(id);
            } else {
                LibraryUi.select-index(item.index);
            }
        }
        play(id) => { Actions.play(id); }
        context(id, x, y) => { GameMenu.request(id, x, y); }
    }
}

/// Fiche du jeu sélectionné (carrousel, mode immersif).
component FocusInfo inherits VerticalLayout {
    in property <bool> large: false;
    spacing: Theme.s3;
    alignment: end;
    if LibraryUi.focus-game.has-logo && root.large: Image {
        height: 110px;
        source: LibraryUi.focus-game.logo;
        image-fit: contain;
        horizontal-alignment: left;
        vertical-alignment: bottom;
    }
    if !(LibraryUi.focus-game.has-logo && root.large): Text {
        text: LibraryUi.focus-game.title;
        color: Theme.text;
        font-family: Theme.display;
        font-size: root.large ? Theme.t-display - 4px : Theme.t-title;
        font-weight: 800;
        horizontal-alignment: root.large ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
        overflow: elide;
    }
    Text { text: LibraryUi.focus-meta; color: Theme.text-muted; font-size: Theme.t-body; overflow: elide; horizontal-alignment: root.large ? TextHorizontalAlignment.left : TextHorizontalAlignment.center; }
    if root.large && LibraryUi.focus-game.description != "": Text {
        text: LibraryUi.focus-game.description;
        color: Theme.text-muted;
        font-size: Theme.t-body;
        wrap: word-wrap;
        overflow: elide;
        max-height: 60px;
    }
    HorizontalLayout {
        spacing: Theme.s3;
        alignment: root.large ? LayoutAlignment.start : LayoutAlignment.center;
        padding-top: 6px;
        PlayButton {
            big: true;
            text: LibraryUi.focus-game.installed ? @tr("Jouer") : @tr("Non installé");
            enabled: LibraryUi.focus-game.installed;
            clicked => { Actions.play(LibraryUi.focus-game.id); }
        }
        SecondaryButton {
            text: @tr("Voir la fiche");
            h: 48px;
            clicked => { Actions.open-game(LibraryUi.focus-game.id); }
        }
        IconButton {
            y: 7px;
            icon: LibraryUi.focus-game.favorite ? Icons.star-filled : Icons.star;
            tint: LibraryUi.focus-game.favorite ? Theme.warm : Theme.text-muted;
            glass: root.large;
            tooltip: LibraryUi.focus-game.favorite ? @tr("Retirer des favoris") : @tr("Ajouter aux favoris");
            clicked => { Actions.toggle-favorite(LibraryUi.focus-game.id); }
        }
        IconButton {
            y: 7px;
            icon: Icons.more;
            glass: root.large;
            tooltip: @tr("Plus d'actions (touche Menu)");
            clicked => { GameMenu.request(LibraryUi.focus-game.id, self.absolute-position.x, self.absolute-position.y + 40px); }
        }
    }
}

/// Illustration plein cadre du jeu sélectionné : bannière, sinon ambiance tirée de la jaquette.
component Backdrop inherits Rectangle {
    clip: true;
    background: LibraryUi.focus-game.color-a.mix(#101215, 0.35);
    if LibraryUi.focus-game.has-banner: Image {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        source: LibraryUi.focus-game.banner;
        image-fit: cover;
    }
    if !LibraryUi.focus-game.has-banner: Image {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        source: LibraryUi.focus-ambient;
        image-fit: cover;
        image-rendering: smooth;
        opacity: 0.8;
    }
    Image { x: 0; y: 0; width: root.width * 0.8; height: root.height; source: Art.fade-left; image-fit: fill; colorize: Theme.bg; }
    Image { x: 0; y: 0; width: root.width; height: root.height; source: Art.fade-bottom; image-fit: fill; colorize: Theme.bg; }
}

/// Sélecteur de vue (5 icônes).
component ViewSwitch inherits Rectangle {
    height: 32px;
    width: lay.preferred-width;
    border-radius: Theme.radius;
    background: Theme.surface;
    lay := HorizontalLayout {
        padding: 1px;
        for v[i] in [
            { icon: Icons.grid, tip: @tr("Grille") },
            { icon: Icons.list, tip: @tr("Liste") },
            { icon: Icons.carousel, tip: @tr("Carrousel") },
            { icon: Icons.immersive, tip: @tr("Immersive") },
            { icon: Icons.compact, tip: @tr("Compacte") },
        ]: IconButton {
            size: 30px;
            icon-size: 16px;
            icon: v.icon;
            active: LibraryUi.view-mode == i;
            tooltip: @tr("Vue : {}", v.tip);
            clicked => {
                LibraryUi.view-mode = i;
                LibraryUi.view-changed();
            }
        }
    }
}

/// Entrée de l'index : choix exclusif (source, collection), perche quand il est actif.
component IndexItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    // Une ligne d'ordinaire ; deux si le nom est long (selon la langue), sans couper le compte.
    height: max(30px, label.preferred-height + 12px);
    accessible-role: radio-button;
    accessible-checked: root.active;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;
    background: ta.has-hover ? Theme.surface : transparent;
    border-radius: Theme.radius-sm;
    if root.active: Rectangle { x: 0; y: 7px; width: Theme.perch; height: parent.height - 14px; background: Theme.accent; }
    label := Text {
        x: 12px;
        width: parent.width - 16px;
        text: root.text;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.t-small;
        font-weight: root.active ? 650 : 500;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    if fs.has-focus: Rectangle { border-radius: Theme.radius-sm; border-width: Theme.focus-width; border-color: Theme.focus; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
}

/// Case à cocher de l'index (affichage).
component IndexCheck inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled;
    height: 30px;
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => { root.toggled(); }
    forward-focus: fs;
    background: ta.has-hover ? Theme.surface : transparent;
    border-radius: Theme.radius-sm;
    Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 2px;
        background: root.checked ? Theme.accent : transparent;
        border-width: root.checked ? 0px : 1px;
        border-color: Theme.text-dim;
        if root.checked: Icon { source: Icons.check; size: 12px; tint: Theme.on-accent; }
    }
    Text {
        x: 36px;
        width: parent.width - 40px;
        text: root.text;
        color: root.checked ? Theme.text : Theme.text-muted;
        font-size: Theme.t-small;
        font-weight: root.checked ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    if fs.has-focus: Rectangle { border-radius: Theme.radius-sm; border-width: Theme.focus-width; border-color: Theme.focus; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.toggled(); return accept; }
            reject
        }
    }
}

/// Index des filtres (colonne gauche).
component FilterIndex inherits Rectangle {
    property <[string]> sources: [@tr("Tous les jeux"), "Steam", "Epic Games", @tr("Émulation"), @tr("Autres"), "Minecraft", "GOG"];
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
    Flickable {
        width: parent.width - 1px;
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding-left: Theme.page-padding - 12px;
            padding-right: 16px;
            padding-top: 30px;
            padding-bottom: 30px;
            spacing: 2px;
            alignment: start;
            Overline { text: @tr("Sources"); height: 26px; x: 12px; vertical-alignment: top; }
            for label[i] in root.sources: IndexItem {
                text: label;
                active: LibraryUi.source == i;
                clicked => { LibraryUi.source = i; LibraryUi.query-changed(); }
            }
            for label[i] in LibraryUi.extra-sources: IndexItem {
                text: label;
                active: LibraryUi.source == 7 + i;
                clicked => { LibraryUi.source = 7 + i; LibraryUi.query-changed(); }
            }
            Rectangle { height: 22px; }
            Overline { text: @tr("Afficher"); height: 26px; x: 12px; vertical-alignment: top; }
            IndexCheck {
                text: @tr("Installés seulement");
                checked: LibraryUi.installed-only;
                toggled => { LibraryUi.installed-only = !LibraryUi.installed-only; LibraryUi.query-changed(); }
            }
            IndexCheck {
                text: @tr("Favoris seulement");
                checked: LibraryUi.favorites-only;
                toggled => { LibraryUi.favorites-only = !LibraryUi.favorites-only; LibraryUi.query-changed(); }
            }
            IndexCheck {
                text: @tr("Jeux masqués");
                checked: LibraryUi.show-hidden;
                toggled => { LibraryUi.show-hidden = !LibraryUi.show-hidden; LibraryUi.query-changed(); }
            }
            Rectangle { height: 22px; }
            Overline { text: @tr("Collections"); height: 26px; x: 12px; vertical-alignment: top; }
            for label[i] in LibraryUi.collection-labels: IndexItem {
                text: label;
                active: LibraryUi.collection == i;
                clicked => { LibraryUi.collection = i; LibraryUi.query-changed(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-top: 4px;
                TextButton { text: @tr("Collections intelligentes"); clicked => { SmartUi.editing-id = -1; SmartUi.open = true; } }
            }
            if LibraryUi.genre-labels.length > 1: Rectangle { height: 22px; }
            if LibraryUi.genre-labels.length > 1: Overline { text: @tr("Genre"); height: 26px; x: 12px; vertical-alignment: top; }
            if LibraryUi.genre-labels.length > 1: HorizontalLayout {
                padding-left: 12px;
                Dropdown {
                    prefix: "";
                    align-left: true;
                    popup-width: 220px;
                    options: LibraryUi.genre-labels;
                    selected <=> LibraryUi.genre;
                    changed => { LibraryUi.query-changed(); }
                }
            }
        }
    }
}

export component LibraryPage inherits Rectangle {
    property <bool> immersive: LibraryUi.view-mode == 3;
    property <bool> focus-view: LibraryUi.view-mode == 2 || LibraryUi.view-mode == 3;
    /// Index des filtres : vues de parcours, fenêtre assez large.
    property <bool> show-index: !root.focus-view && root.width >= 1000px;
    property <length> index-w: root.show-index ? 236px : 0px;
    property <length> pad-l: root.show-index ? 32px : Theme.page-padding;
    property <length> pad-r: Theme.page-padding;
    property <length> gap: LibraryUi.view-mode == 4 ? 12px : 22px;
    property <length> row-gap: LibraryUi.view-mode == 4 ? 12px : 26px;
    property <length> card: LibraryUi.view-mode == 4 ? max(96px, LibraryUi.card-width * 0.66) : LibraryUi.card-width;
    property <length> available: max(1px, root.width - root.index-w - root.pad-l - root.pad-r);
    out property <int> columns: max(1, floor((self.available + self.gap) / (root.card + self.gap)));
    property <length> tile-width: (self.available - (self.columns - 1) * self.gap) / self.columns;
    property <bool> grid-like: LibraryUi.view-mode == 0 || LibraryUi.view-mode == 4;
    property <length> grid-row-h: root.tile-width * 1.5 + (LibraryUi.view-mode == 4 ? 0px : 52px) + root.row-gap;

    changed columns => { LibraryUi.columns-changed(self.grid-like ? self.columns : 1); }
    changed grid-like => { LibraryUi.columns-changed(self.grid-like ? self.columns : 1); }
    init => { LibraryUi.columns-changed(self.grid-like ? self.columns : 1); }

    public function focus-search() {
        search.focus();
    }
    public function focus-grid() {
        keys.focus();
    }

    // Défilement vers la sélection (grille, liste), seulement si elle sort de l'écran.
    property <int> tick: LibraryUi.scroll-tick;
    changed tick => {
        if (LibraryUi.scroll-row < 0) {
            return;
        }
        if (root.grid-like) {
            grid.ensure-visible(LibraryUi.scroll-row * root.grid-row-h, root.grid-row-h);
        } else if (LibraryUi.view-mode == 1) {
            list.ensure-visible(LibraryUi.scroll-row * 60px, 60px);
        }
    }

    // Clavier (et manette, qui envoie des touches) : flèches, Entrée, Espace, Menu.
    keys := FocusScope {
        key-pressed(event) => {
            // Alt+flèches : historique (géré par la fenêtre).
            if (LibraryUi.result-count == 0 || event.modifiers.alt || event.modifiers.meta) {
                return reject;
            }
            if (event.text == Key.RightArrow) { LibraryUi.move-selection(1, 0); return accept; }
            if (event.text == Key.LeftArrow) { LibraryUi.move-selection(-1, 0); return accept; }
            if (event.text == Key.DownArrow) { LibraryUi.move-selection(0, 1); return accept; }
            if (event.text == Key.UpArrow) { LibraryUi.move-selection(0, -1); return accept; }
            if (event.text == Key.PageDown) { LibraryUi.move-selection(0, 5); return accept; }
            if (event.text == Key.PageUp) { LibraryUi.move-selection(0, -5); return accept; }
            if (event.text == Key.Home && !event.modifiers.control) { LibraryUi.select-index(0); return accept; }
            if (event.text == Key.End && !event.modifiers.control) { LibraryUi.select-index(LibraryUi.result-count - 1); return accept; }
            if (event.text == Key.Return && LibraryUi.selected >= 0) { LibraryUi.activate-selection(event.modifiers.control); return accept; }
            if (event.text == " " && LibraryUi.selected >= 0) { LibraryUi.activate-selection(true); return accept; }
            if (event.text == Key.Menu && LibraryUi.selected-id >= 0) { GameMenu.request(LibraryUi.selected-id, -1px, -1px); return accept; }
            reject
        }

        if root.immersive && LibraryUi.result-count > 0: Backdrop { }

        if root.show-index: FilterIndex { x: 0; width: root.index-w; height: root.height; }

        VerticalLayout {
            x: root.index-w;
            width: root.width - root.index-w;
            // Titre et nombre de jeux.
            HorizontalLayout {
                padding-left: root.pad-l;
                padding-right: root.pad-r;
                padding-top: root.immersive ? 72px : 28px;
                spacing: 14px;
                Text {
                    text: @tr("Bibliothèque");
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: Theme.t-title;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: LibraryUi.result-count == LibraryUi.total ? LibraryUi.total : LibraryUi.result-count + " / " + LibraryUi.total;
                    color: Theme.text-dim;
                    font-family: Theme.display;
                    font-size: Theme.t-title;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                SecondaryButton {
                    y: 4px;
                    text: root.width > 1100px ? @tr("Ajouter un jeu") : "";
                    icon: Icons.plus;
                    has-icon: true;
                    clicked => { AppUi.add-dialog-open = true; }
                }
            }

            // Barre d'outils : recherche, tri, taille, vue.
            HorizontalLayout {
                padding-left: root.pad-l;
                padding-right: root.pad-r;
                padding-top: 18px;
                padding-bottom: 18px;
                spacing: 10px;
                search := TextField {
                    min-width: 180px;
                    max-width: 380px;
                    horizontal-stretch: 1;
                    placeholder: @tr("Rechercher dans la bibliothèque  (Ctrl+F)");
                    icon: Icons.search;
                    has-icon: true;
                    text <=> LibraryUi.search;
                    edited => { LibraryUi.query-changed(); }
                    accepted => { keys.focus(); }
                }
                help-btn := IconButton {
                    y: 1px;
                    icon: Icons.info;
                    tooltip: @tr("Syntaxe de recherche");
                    clicked => { help.show(); }
                }
                help := PopupWindow {
                    x: help-btn.x - 10px;
                    y: help-btn.y + 40px;
                    width: 440px;
                    height: help-box.preferred-height;
                    Rectangle {
                        background: Theme.surface-hover;
                        border-radius: Theme.radius-lg;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000080;
                        help-box := VerticalLayout {
                            padding: 18px;
                            spacing: 6px;
                            Text { text: @tr("Recherche avancée"); color: Theme.text; font-family: Theme.display; font-size: Theme.t-body; font-weight: 700; }
                            Text { text: @tr("Les fautes de frappe et les sigles sont tolérés (« witchr », « gta »). Combinez des filtres :"); color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; }
                            for line in [
                                @tr("dev:valve   éditeur:\"bandai namco\"   genre:rpg"),
                                @tr("plateforme:snes   source:steam   tag:multijoueur"),
                                @tr("installé:non   favori:oui   maj:oui"),
                                @tr("statut:terminé   statut:\"en cours\"   statut:abandonné"),
                                @tr("temps:>10h   temps:<30m   temps:0"),
                                @tr("succès:complet   succès:manquants   succès:>80"),
                                @tr("-filtre:valeur  exclut (ex. -installé:oui)"),
                            ]: Text { text: line; color: Theme.accent; font-size: Theme.t-caption; font-family: "monospace"; }
                            Text { text: @tr("Flèches : sélection. Entrée : fiche. Espace : jouer. Menu : actions."); color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Dropdown {
                    prefix: root.width > 1240px ? @tr("Trier par") : "";
                    options: LibraryUi.sort-labels;
                    selected <=> LibraryUi.sort;
                    changed => { LibraryUi.query-changed(); }
                }
                if root.grid-like && root.width > 900px: Segmented {
                    items: ["S", "M", "L"];
                    selected: LibraryUi.card-width < 150px ? 0 : LibraryUi.card-width < 190px ? 1 : 2;
                    activated(i) => { LibraryUi.card-size(i == 0 ? 132 : i == 1 ? 168 : 214); }
                }
                ViewSwitch { }
            }

            // Fenêtre étroite ou vue de mise au point : filtres en ligne (l'index est masqué).
            if !root.show-index: HorizontalLayout {
                padding-left: root.pad-l;
                padding-right: root.pad-r;
                padding-bottom: 18px;
                spacing: 8px;
                Segmented {
                    items: root.width > 1480px ? [@tr("Tous"), "Steam", "Epic", @tr("Émulation"), @tr("Autres"), "Minecraft", "GOG"] : [@tr("Tous"), "Steam", "Epic", @tr("Ému."), @tr("Autres"), "MC", "GOG"];
                    selected <=> LibraryUi.source;
                    activated => { LibraryUi.query-changed(); }
                }
                Rectangle { width: 6px; }
                Chip {
                    text: @tr("Installés");
                    checked: LibraryUi.installed-only;
                    toggled => {
                        LibraryUi.installed-only = !LibraryUi.installed-only;
                        LibraryUi.query-changed();
                    }
                }
                Chip {
                    text: @tr("Favoris");
                    checked: LibraryUi.favorites-only;
                    toggled => {
                        LibraryUi.favorites-only = !LibraryUi.favorites-only;
                        LibraryUi.query-changed();
                    }
                }
                Chip {
                    text: @tr("Masqués");
                    checked: LibraryUi.show-hidden;
                    toggled => {
                        LibraryUi.show-hidden = !LibraryUi.show-hidden;
                        LibraryUi.query-changed();
                    }
                }
                if LibraryUi.collection-labels.length > 1: Dropdown {
                    prefix: "";
                    popup-width: 280px;
                    options: LibraryUi.collection-labels;
                    selected <=> LibraryUi.collection;
                    changed => { LibraryUi.query-changed(); }
                }
                SecondaryButton {
                    text: root.width > 1480px ? @tr("Collections intelligentes") : "";
                    icon: Icons.bolt;
                    has-icon: true;
                    h: 30px;
                    clicked => { SmartUi.editing-id = -1; SmartUi.open = true; }
                }
                if LibraryUi.genre-labels.length > 1: Dropdown {
                    prefix: "";
                    options: LibraryUi.genre-labels;
                    selected <=> LibraryUi.genre;
                    changed => { LibraryUi.query-changed(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            if LibraryUi.search-warning != "": HorizontalLayout {
                padding-left: root.pad-l;
                height: 26px;
                Text { text: LibraryUi.search-warning; color: Theme.warm; font-size: Theme.t-caption; vertical-alignment: top; }
            }

            // Contenu
            Rectangle {
                vertical-stretch: 1;

                if LibraryUi.result-count == 0: VerticalLayout {
                    x: root.pad-l;
                    width: min(560px, parent.width - root.pad-l - root.pad-r);
                    alignment: start;
                    padding-top: 40px;
                    spacing: 10px;
                    Text {
                        text: LibraryUi.total == 0 ? @tr("Votre bibliothèque est vide") : @tr("Aucun jeu ne correspond");
                        color: Theme.text;
                        font-family: Theme.display;
                        font-size: Theme.t-heading;
                        font-weight: 700;
                    }
                    Text {
                        text: LibraryUi.total == 0
                            ? @tr("Lancez une analyse ou ajoutez un dossier de jeux dans les paramètres.")
                            : @tr("Essayez un autre terme ou retirez des filtres. Champs de recherche : dev:, éditeur:, genre:, plateforme:, tag:, statut:, installé:, temps:, succès:, maj:");
                        color: Theme.text-muted;
                        font-size: Theme.t-body;
                        wrap: word-wrap;
                    }
                    if LibraryUi.total == 0: HorizontalLayout {
                        alignment: start;
                        padding-top: 8px;
                        PrimaryButton {
                            text: AppUi.scanning ? @tr("Analyse en cours…") : @tr("Rechercher mes jeux");
                            enabled: !AppUi.scanning;
                            clicked => { Actions.rescan(); }
                        }
                    }
                }

                // Grille et vue compacte : rangées virtualisées (seules les rangées visibles existent).
                grid := ListView {
                    visible: root.grid-like && LibraryUi.result-count > 0;
                    public function ensure-visible(top: length, h: length) {
                        if (top + self.content-y < 0) {
                            self.content-y = -top;
                        } else if (top + h + self.content-y > self.visible-height) {
                            self.content-y = -(top + h - self.visible-height);
                        }
                    }
                    for row in LibraryUi.rows: Rectangle {
                        height: root.grid-row-h;
                        for card[c] in row.cards: GameTile {
                            x: root.pad-l + c * (root.tile-width + root.gap);
                            y: 6px;
                            game: card;
                            cover-width: root.tile-width;
                            show-text: LibraryUi.view-mode != 4;
                            selected: card.id == LibraryUi.selected-id;
                            open(id) => { Actions.open-game(id); }
                            play(id) => { Actions.play(id); }
                            context(id, x, y) => { GameMenu.request(id, x, y); }
                        }
                    }
                }

                VerticalLayout {
                    visible: LibraryUi.view-mode == 1 && LibraryUi.result-count > 0;
                    // En-tête du tableau.
                    HorizontalLayout {
                        padding-left: root.pad-l + 14px;
                        padding-right: root.pad-r + 8px;
                        padding-bottom: 8px;
                        spacing: 16px;
                        Rectangle { width: 32px; }
                        Overline { text: @tr("Titre"); horizontal-stretch: 1; }
                        Overline { width: 120px; text: @tr("Temps de jeu"); }
                        Overline { width: 150px; text: @tr("Dernier lancement"); }
                        Rectangle { width: 134px; }
                    }
                    HorizontalLayout {
                        padding-left: root.pad-l;
                        padding-right: root.pad-r;
                        Rectangle { height: 1px; background: Theme.border-strong; }
                    }
                    list := ListView {
                        public function ensure-visible(top: length, h: length) {
                            if (top + self.content-y < 0) {
                                self.content-y = -top;
                            } else if (top + h + self.content-y > self.visible-height) {
                                self.content-y = -(top + h - self.visible-height);
                            }
                        }
                        for item in LibraryUi.items: Rectangle {
                            height: 60px;
                            ListRow {
                                x: root.pad-l;
                                width: parent.width - root.pad-l - root.pad-r;
                                game: item;
                                selected: item.id == LibraryUi.selected-id;
                            }
                        }
                    }
                }

                // Carrousel : grandes jaquettes et fiche résumée du jeu sélectionné.
                if LibraryUi.view-mode == 2 && LibraryUi.result-count > 0: VerticalLayout {
                    padding-bottom: Theme.s6;
                    spacing: Theme.s5;
                    alignment: center;
                    Strip { tile: min(220px, max(150px, (parent.height - 230px) / 1.62)); }
                    HorizontalLayout {
                        padding-left: Theme.page-padding;
                        padding-right: Theme.page-padding;
                        alignment: center;
                        FocusInfo { width: min(760px, root.width - 2 * Theme.page-padding); }
                    }
                }

                // Immersive : illustration plein cadre, fiche, bande de jaquettes en bas.
                if root.immersive && LibraryUi.result-count > 0: VerticalLayout {
                    padding-bottom: Theme.s5;
                    spacing: Theme.s5;
                    HorizontalLayout {
                        vertical-stretch: 1;
                        padding-left: Theme.page-padding;
                        padding-right: Theme.page-padding;
                        FocusInfo { large: true; width: min(680px, root.width - 2 * Theme.page-padding); }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Strip { tile: 118px; gap: 14px; show-text: false; anchor: 0.12; }
                    HorizontalLayout {
                        padding-left: Theme.page-padding;
                        spacing: Theme.s5;
                        alignment: start;
                        KeyHint { key: "←→"; label: @tr("Parcourir"); }
                        KeyHint { key: @tr("Entrée"); label: @tr("Fiche"); }
                        KeyHint { key: @tr("Espace"); label: @tr("Jouer"); }
                        KeyHint { key: @tr("Menu"); label: @tr("Actions"); }
                    }
                }
            }
        }
    }
}
