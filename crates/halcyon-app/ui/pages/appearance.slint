import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { ThemeUi, AppUi } from "../state.slint";
import { Panel, SectionTitle, PageHeader, SecondaryButton, PrimaryButton, TextField, Toggle, Segmented, Chip, Icon, Notice, IconButton } from "../components.slint";

component Row inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 20px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        alignment: center;
        Text { text: root.title; color: Theme.text; font-size: Theme.t-body; font-weight: 500; wrap: word-wrap; }
        if root.description != "": Text { text: root.description; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
    }
    @children
}

export component AppearancePage inherits Rectangle {
    in-out property <string> bg-path: ThemeUi.background;
    in-out property <string> accent-hex: ThemeUi.accent;
    in-out property <string> import-path;
    in-out property <string> profile-name;
    ScrollView {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.width;
            padding: Theme.page-padding;
            padding-right: max(Theme.page-padding, root.width - Theme.page-padding - 960px);
            padding-top: 28px;
            spacing: 22px;
            alignment: start;

            PageHeader {
                title: @tr("Apparence");
                subtitle: @tr("Thème, couleurs, fond, densité et organisation de l'interface. Les changements s'appliquent immédiatement.");
                SecondaryButton { y: 6px; text: @tr("Rétablir les réglages d'origine"); clicked => { ThemeUi.reset(); } }
            }

            SectionTitle { text: @tr("Thème"); }
            // Chaque thème en miniature : colonne de navigation, perche, jaquettes, « Jouer ».
            Flickable {
                height: 140px;
                content-width: swatches.preferred-width;
                swatches := HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    for t[i] in ThemeUi.themes: Rectangle {
                        width: 168px;
                        height: 140px;
                        ta := TouchArea { mouse-cursor: pointer; clicked => { ThemeUi.select-theme(i); } }
                        Rectangle {
                            y: 0;
                            height: 100px;
                            border-radius: Theme.radius;
                            background: t.bg;
                            clip: true;
                            border-width: ThemeUi.selected == i ? 2px : 1px;
                            border-color: ThemeUi.selected == i ? Theme.focus : ta.has-hover ? Theme.border-strong : Theme.border;
                            Rectangle { x: 0; width: 34px; background: t.bg.darker(0.25); }
                            Rectangle { x: 0; y: 22px; width: 3px; height: 12px; background: t.accent; }
                            Rectangle { x: 10px; y: 24px; width: 16px; height: 4px; background: t.accent.with-alpha(0.7); }
                            Rectangle { x: 10px; y: 40px; width: 14px; height: 4px; background: t.surface.brighter(0.4); }
                            Rectangle { x: 10px; y: 52px; width: 14px; height: 4px; background: t.surface.brighter(0.4); }
                            Rectangle { x: 46px; y: 16px; width: 60px; height: 8px; background: t.surface.brighter(0.6); }
                            for k in 3: Rectangle { x: 46px + k * 36px; y: 34px; width: 30px; height: 45px; border-radius: 2px; background: t.surface; }
                            Rectangle { x: parent.width - 30px; y: parent.height - 20px; width: 20px; height: 10px; border-radius: 2px; background: #f08a24; }
                        }
                        Text { x: 0; y: 108px; text: t.name; color: ThemeUi.selected == i ? Theme.text : Theme.text-muted; font-size: Theme.t-small; font-weight: ThemeUi.selected == i ? 650 : 500; }
                        if t.source != "": Text { x: 0; y: 126px; width: parent.width; text: t.source; color: Theme.text-dim; font-size: Theme.t-overline; overflow: elide; }
                    }
                }
            }

            Panel {
                VerticalLayout {
                    padding: 22px;
                    spacing: 18px;
                    Row {
                        title: @tr("Couleur d'accent");
                        description: @tr("Boutons, sélection et indicateurs. Une teinte personnalisée s'écrit #RRGGBB.");
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for c[i] in ThemeUi.accents: Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.radius-sm;
                            border-width: Theme.accent == c ? 2px : 0px;
                            border-color: Theme.text;
                            Rectangle {
                                x: Theme.accent == c ? 4px : 0px;
                                y: Theme.accent == c ? 4px : 0px;
                                width: parent.width - 2 * self.x;
                                height: parent.height - 2 * self.y;
                                border-radius: 2px;
                                background: c;
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { ThemeUi.set-accent(ThemeUi.accent-hexes[i]); } }
                        }
                        TextField { width: 140px; text <=> root.accent-hex; mono: true; placeholder: @tr("#3d9be9"); accepted(t) => { ThemeUi.set-accent(t); } }
                        SecondaryButton { h: 34px; text: @tr("Appliquer"); clicked => { ThemeUi.set-accent(root.accent-hex); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    Row {
                        title: @tr("Densité");
                        description: @tr("Compacte : marges et éléments de navigation réduits.");
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            items: [@tr("Confortable"), @tr("Compacte")];
                            selected: ThemeUi.density;
                            activated(i) => { ThemeUi.set-density(i); }
                        }
                    }
                    Row {
                        title: @tr("Mouvement");
                        description: @tr("Réduit : fondus courts, sans glissement. Aucun : interface instantanée (recommandé si les animations gênent).");
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            items: [@tr("Complet"), @tr("Réduit"), @tr("Aucun")];
                            selected: ThemeUi.motion;
                            activated(i) => { ThemeUi.set-motion(i); }
                        }
                    }
                    Row {
                        title: @tr("Taille du texte");
                        description: @tr("Agrandit tous les textes de l'interface (accessibilité).");
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            items: ["90 %", "100 %", "115 %", "130 %"];
                            selected: ThemeUi.text-scale < 0.95 ? 0 : ThemeUi.text-scale < 1.07 ? 1 : ThemeUi.text-scale < 1.2 ? 2 : 3;
                            activated(i) => { ThemeUi.set-text-scale(i == 0 ? 0.9 : i == 1 ? 1.0 : i == 2 ? 1.15 : 1.3); }
                        }
                    }
                }
            }

            SectionTitle { text: @tr("Interface"); }
            Panel {
                VerticalLayout {
                    padding: 22px;
                    spacing: 18px;
                    Row {
                        title: @tr("Mode d'affichage");
                        description: @tr("Minimaliste : menu en icônes seules, accueil réduit aux favoris et récents. Cinéma : sans menu, illustrations plein cadre. Bouton de la barre supérieure pour basculer.");
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            items: [@tr("Standard"), @tr("Minimaliste"), @tr("Cinéma")];
                            selected: AppUi.ui-mode;
                            activated(i) => { AppUi.set-ui-mode(i); }
                        }
                    }
                    Row {
                        title: @tr("Menu : icônes seules");
                        description: @tr("Masque les libellés sous les icônes du menu de gauche. Automatique en mode minimaliste et dans une fenêtre peu haute.");
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: AppUi.sidebar-collapsed;
                            toggled(v) => { AppUi.sidebar-collapsed = v; AppUi.sidebar-changed(v); }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    Row {
                        title: @tr("Mode Performance");
                        description: @tr("Coupe animations et effets, suspend les téléchargements de visuels et la vérification des mises à jour. Aucun programme ni service n'est fermé.");
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: AppUi.performance && !AppUi.performance-auto;
                            toggled(v) => { AppUi.set-performance(v); }
                        }
                    }
                    Row {
                        title: @tr("Automatique pendant les parties");
                        description: @tr("Active le mode Performance au lancement d'un jeu depuis Halcyon et rétablit tout à la fermeture du jeu.");
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: ThemeUi.performance-auto;
                            toggled(v) => { ThemeUi.set-performance-auto(v); }
                        }
                    }
                }
            }

            SectionTitle { text: @tr("Fond d'écran"); }
            Panel {
                VerticalLayout {
                    padding: 22px;
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 8px;
                        TextField { text <=> root.bg-path; mono: true; placeholder: @tr("Image (.jpg, .png, .webp) affichée en fond, assombrie"); }
                        if AppUi.can-browse: SecondaryButton {
                            text: @tr("Parcourir…");
                            h: 36px;
                            clicked => {
                                let p = AppUi.browse-file();
                                if (p != "") { root.bg-path = p; ThemeUi.set-background(root.bg-path); }
                            }
                        }
                        SecondaryButton { h: 36px; text: @tr("Appliquer"); clicked => { ThemeUi.set-background(root.bg-path); } }
                        if ThemeUi.background != "": SecondaryButton { h: 36px; text: @tr("Retirer"); clicked => { root.bg-path = ""; ThemeUi.set-background(""); } }
                    }
                    if ThemeUi.background != "": Row {
                        title: @tr("Intensité du fond");
                        description: round(ThemeUi.background-opacity * 100) + " %";
                        HorizontalLayout {
                            spacing: 6px;
                            for v in [0.08, 0.15, 0.25, 0.4]: Chip {
                                y: (parent.height - self.height) / 2;
                                text: round(v * 100) + " %";
                                checked: abs(ThemeUi.background-opacity - v) < 0.01;
                                toggled => { ThemeUi.set-background-opacity(v); }
                            }
                        }
                    }
                    Row {
                        title: @tr("Fond animé");
                        description: @tr("Lueur colorée lente derrière l'interface. Désactivé par défaut : il redessine l'écran en continu (jamais pendant une partie lancée par Halcyon).");
                        Toggle { y: (parent.height - self.height) / 2; checked: ThemeUi.animated-background; toggled(v) => { ThemeUi.set-animated(v); } }
                    }
                }
            }

            HorizontalLayout {
                spacing: 22px;
                Panel {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 10px;
                        alignment: start;
                        SectionTitle { text: @tr("Entrées affichées"); }
                        Text { text: @tr("Onglets des espaces Activité et Outils, et bouton Console du menu : gardez seulement ce que vous utilisez."); color: Theme.text-dim; font-size: Theme.t-caption; }
                        for n in ThemeUi.nav-items: HorizontalLayout {
                            height: 34px;
                            Text { text: n.label; color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; horizontal-stretch: 1; }
                            Toggle { y: (parent.height - self.height) / 2; checked: n.visible; toggled => { ThemeUi.toggle-nav(n.key); } }
                        }
                    }
                }
                Panel {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 10px;
                        alignment: start;
                        SectionTitle { text: @tr("Accueil"); }
                        Text { text: @tr("Widgets de l'accueil : ordre et affichage. Taille et disposition : bouton crayon de l'accueil."); color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
                        for sec[i] in ThemeUi.sections: HorizontalLayout {
                            height: 34px;
                            spacing: 4px;
                            Text { text: sec.label; color: sec.visible ? Theme.text : Theme.text-dim; font-size: Theme.t-small; vertical-alignment: center; horizontal-stretch: 1; }
                            IconButton { size: 30px; icon-size: 15px; icon: Icons.chevron-up; tooltip: @tr("Monter"); clicked => { ThemeUi.move-section(i, -1); } }
                            IconButton { size: 30px; icon-size: 15px; icon: Icons.chevron-down; tooltip: @tr("Descendre"); clicked => { ThemeUi.move-section(i, 1); } }
                            Toggle { y: (parent.height - self.height) / 2; checked: sec.visible; toggled => { ThemeUi.toggle-section(i); } }
                        }
                    }
                }
            }

            SectionTitle { text: @tr("Profils d'interface"); }
            Panel {
                VerticalLayout {
                    padding: 22px;
                    spacing: 12px;
                    Text { text: @tr("Enregistrez l'apparence actuelle (thème, couleurs, densité, animations, fond, menu, accueil) sous un nom, puis basculez d'un profil à l'autre : « Bureau », « Salon », « Portable sur batterie »… Le mode Performance en cours n'est pas modifié."); color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
                    for name[i] in ThemeUi.ui-profiles: HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        Text { text: name; color: Theme.text; font-size: Theme.t-small; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        SecondaryButton { y: 3px; h: 34px; text: @tr("Appliquer"); clicked => { ThemeUi.apply-profile(i); } }
                        IconButton { y: 3px; icon: Icons.trash; active-tint: Theme.danger; tooltip: @tr("Supprimer le profil"); clicked => { ThemeUi.delete-profile(i); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        TextField { text <=> root.profile-name; placeholder: @tr("Nom du profil (ex. Salon)"); }
                        PrimaryButton { h: 36px; text: @tr("Enregistrer l'apparence actuelle"); enabled: root.profile-name != ""; clicked => { ThemeUi.save-profile(root.profile-name); root.profile-name = ""; } }
                    }
                }
            }

            SectionTitle { text: @tr("Importer ou exporter un thème"); }
            Panel {
                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    Text { text: @tr("Un thème est un petit fichier JSON (couleurs). Les extensions peuvent aussi en fournir."); color: Theme.text-dim; font-size: Theme.t-caption; }
                    HorizontalLayout {
                        spacing: 8px;
                        TextField { text <=> root.import-path; mono: true; placeholder: @tr("Fichier de thème .json"); }
                        if AppUi.can-browse: SecondaryButton {
                            text: @tr("Parcourir…");
                            h: 36px;
                            clicked => {
                                let p = AppUi.browse-file();
                                if (p != "") { root.import-path = p; }
                            }
                        }
                        SecondaryButton { h: 36px; text: @tr("Importer"); enabled: root.import-path != ""; clicked => { ThemeUi.import-theme(root.import-path); root.import-path = ""; } }
                        PrimaryButton { h: 36px; text: @tr("Exporter le thème actuel"); icon: Icons.upload; has-icon: true; clicked => { ThemeUi.export-theme(); } }
                    }
                    if ThemeUi.status != "": Text { text: ThemeUi.status; color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; }
                }
            }
        }
    }
}
