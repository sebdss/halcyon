import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { EmulatorRow, PlatformRow, PlatformChoice } from "../types.slint";
import { EmuUi, AppUi, Actions } from "../state.slint";
import { Panel, PrimaryButton, SecondaryButton, IconButton, SectionTitle, Icon, Badge, TextField, Toggle, Dropdown, ListItem, Rubric } from "../components.slint";

component EmulatorCard inherits ListItem {
    active: root.emu.detected;
    in property <EmulatorRow> emu;
    in-out property <string> path: emu.path-override;
    in-out property <string> args: emu.extra-args;
    in-out property <bool> expanded;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                background: root.emu.detected ? Theme.success : Theme.text-dim;
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: root.emu.name; color: Theme.text; font-size: Theme.t-body + 1px; font-weight: 700; }
                    if root.emu.custom: Badge { text: @tr("Ajouté par vous"); tint: Theme.accent; }
                }
                Text {
                    text: root.emu.detected ? root.emu.path + ", " + root.emu.via : @tr("Non détecté : indiquez son exécutable s'il est installé ailleurs");
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                    overflow: elide;
                }
            }
            Text {
                width: min(self.preferred-width, 300px);
                text: root.emu.platforms;
                color: Theme.text-muted;
                font-size: Theme.t-caption;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
            IconButton {
                icon: Icons.settings;
                icon-size: 16px;
                active: root.expanded;
                tooltip: @tr("Configurer");
                clicked => { root.expanded = !root.expanded; }
            }
        }
        if root.expanded: VerticalLayout {
            spacing: 12px;
            Text { text: @tr("Exécutable (laisser vide pour la détection automatique)"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
            HorizontalLayout {
                spacing: 8px;
                TextField { text <=> root.path; mono: true; placeholder: @tr("Chemin de l'émulateur"); }
                if AppUi.can-browse: SecondaryButton {
                    text: @tr("Parcourir…");
                    h: 36px;
                    clicked => {
                        let p = AppUi.browse-file();
                        if (p != "") { root.path = p; }
                    }
                }
                SecondaryButton { text: @tr("Appliquer"); h: 36px; clicked => { EmuUi.set-path(root.emu.id, root.path); } }
            }
            Text { text: @tr("Arguments supplémentaires (profil)"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
            HorizontalLayout {
                spacing: 8px;
                TextField { text <=> root.args; mono: true; placeholder: @tr("Ajoutés avant les arguments de lancement"); }
                SecondaryButton { text: @tr("Appliquer"); h: 36px; clicked => { EmuUi.set-args(root.emu.id, root.args); } }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: @tr("Lancer en plein écran"); color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; horizontal-stretch: 1; }
                Toggle {
                    checked: root.emu.fullscreen;
                    toggled(v) => { EmuUi.set-fullscreen(root.emu.id, v); }
                }
            }
            if root.emu.custom: HorizontalLayout {
                spacing: 8px;
                alignment: end;
                SecondaryButton { text: @tr("Modifier"); icon: Icons.settings; has-icon: true; h: 36px; clicked => { EmuUi.open-form(root.emu.id); } }
                SecondaryButton { text: @tr("Supprimer"); icon: Icons.trash; has-icon: true; danger: true; h: 36px; clicked => { EmuUi.delete-emulator(root.emu.id); } }
            }
        }
    }
}

component PlatformCard inherits ListItem {
    in property <PlatformRow> platform;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            Badge { y: (parent.height - self.height) / 2; text: root.platform.short; tint: Theme.accent; solid: true; }
            Text { text: root.platform.name; color: Theme.text; font-size: Theme.t-body; font-weight: 700; vertical-alignment: center; }
            if root.platform.ra: Badge { y: (parent.height - self.height) / 2; text: "RetroAchievements"; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: @tr("{n} jeu" | "{n} jeux" % root.platform.games); color: Theme.text-dim; font-size: Theme.t-caption; vertical-alignment: center; }
            Dropdown {
                prefix: @tr("Émulateur :");
                options: root.platform.emulators;
                selected: root.platform.selected;
                changed(i) => { EmuUi.set-default(root.platform.id, i); }
            }
        }
        for f[i] in root.platform.folders: HorizontalLayout {
            spacing: 10px;
            Icon { source: Icons.folder; size: 16px; tint: Theme.text-muted; y: (parent.height - self.height) / 2; }
            Text { text: f; color: Theme.text-muted; font-size: Theme.t-caption; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            IconButton {
                size: 30px;
                icon: Icons.trash;
                icon-size: 15px;
                active-tint: Theme.danger;
                tooltip: @tr("Retirer ce dossier");
                clicked => { EmuUi.remove-folder(root.platform.id, i); }
            }
        }
    }
}

/// Ajout ou modification d'un émulateur (enregistré en JSON dans le dossier des données).
component EmulatorForm inherits Panel {
    property <string> new-platform-name;
    property <string> new-platform-exts;
    property <bool> adding-platform;
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            Text { text: EmuUi.form-id == "" ? @tr("Ajouter un émulateur") : @tr("Modifier l'émulateur"); color: Theme.text; font-family: Theme.display; font-size: Theme.t-heading; font-weight: 700; horizontal-stretch: 1; }
            IconButton { icon: Icons.close; icon-size: 16px; tooltip: @tr("Fermer"); clicked => { EmuUi.form-open = false; } }
        }
        Text { text: @tr("Nom"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        TextField { text <=> EmuUi.form-name; placeholder: @tr("Ex. xemu, Vita3K, Xenia…"); }
        Text { text: @tr("Exécutable"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        HorizontalLayout {
            spacing: 8px;
            TextField { text <=> EmuUi.form-exe; mono: true; placeholder: @tr("Chemin complet du programme de l'émulateur"); }
            if AppUi.can-browse: SecondaryButton {
                text: @tr("Parcourir…");
                h: 36px;
                clicked => {
                    let p = AppUi.browse-file();
                    if (p != "") { EmuUi.form-exe = p; }
                }
            }
        }
        Text { text: @tr("Plateformes prises en charge"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        VerticalLayout {
            chips := VerticalLayout {
                spacing: 6px;
                for row[r] in ceil(EmuUi.form-platforms.length / 4): HorizontalLayout {
                    spacing: 6px;
                    for c in 4: Rectangle {
                        property <int> idx: r * 4 + c;
                        property <bool> exists: idx < EmuUi.form-platforms.length;
                        property <bool> on: exists && EmuUi.form-platforms[idx].checked;
                        horizontal-stretch: 1;
                        height: 32px;
                        border-radius: Theme.radius;
                        background: !exists ? transparent : on ? Theme.accent-soft : ta.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: exists ? 1px : 0px;
                        border-color: on ? Theme.accent : Theme.border;
                        if exists: HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            if on: Icon { source: Icons.check; size: 13px; tint: Theme.accent; y: (parent.height - self.height) / 2; }
                            Text { text: EmuUi.form-platforms[idx].name; color: on ? Theme.text : Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; overflow: elide; }
                        }
                        ta := TouchArea {
                            enabled: exists;
                            mouse-cursor: pointer;
                            clicked => { EmuUi.toggle-platform(idx, !on); }
                        }
                    }
                }
            }
        }
        if !root.adding-platform: HorizontalLayout {
            alignment: start;
            SecondaryButton { text: @tr("Plateforme absente de la liste ?"); icon: Icons.plus; has-icon: true; h: 34px; clicked => { root.adding-platform = true; } }
        }
        if root.adding-platform: HorizontalLayout {
            spacing: 8px;
            TextField { text <=> root.new-platform-name; placeholder: @tr("Nom (ex. Xbox)"); }
            TextField { text <=> root.new-platform-exts; mono: true; placeholder: @tr("Extensions des jeux (ex. iso, xiso)"); }
            SecondaryButton {
                text: @tr("Ajouter la plateforme");
                h: 36px;
                clicked => {
                    EmuUi.add-platform(root.new-platform-name, root.new-platform-exts);
                    root.new-platform-name = "";
                    root.new-platform-exts = "";
                    root.adding-platform = false;
                }
            }
        }
        Text { text: @tr("Arguments de lancement"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        TextField { text <=> EmuUi.form-args; mono: true; placeholder: "{rom}"; }
        Text {
            text: @tr("{{rom}} : chemin du jeu, {{rom_dir}} : son dossier, {{rom_name}} : son nom sans extension, {{emu_dir}} : dossier de l'émulateur. Les chemins avec des espaces sont gérés : inutile d'ajouter des guillemets.");
            color: Theme.text-dim;
            font-size: Theme.t-caption;
            wrap: word-wrap;
        }
        Text { text: @tr("Arguments du plein écran (facultatif)"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        TextField { text <=> EmuUi.form-fs-args; mono: true; placeholder: @tr("Ex. -fullscreen"); }
        if EmuUi.form-error != "": Text { text: EmuUi.form-error; color: Theme.danger; font-size: Theme.t-small; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            SecondaryButton { text: @tr("Annuler"); clicked => { EmuUi.form-open = false; } }
            PrimaryButton { text: @tr("Enregistrer"); icon: Icons.check; has-icon: true; clicked => { EmuUi.save-form(); } }
        }
    }
}

export component EmulatorsPage inherits Rectangle {
    property <int> new-platform;
    property <string> new-folder;

    ScrollView {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.width;
            padding: Theme.page-padding;
            padding-top: 24px;
            spacing: 18px;
            alignment: start;

            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: @tr("{n} émulateur détecté" | "{n} émulateurs détectés" % EmuUi.detected-count) + ", " + @tr("{n} jeu émulé" | "{n} jeux émulés" % EmuUi.rom-count);
                    color: Theme.text-muted;
                    font-size: Theme.t-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                SecondaryButton {
                    text: @tr("Ajouter un émulateur");
                    icon: Icons.plus;
                    has-icon: true;
                    clicked => { EmuUi.open-form(""); }
                }
                SecondaryButton {
                    text: @tr("Redétecter");
                    icon: Icons.refresh;
                    has-icon: true;
                    clicked => { EmuUi.redetect(); }
                }
                PrimaryButton {
                    text: AppUi.scanning ? @tr("Analyse…") : @tr("Importer les ROM");
                    enabled: !AppUi.scanning;
                    clicked => { Actions.rescan(); }
                }
            }

            Text {
                text: @tr("Halcyon ne fournit ni ROM, ni BIOS, ni fichier protégé : utilisez vos propres sauvegardes. Un émulateur absent de la liste s'ajoute avec « Ajouter un émulateur » ; les définitions sont enregistrées dans {}.", EmuUi.defs-dir);
                color: Theme.text-dim;
                font-size: Theme.t-caption;
                wrap: word-wrap;
            }

            if EmuUi.form-open: EmulatorForm { }

            Rubric { title: @tr("Bibliothèques de ROM"); }
            Panel {
                HorizontalLayout {
                    padding: 18px;
                    spacing: 8px;
                    Dropdown {
                        prefix: @tr("Plateforme :");
                        options: EmuUi.platform-labels;
                        selected <=> root.new-platform;
                    }
                    TextField { text <=> root.new-folder; mono: true; placeholder: @tr("Dossier contenant les ROM de cette plateforme"); }
                    if AppUi.can-browse: SecondaryButton {
                        text: @tr("Parcourir…");
                        h: 36px;
                        clicked => {
                            let p = AppUi.browse-folder();
                            if (p != "") { root.new-folder = p; }
                        }
                    }
                    PrimaryButton {
                        text: @tr("Ajouter");
                        icon: Icons.plus;
                        has-icon: true;
                        h: 36px;
                        enabled: root.new-folder != "";
                        clicked => {
                            EmuUi.add-folder(root.new-platform, root.new-folder);
                            root.new-folder = "";
                        }
                    }
                }
            }
            for p in EmuUi.platforms: PlatformCard { platform: p; }

            Rubric { title: @tr("Émulateurs"); }
            for e in EmuUi.emulators: EmulatorCard { emu: e; }
        }
    }
}
