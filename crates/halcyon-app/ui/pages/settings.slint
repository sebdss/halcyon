import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { SourceInfo } from "../types.slint";
import { SettingsUi, AppUi, Actions, SystemUi } from "../state.slint";
import { Panel, Toggle, TextField, SecondaryButton, PrimaryButton, IconButton, Badge, Icon, SectionTitle, Chip, Dropdown, ValueSlider, Segmented, ProgressBar, Notice, TextButton } from "../components.slint";
import { HusUi } from "../hus_state.slint";

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 20px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.t-body;
            font-weight: 500;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            color: Theme.text-dim;
            font-size: Theme.t-caption;
            wrap: word-wrap;
        }
    }
    @children
}

/// Champ texte enregistré à la validation (Entrée ou bouton).
component TextSetting inherits VerticalLayout {
    in property <string> key;
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> secret;
    in-out property <string> value;
    spacing: 6px;
    Text { text: root.label; color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
    HorizontalLayout {
        spacing: 8px;
        TextField {
            text <=> root.value;
            mono: true;
            placeholder: root.placeholder;
            accepted(t) => { SettingsUi.set-text(root.key, t); }
        }
        SecondaryButton { text: @tr("Enregistrer"); h: 36px; clicked => { SettingsUi.set-text(root.key, root.value); } }
    }
    if root.hint != "": Text { text: root.hint; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
}

/// Raccourci modifiable : cliquer puis appuyer sur la nouvelle combinaison.
component ShortcutEditor inherits HorizontalLayout {
    in property <string> action;
    in property <string> label;
    in property <string> combo;
    in property <string> default-combo;
    property <bool> capturing;
    height: 40px;
    spacing: 10px;
    Text { text: root.label; color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; horizontal-stretch: 1; }
    if root.combo != root.default-combo: Text { text: @tr("défaut : {}", root.default-combo); color: Theme.text-dim; font-size: Theme.t-overline; vertical-alignment: center; }
    Rectangle {
        width: 170px;
        border-radius: Theme.radius-sm;
        background: root.capturing ? Theme.accent-soft : Theme.surface-hover;
        border-width: 1px;
        border-color: root.capturing ? Theme.accent : Theme.border;
        Text {
            text: root.capturing ? @tr("Appuyez sur les touches…") : root.combo == "" ? @tr("Aucun") : root.combo;
            color: root.capturing ? Theme.accent : Theme.text;
            font-size: Theme.t-small;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        cap := FocusScope {
            TouchArea { mouse-cursor: pointer; clicked => { root.capturing = true; cap.focus(); } }
            focus-changed-event => { if (!self.has-focus) { root.capturing = false; } }
            key-pressed(event) => {
                if (!root.capturing) {
                    return reject;
                }
                if (event.text == Key.Escape) {
                    root.capturing = false;
                    return accept;
                }
                if (event.text == Key.Backspace || event.text == Key.Delete) {
                    root.capturing = false;
                    SystemUi.set-shortcut(root.action, "");
                    return accept;
                }
                let c = SystemUi.combo-of(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                // Une touche de modification seule : on attend la suite.
                if (c == "") {
                    return accept;
                }
                root.capturing = false;
                SystemUi.set-shortcut(root.action, c);
                accept
            }
        }
    }
}

component ExportPanel inherits Panel {
    in-out property <bool> secrets;
    in-out property <bool> mod-files;
    in-out property <string> import-path;
    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        Text {
            text: @tr("Une archive unique contient la bibliothèque, vos métadonnées et visuels personnalisés, collections, profils de lancement, réglages des émulateurs, paramètres, thèmes, extensions et statistiques. Les fichiers des jeux ne sont jamais inclus. Idéal pour migrer vers un autre PC.");
            color: Theme.text-dim;
            font-size: Theme.t-caption;
            wrap: word-wrap;
        }
        SettingRow {
            title: @tr("Inclure les clés d'API");
            description: @tr("Désactivé par défaut : l'archive peut alors être partagée sans exposer vos comptes.");
            Toggle { y: (parent.height - self.height) / 2; checked <=> root.secrets; }
        }
        SettingRow {
            title: @tr("Inclure les fichiers des mods");
            description: @tr("Sinon, seules les fiches des mods et les profils sont exportés.");
            Toggle { y: (parent.height - self.height) / 2; checked <=> root.mod-files; }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 10px;
            PrimaryButton { text: @tr("Exporter maintenant"); icon: Icons.upload; has-icon: true; clicked => { SettingsUi.export-config(root.secrets, root.mod-files); } }
            SecondaryButton { text: @tr("Ouvrir le dossier des exports"); clicked => { Actions.open-folder(SettingsUi.backups-dir); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        Text { text: @tr("Restaurer une archive"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        HorizontalLayout {
            spacing: 8px;
            TextField { text <=> root.import-path; mono: true; placeholder: @tr("Chemin de l'archive .zip"); }
            if AppUi.can-browse: SecondaryButton {
                text: @tr("Parcourir…");
                h: 36px;
                clicked => {
                    let p = AppUi.browse-file();
                    if (p != "") { root.import-path = p; }
                }
            }
            SecondaryButton { text: @tr("Restaurer…"); h: 36px; enabled: root.import-path != ""; clicked => { SettingsUi.import-config(root.import-path); } }
        }
        if SettingsUi.backup-status != "": Text { text: SettingsUi.backup-status; color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; }
    }
}

component SourcePanel inherits Panel {
    in property <SourceInfo> info;
    in property <string> key;
    in property <string> path-label;
    in-out property <string> path: info.path-override;

    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        SettingRow {
            title: root.info.name;
            description: !root.info.enabled ? @tr("Désactivé") : root.info.found
                ? @tr("Détecté : {}, {n} jeu" | "Détecté : {}, {n} jeux" % root.info.count, root.info.detected)
                : @tr("Introuvable sur cet ordinateur. Indiquez son dossier ci-dessous si nécessaire.");
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: root.info.enabled;
                toggled(v) => { SettingsUi.set-source-enabled(root.key, v); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            TextField {
                text <=> root.path;
                mono: true;
                placeholder: root.path-label;
                accepted(t) => { SettingsUi.set-source-path(root.key, t); }
            }
            if AppUi.can-browse: SecondaryButton {
                text: @tr("Parcourir…");
                h: 36px;
                clicked => {
                    let p = AppUi.browse-folder();
                    if (p != "") {
                        root.path = p;
                        SettingsUi.set-source-path(root.key, root.path);
                    }
                }
            }
            SecondaryButton {
                text: @tr("Appliquer");
                h: 36px;
                clicked => { SettingsUi.set-source-path(root.key, root.path); }
            }
        }
    }
}

/// État des mises à jour : version installée et disponible, progression réelle, actions.
component UpdateStatusPanel inherits Panel {
    property <bool> busy: HusUi.checking || HusUi.downloading || HusUi.state == 5;
    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius;
                background: HusUi.error ? Theme.danger.with-alpha(0.14) : HusUi.latest != "" ? Theme.warm.with-alpha(0.14) : Theme.accent.with-alpha(0.14);
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: HusUi.error ? Icons.alert : HusUi.latest != "" ? Icons.download : Icons.check;
                    size: 20px;
                    tint: HusUi.error ? Theme.danger : HusUi.latest != "" ? Theme.warm : Theme.accent;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: HusUi.status; color: Theme.text; font-family: Theme.display; font-size: Theme.t-heading - 2px; font-weight: 700; wrap: word-wrap; }
                if HusUi.detail != "": Text { text: HusUi.detail; color: HusUi.error ? Theme.danger : Theme.text-muted; font-size: Theme.t-small; wrap: word-wrap; }
            }
            if HusUi.security: Badge { y: 12px; text: @tr("Sécurité"); tint: Theme.warm; solid: true; }
        }
        HorizontalLayout {
            spacing: 32px;
            alignment: start;
            for kv in [
                { label: @tr("Version installée"), value: HusUi.installed },
                { label: @tr("Dernière version"), value: HusUi.latest != "" ? HusUi.latest : HusUi.state == 2 ? HusUi.installed : "—" },
                { label: @tr("Canal"), value: HusUi.channel == 1 ? @tr("Beta") : @tr("Stable") },
                { label: @tr("Dernière recherche"), value: HusUi.last-check },
            ]: VerticalLayout {
                spacing: 2px;
                Text { text: kv.value; color: Theme.text; font-family: Theme.display; font-size: Theme.t-small; font-weight: 700; }
                Text { text: kv.label; color: Theme.text-dim; font-size: Theme.t-caption; }
            }
        }
        if HusUi.downloading || HusUi.state == 5: VerticalLayout {
            spacing: 8px;
            ProgressBar { value: HusUi.state == 5 ? -1 : HusUi.progress; }
            Text {
                text: HusUi.state == 5
                    ? @tr("Vérification de la signature, de l'empreinte SHA-256 et du paquet…")
                    : HusUi.progress-text + (HusUi.size-text != "" ? ", " + HusUi.size-text : "") + (HusUi.speed != "" ? ", " + HusUi.speed : "") + (HusUi.eta != "" ? ", " + HusUi.eta : "");
                color: Theme.text-muted;
                font-size: Theme.t-small;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            SecondaryButton {
                text: HusUi.checking ? @tr("Recherche…") : @tr("Rechercher des mises à jour");
                icon: Icons.refresh;
                has-icon: true;
                enabled: !root.busy;
                clicked => { HusUi.check(); }
            }
            if HusUi.can-download: PrimaryButton { text: @tr("Télécharger {}", HusUi.latest); icon: Icons.download; has-icon: true; clicked => { HusUi.download(); } }
            if HusUi.downloading: SecondaryButton { text: @tr("Annuler"); icon: Icons.close; has-icon: true; clicked => { HusUi.cancel(); } }
            if HusUi.staged: PrimaryButton { text: @tr("Installer et redémarrer"); icon: Icons.check; has-icon: true; clicked => { HusUi.install-now(); } }
            if HusUi.staged && !HusUi.at-restart: SecondaryButton { text: @tr("Installer au prochain démarrage"); icon: Icons.clock; has-icon: true; clicked => { HusUi.install-at-restart(); } }
            if HusUi.release-url != "": SecondaryButton { text: @tr("Page de la version"); icon: Icons.external; has-icon: true; clicked => { HusUi.open-release(); } }
        }
        if HusUi.staged && HusUi.at-restart: Text { text: @tr("Installation prévue au prochain démarrage de Halcyon."); color: Theme.text-muted; font-size: Theme.t-caption; }
    }
}

/// Catégorie de la colonne de navigation des paramètres.
component CategoryItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    callback clicked;
    // Une ligne d'ordinaire ; deux si le nom de la section est long (selon la langue).
    height: max(34px, label.preferred-height + 14px);
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.surface : transparent;
    border-width: fs.has-focus ? Theme.focus-width : 0px;
    border-color: Theme.focus;
    accessible-role: tab;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;
    if root.active: Rectangle { x: 0; y: 8px; width: Theme.perch; height: parent.height - 16px; background: Theme.accent; }
    Icon { x: 12px; y: (parent.height - 16px) / 2; height: 16px; source: root.icon; size: 16px; tint: root.active ? Theme.accent : Theme.text-dim; }
    label := Text {
        x: 40px;
        width: parent.width - 50px;
        text: root.text;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: Theme.t-small;
        font-weight: root.active ? 650 : 500;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
}

export component SettingsPage inherits Rectangle {
    // Clés d'API repliées : ouvertes d'office si l'une est déjà renseignée.
    property <bool> advanced-open: SettingsUi.steam-key != "" || SettingsUi.steamgriddb-key != "" || SettingsUi.nexus-key != "";
    property <string> new-folder;
    property <bool> two-pane: root.width > 940px;
    property <length> nav-width: root.two-pane ? 252px : 0px;
    // Index de catégorie (-1 : tous les réglages), dans l'ordre de `SettingsUi.shown`.
    property <[string]> names: [@tr("Plateformes"), @tr("Dossiers"), @tr("Comptes et succès"), @tr("Comportement"), @tr("Hors ligne"), @tr("Système"), @tr("Raccourcis"), @tr("Configuration"), @tr("Mises à jour"), @tr("Stockage et diagnostic"), @tr("Son"), @tr("Langue")];
    property <[image]> icons: [Icons.gamepad, Icons.folder, Icons.user, Icons.sliders, Icons.cloud, Icons.monitor, Icons.keyboard, Icons.save, Icons.download, Icons.drive, Icons.bell, Icons.globe];
    init => { SettingsUi.search-changed(SettingsUi.search); }

    // Colonne des catégories : recherche, puis une catégorie à la fois.
    if root.two-pane: Rectangle {
        x: 0;
        y: 0;
        width: root.nav-width;
        height: root.height;
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        VerticalLayout {
            padding-left: Theme.page-padding - 12px;
            padding-right: 16px;
            padding-top: 28px;
            spacing: 2px;
            alignment: start;
            TextField {
                placeholder: @tr("Rechercher un réglage");
                icon: Icons.search;
                has-icon: true;
                text <=> SettingsUi.search;
                edited(t) => { SettingsUi.search-changed(t); }
            }
            Rectangle { height: 16px; }
            for name[i] in root.names: CategoryItem {
                text: name;
                icon: root.icons[i];
                active: SettingsUi.search == "" && SettingsUi.section == i;
                clicked => { SettingsUi.search = ""; SettingsUi.section = i; SettingsUi.search-changed(""); sv.content-y = 0; }
            }
            Rectangle { height: 8px; }
            CategoryItem {
                text: @tr("Tous les réglages");
                icon: Icons.list;
                active: SettingsUi.search == "" && SettingsUi.section == -1;
                clicked => { SettingsUi.search = ""; SettingsUi.section = -1; SettingsUi.search-changed(""); sv.content-y = 0; }
            }
        }
    }

    sv := ScrollView {
        x: root.nav-width;
        width: root.width - root.nav-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: sv.width;
            // Colonne de lecture bornée : les réglages ne s'étirent pas sur tout l'écran.
            padding: Theme.page-padding;
            padding-left: root.two-pane ? 40px : Theme.page-padding;
            padding-right: max(Theme.page-padding, sv.width - (root.two-pane ? 40px : Theme.page-padding) - 880px);
            padding-top: 28px;
            spacing: 20px;
            alignment: start;

            // Fenêtre étroite : recherche et liste déroulante des catégories.
            if !root.two-pane: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                TextField {
                    width: min(320px, sv.width * 0.45);
                    height: 36px;
                    placeholder: @tr("Rechercher un réglage");
                    icon: Icons.search;
                    has-icon: true;
                    text <=> SettingsUi.search;
                    edited(t) => { SettingsUi.search-changed(t); }
                }
                Dropdown {
                    align-left: true;
                    options: [@tr("Tous les réglages"), @tr("Plateformes"), @tr("Dossiers"), @tr("Comptes et succès"), @tr("Comportement"), @tr("Hors ligne"), @tr("Système"), @tr("Raccourcis"), @tr("Configuration"), @tr("Mises à jour"), @tr("Stockage et diagnostic"), @tr("Son"), @tr("Langue")];
                    selected: SettingsUi.section + 1;
                    changed(i) => { SettingsUi.search = ""; SettingsUi.section = i - 1; SettingsUi.search-changed(""); }
                }
            }
            if SettingsUi.search != "" && SettingsUi.match-count > 0: Text {
                text: @tr("{n} catégorie correspond à « {} »." | "{n} catégories correspondent à « {} »." % SettingsUi.match-count, SettingsUi.search);
                color: Theme.text-muted;
                font-size: Theme.t-small;
            }
            if SettingsUi.search != "" && SettingsUi.match-count == 0: Text {
                text: @tr("Aucun réglage ne correspond à « {} ».", SettingsUi.search);
                color: Theme.text-muted;
                font-size: Theme.t-body;
            }

            if SettingsUi.shown[11]: VerticalLayout {
                spacing: 18px;
                // --- Langue ---
                SectionTitle { text: @tr("Langue"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        SettingRow {
                            title: @tr("Langue de l'interface");
                            description: SettingsUi.language-index != 0
                                ? @tr("Le changement s'applique immédiatement, sans redémarrage.")
                                : SettingsUi.language-fallback
                                    ? @tr("La langue du système ({}) n'est pas encore disponible : Halcyon s'affiche en anglais. Le changement s'applique immédiatement, sans redémarrage.", SettingsUi.language-system)
                                    : @tr("Halcyon suit la langue du système ({}). Le changement s'applique immédiatement, sans redémarrage.", SettingsUi.language-detected);
                            Dropdown {
                                y: (parent.height - self.height) / 2;
                                popup-width: 300px;
                                options: SettingsUi.languages;
                                selected: SettingsUi.language-index;
                                changed(i) => { SettingsUi.set-language(i); }
                            }
                        }
                        Text {
                            text: @tr("Les noms des jeux, les fiches et les actualités venant des boutiques restent dans leur langue d'origine.");
                            color: Theme.text-dim;
                            font-size: Theme.t-small;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if SettingsUi.shown[0]: VerticalLayout {
                spacing: 18px;
                // --- Sources ---
                HorizontalLayout {
                    padding-top: 10px;
                    spacing: 12px;
                    SectionTitle { text: @tr("Plateformes"); }
                    Rectangle { horizontal-stretch: 1; }
                    PrimaryButton {
                        text: AppUi.scanning ? @tr("Analyse en cours…") : @tr("Analyser maintenant");
                        icon: Icons.refresh;
                        has-icon: true;
                        enabled: !AppUi.scanning;
                        h: 36px;
                        font-size: Theme.t-small;
                        clicked => { Actions.rescan(); }
                    }
                }
                SourcePanel {
                    info: SettingsUi.steam;
                    key: "steam";
                    path-label: @tr("Dossier Steam (détection automatique si vide)");
                }
                SourcePanel {
                    info: SettingsUi.epic;
                    key: "epic";
                    path-label: @tr("Dossier des manifestes Epic (détection automatique si vide)");
                }
                SourcePanel {
                    info: SettingsUi.gog;
                    key: "gog";
                    path-label: @tr("Dossier de configuration Heroic (détection automatique si vide)");
                }
                if SettingsUi.launchers.length > 0: Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        Text {
                            text: @tr("Autres launchers");
                            color: Theme.text;
                            font-size: Theme.t-body;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Jeux installés lus sans compte ni configuration. Chaque jeu se lance par son launcher, qui garde la connexion, les mises à jour et la protection anticopie. Temps de jeu mesuré par Halcyon.");
                            color: Theme.text-dim;
                            font-size: Theme.t-caption;
                            wrap: word-wrap;
                        }
                        for l in SettingsUi.launchers: SettingRow {
                            title: l.name;
                            description: !l.enabled ? @tr("Désactivé") : l.found
                                ? @tr("Trouvé, {n} jeu installé" | "Trouvé, {n} jeux installés" % l.count)
                                : @tr("Introuvable sur cet ordinateur");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: l.enabled;
                                toggled(v) => { SettingsUi.set-source-enabled(l.key, v); }
                            }
                        }
                    }
                }
            }

            if SettingsUi.shown[1]: VerticalLayout {
                spacing: 18px;
                // --- Dossiers ---
                SectionTitle { text: @tr("Dossiers de jeux"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 12px;
                        Text {
                            text: @tr("Chaque sous-dossier d'un dossier surveillé est considéré comme un jeu. Halcyon choisit l'exécutable le plus probable ; vous pouvez le corriger depuis la fiche du jeu.");
                            color: Theme.text-dim;
                            font-size: Theme.t-caption;
                            wrap: word-wrap;
                        }
                        for folder[i] in SettingsUi.folders: Rectangle {
                            height: 44px;
                            border-radius: Theme.radius-sm + 2px;
                            background: Theme.bg;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 4px;
                                spacing: 10px;
                                Icon { source: Icons.folder; size: 18px; tint: Theme.text-muted; y: (parent.height - self.height) / 2; }
                                Text {
                                    text: folder;
                                    color: Theme.text;
                                    font-size: Theme.t-small;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.trash;
                                    icon-size: 16px;
                                    active-tint: Theme.danger;
                                    tooltip: @tr("Retirer ce dossier");
                                    clicked => { SettingsUi.remove-folder(i); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                text <=> root.new-folder;
                                mono: true;
                                placeholder: @tr("Chemin d'un dossier, ex. D:\\Jeux");
                                accepted(t) => {
                                    SettingsUi.add-folder(t);
                                    root.new-folder = "";
                                }
                            }
                            if AppUi.can-browse: SecondaryButton {
                                text: @tr("Parcourir…");
                                h: 36px;
                                clicked => {
                                    let p = AppUi.browse-folder();
                                    if (p != "") { SettingsUi.add-folder(p); }
                                }
                            }
                            SecondaryButton {
                                text: @tr("Ajouter");
                                icon: Icons.plus;
                                has-icon: true;
                                h: 36px;
                                clicked => {
                                    SettingsUi.add-folder(root.new-folder);
                                    root.new-folder = "";
                                }
                            }
                        }
                    }
                }
            }

            if SettingsUi.shown[2]: VerticalLayout {
                spacing: 18px;
                // --- Comptes et succès ---
                SectionTitle { text: @tr("Comptes et succès"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        // Ce qui marche sans rien configurer.
                        Notice {
                            text: SettingsUi.steam-local
                                ? @tr("Succès Steam : lus directement dans le client Steam de ce PC (compte {}), sans clé ni configuration. Un jeu apparaît après sa première partie sur ce PC.", SettingsUi.steam-id-detected)
                                : @tr("Succès Steam : aucun compte Steam trouvé sur ce PC. Ouvrez Steam une fois connecté : les succès seront ensuite lus directement, sans clé.");
                            warning: !SettingsUi.steam-local;
                        }
                        Notice {
                            text: @tr("Visuels : Steam, Epic Games et GOG fournissent jaquettes, bannières et logos sans configuration. Pour les jeux standalone, Halcyon cherche le jeu dans la boutique Steam ; pour les jeux émulés, dans libretro-thumbnails (projet RetroArch).");
                        }
                        Text {
                            text: @tr("Les succès Epic Games ne sont pas disponibles : Epic ne propose pas d'API publique.");
                            color: Theme.text-dim;
                            font-size: Theme.t-caption;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            TextSetting { key: "ra_user"; label: @tr("Utilisateur RetroAchievements"); hint: @tr("Pour les succès des jeux émulés."); placeholder: @tr("Pseudo"); value: SettingsUi.ra-user; }
                            TextSetting {
                                key: "ra_api_key";
                                label: @tr("Clé Web API RetroAchievements");
                                hint: @tr("retroachievements.org › Paramètres › Clé Web API.");
                                placeholder: @tr("Clé");
                                value: SettingsUi.ra-key;
                            }
                        }
                        SettingRow {
                            title: @tr("Synchroniser les succès au démarrage");
                            description: @tr("Incrémentale : seuls les jeux non synchronisés depuis 12 h, ou dont Steam a enregistré de nouveaux succès, sont relus.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.sync-on-startup;
                                toggled(v) => { SettingsUi.set-option("sync_achievements_on_startup", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Surveiller les succès pendant une partie");
                            description: @tr("Vérifie le jeu lancé pour vous notifier : Steam toutes les 20 s depuis le disque (2 min en ligne avec une clé), RetroAchievements toutes les 90 s.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.polling;
                                toggled(v) => { SettingsUi.set-option("achievement_polling", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Notifications de succès");
                            description: @tr("Notification système discrète : elle ne prend jamais le focus et n'interrompt pas le jeu.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.notifications;
                                toggled(v) => { SettingsUi.set-option("achievement_notifications", v); }
                            }
                        }
                        // Réglages avancés : clés d'API facultatives.
                        HorizontalLayout {
                            alignment: start;
                            TextButton {
                                text: root.advanced-open ? @tr("Masquer les réglages avancés") : @tr("Réglages avancés : clés d'API facultatives");
                                clicked => { root.advanced-open = !root.advanced-open; }
                            }
                        }
                        if root.advanced-open: VerticalLayout {
                            spacing: 18px;
                            Text {
                                text: @tr("Aucune de ces clés n'est nécessaire. Elles sont stockées uniquement sur cet ordinateur, dans le coffre de Halcyon (chiffré par Windows ; réservé à votre compte sous Linux), jamais dans settings.json.");
                                color: Theme.text-dim;
                                font-size: Theme.t-caption;
                                wrap: word-wrap;
                            }
                            TextSetting {
                                key: "steam_api_key";
                                label: @tr("Clé Steam Web API");
                                hint: @tr("Récupère en ligne les succès des jeux jamais lancés sur ce PC et ajoute les jeux possédés non installés. À créer sur steamcommunity.com/dev/apikey ; les détails de jeu de votre profil Steam doivent être publics.");
                                placeholder: @tr("32 caractères hexadécimaux");
                                value: SettingsUi.steam-key;
                            }
                            TextSetting {
                                key: "steam_id";
                                label: @tr("SteamID64");
                                hint: SettingsUi.steam-id-detected != "" ? @tr("Détecté sur cet ordinateur : {} (laisser vide pour l'utiliser).", SettingsUi.steam-id-detected) : @tr("Aucun compte Steam détecté sur cet ordinateur.");
                                placeholder: "7656119…";
                                value: SettingsUi.steam-id;
                            }
                            TextSetting {
                                key: "steamgriddb_api_key";
                                label: @tr("Clé d'API SteamGridDB");
                                hint: @tr("steamgriddb.com › Préférences › API. Visuels de secours pour les jeux standalone introuvables dans la boutique Steam.");
                                placeholder: @tr("Clé personnelle");
                                value: SettingsUi.steamgriddb-key;
                            }
                            TextSetting {
                                key: "nexus_api_key";
                                label: @tr("Clé d'API Nexus Mods");
                                hint: @tr("nexusmods.com › Mon compte › Accès à l'API. Sert uniquement à vérifier les versions de vos mods.");
                                placeholder: @tr("Clé personnelle");
                                value: SettingsUi.nexus-key;
                            }
                            SettingRow {
                                title: @tr("Statut Discord");
                                description: @tr("« Joue à … » sur votre profil Discord pendant une partie, avec la jaquette du jeu. Passe par Discord ouvert sur ce PC ; son réglage « Partager mon activité » reste maître.");
                                Toggle {
                                    y: (parent.height - self.height) / 2;
                                    checked: SettingsUi.discord-presence;
                                    toggled(v) => { SettingsUi.set-option("discord_presence", v); }
                                }
                            }
                            TextSetting {
                                key: "discord_client_id";
                                label: @tr("Application Discord (facultatif)");
                                hint: @tr("Identifiant d'une application créée sur discord.com/developers, pour afficher un autre nom que « Halcyon ». Vide : celle de Halcyon.");
                                placeholder: @tr("Identifiant numérique");
                                value: SettingsUi.discord-client-id;
                            }
                        }
                    }
                }

                if SettingsUi.is-linux: SectionTitle { text: @tr("Linux"); }
                if SettingsUi.is-linux: Panel {
                    VerticalLayout {
                        padding: 22px;
                        TextSetting {
                            key: "windows_runner";
                            label: @tr("Commande pour les jeux Windows (.exe)");
                            hint: @tr("Exemples : wine, umu-run, flatpak run org.winehq.Wine. Les jeux Steam utilisent Proton via Steam, les jeux Epic via Heroic.");
                            placeholder: "wine";
                            value: SettingsUi.windows-runner;
                        }
                    }
                }
            }

            if SettingsUi.shown[3]: VerticalLayout {
                spacing: 18px;
                // --- Comportement ---
                SectionTitle { text: @tr("Comportement"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 20px;
                        SettingRow {
                            title: @tr("Analyser les sources au démarrage");
                            description: @tr("En arrière-plan : l'interface reste utilisable pendant l'analyse.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.scan-on-startup;
                                toggled(v) => { SettingsUi.set-option("scan_on_startup", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Réduire Halcyon pendant le jeu");
                            description: @tr("Libère le GPU : l'interface ne se redessine pas tant qu'elle est réduite.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.minimize-on-launch;
                                toggled(v) => { SettingsUi.set-option("minimize_on_launch", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Écran de lancement");
                            description: @tr("Bannière et logo du jeu en plein cadre pendant son démarrage. Un clic le referme.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.launch-screen;
                                toggled(v) => { SettingsUi.set-option("launch_screen", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Bannière animée");
                            description: @tr("Sur la fiche d'un jeu, la bannière enchaîne les captures d'écran en fondu, avec un lent travelling. Coupée en mode Performance ; Apparence › Mouvement « Réduit » garde les fondus sans le travelling.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.animated-banner;
                                toggled(v) => { SettingsUi.set-option("animated_banner", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Rappel de pause");
                            description: @tr("Notification pendant une longue partie suivie par Halcyon.");
                            Segmented {
                                y: (parent.height - self.height) / 2;
                                items: [@tr("Jamais"), @tr("1 h"), @tr("2 h"), @tr("3 h")];
                                selected: SettingsUi.break-reminder;
                                activated(i) => { SettingsUi.set-break-reminder(i); }
                            }
                        }
                        SettingRow {
                            title: @tr("Jeux offerts sur l'Epic Games Store");
                            description: @tr("Signale au démarrage les jeux gratuits de la semaine (une fois chacun). Contacte le site d'Epic.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.free-games;
                                toggled(v) => { SettingsUi.set-option("free_games_notifications", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Alerte de disque presque plein");
                            description: @tr("Au plus une fois par jour, quand il reste moins de 10 % ou de 10 Go.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.disk-alerts;
                                toggled(v) => { SettingsUi.set-option("disk_alerts", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Démarrer en mode Big Picture");
                            description: @tr("Plein écran, navigation à la manette. Start ou F11 pour en sortir.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.start-big-picture;
                                toggled(v) => { SettingsUi.set-option("start_in_big_picture", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Métadonnées en ligne");
                            description: @tr("Descriptions, genres et captures d'écran depuis la boutique Steam (vos modifications restent prioritaires).");
                            Badge { y: (parent.height - self.height) / 2; text: @tr("En ligne"); tint: Theme.warm; solid: true; }
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.online-metadata;
                                toggled(v) => { SettingsUi.set-option("online_metadata", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Télécharger les visuels manquants");
                            description: @tr("Nécessite Internet. Jaquettes et bannières sont ensuite conservées hors ligne.");
                            Badge { y: (parent.height - self.height) / 2; text: @tr("En ligne"); tint: Theme.warm; solid: true; }
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.online-artwork;
                                toggled(v) => { SettingsUi.set-option("online_artwork", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Boîtiers en 3D (mode console)");
                            description: @tr("Étagère, musée et Inspecter en vraie 3D : perspective, lumière, reflets, boîtiers qui se tournent et s'ouvrent. Sans carte graphique compatible (OpenGL 3), en rendu logiciel ou en mode Performance, Halcyon garde l'affichage 2,5D.");
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.console-3d;
                                toggled(v) => { SettingsUi.set-option("console_3d", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Dos et tranches de boîtiers (LaunchBox)");
                            description: @tr("Mode console : les vrais dos et tranches des boîtiers quand ils existent (surtout jeux console et éditions en boîte). Télécharge une fois la base LaunchBox (environ 110 Mo) et n'en garde qu'un petit index ; les images viennent de images.launchbox-app.com.");
                            Badge { y: (parent.height - self.height) / 2; text: @tr("En ligne"); tint: Theme.warm; solid: true; }
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.launchbox-art;
                                toggled(v) => { SettingsUi.launchbox(v ? "on" : "off"); }
                            }
                        }
                        if SettingsUi.launchbox-art || SettingsUi.launchbox-busy: HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Text {
                                text: SettingsUi.launchbox-status;
                                color: Theme.text-dim;
                                font-size: Theme.t-caption;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            if SettingsUi.launchbox-ready && !SettingsUi.launchbox-busy: SecondaryButton { text: @tr("Récupérer pour toute la bibliothèque"); clicked => { SettingsUi.launchbox("fetch-all"); } }
                            if !SettingsUi.launchbox-busy: SecondaryButton { text: SettingsUi.launchbox-ready ? @tr("Mettre à jour l'index") : @tr("Télécharger la base"); clicked => { SettingsUi.launchbox("build"); } }
                            if SettingsUi.launchbox-busy: SecondaryButton { text: @tr("Annuler"); clicked => { SettingsUi.launchbox("cancel"); } }
                        }
                    }
                }
            }

            if SettingsUi.shown[10]: VerticalLayout {
                spacing: 18px;
                // --- Son ---
                SectionTitle { text: @tr("Son"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        SettingRow {
                            title: @tr("Effets sonores");
                            description: @tr("Identité sonore de Halcyon : navigation, actions, notifications. Indépendant du volume du système.");
                            Toggle { y: (parent.height - self.height) / 2; checked: SettingsUi.sound-enabled; toggled(v) => { SettingsUi.sound-toggle("enabled", v); } }
                        }
                        SettingRow {
                            title: @tr("Mode silencieux");
                            description: @tr("Coupe tous les sons sans modifier les réglages ci-dessous.");
                            Toggle { y: (parent.height - self.height) / 2; checked: SettingsUi.sound-muted; toggled(v) => { SettingsUi.sound-toggle("muted", v); } }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        for row[i] in [
                            { label: @tr("Volume général"), hint: @tr("Appliqué à tous les sons.") },
                            { label: @tr("Navigation"), hint: @tr("Sélection, sections, panneaux, menus, retour.") },
                            { label: @tr("Interactions"), hint: @tr("Validation, favoris, collections, fiche d'un jeu, réglages.") },
                            { label: @tr("Notifications"), hint: @tr("Réussite, avertissement, erreur, téléchargements, mises à jour.") },
                            { label: @tr("Actions importantes"), hint: @tr("Lancement d'un jeu, grandes réussites.") },
                        ]: HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                alignment: center;
                                Text { text: row.label; color: Theme.text; font-size: Theme.t-body; font-weight: 600; }
                                Text { text: row.hint; color: Theme.text-dim; font-size: Theme.t-caption; overflow: elide; }
                            }
                            ValueSlider {
                                width: 220px;
                                y: 6px;
                                label: row.label;
                                enabled: SettingsUi.sound-enabled;
                                value: SettingsUi.sound-volumes[i];
                                committed(v) => { SettingsUi.sound-volume(i, v); }
                            }
                            Text {
                                width: 48px;
                                text: @tr("{} %", round(SettingsUi.sound-volumes[i] * 100));
                                color: Theme.text-muted;
                                font-size: Theme.t-small;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                            SecondaryButton {
                                y: 2px;
                                h: 34px;
                                text: @tr("Écouter");
                                icon: Icons.play;
                                has-icon: true;
                                clicked => { SettingsUi.sound-preview(i); }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        SettingRow {
                            title: @tr("Sons de survol");
                            description: @tr("Très discrets, au passage de la souris sur une jaquette.");
                            Toggle { y: (parent.height - self.height) / 2; checked: SettingsUi.sound-hover; toggled(v) => { SettingsUi.sound-toggle("hover", v); } }
                        }
                        SettingRow {
                            title: @tr("Pendant une partie");
                            description: @tr("Sons de Halcyon pendant un jeu lancé depuis Halcyon.");
                            Segmented {
                                y: (parent.height - self.height) / 2;
                                items: [@tr("Silencieux"), @tr("Réduits"), @tr("Normaux")];
                                selected: SettingsUi.sound-in-game;
                                activated(i) => { SettingsUi.sound-volume(5, i); }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            SecondaryButton {
                                text: @tr("Rétablir les réglages du son");
                                icon: Icons.restore;
                                has-icon: true;
                                clicked => { SettingsUi.sound-reset(); }
                            }
                        }
                    }
                }
            }

            if SettingsUi.shown[4]: VerticalLayout {
                spacing: 18px;
                // --- Hors ligne ---
                SectionTitle { text: @tr("Connexion"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        SettingRow {
                            title: @tr("Mode hors ligne forcé");
                            description: AppUi.online
                                ? @tr("Connexion disponible. Activez pour qu'Halcyon n'effectue plus aucune requête réseau (bibliothèque, lancement, sauvegardes et mods restent disponibles).")
                                : @tr("Hors ligne : la bibliothèque reste entièrement utilisable. Succès, visuels et métadonnées seront synchronisés automatiquement au retour de la connexion.");
                            Badge { y: (parent.height - self.height) / 2; text: AppUi.online ? @tr("En ligne") : @tr("Hors ligne"); tint: AppUi.online ? Theme.success : Theme.warm; solid: true; }
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.offline-forced;
                                toggled(v) => { SettingsUi.set-option("offline_forced", v); }
                            }
                        }
                    }
                }
            }

            if SettingsUi.shown[5]: VerticalLayout {
                spacing: 18px;
                // --- Système ---
                SectionTitle { text: @tr("Système"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        SettingRow {
                            title: @tr("Démarrer avec la session");
                            description: @tr("Halcyon s'ouvre réduit dans la zone de notification à la connexion.");
                            Toggle { y: (parent.height - self.height) / 2; checked: SystemUi.autostart; toggled(v) => { SystemUi.set-option("autostart", v); } }
                        }
                        SettingRow {
                            title: @tr("Fermer dans la zone de notification");
                            description: @tr("Fermer la fenêtre garde Halcyon actif (raccourcis, lancements depuis Sunshine). « Quitter » depuis l'icône pour l'arrêter.");
                            Toggle { y: (parent.height - self.height) / 2; checked: SystemUi.close-to-tray; toggled(v) => { SystemUi.set-option("close_to_tray", v); } }
                        }
                        SettingRow {
                            title: @tr("Réduire dans la zone de notification");
                            description: @tr("Une fenêtre réduite disparaît de la barre des tâches.");
                            Toggle { y: (parent.height - self.height) / 2; checked: SystemUi.minimize-to-tray; toggled(v) => { SystemUi.set-option("minimize_to_tray", v); } }
                        }
                        if SystemUi.tray-status != "": Text { text: SystemUi.tray-status; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
                        SettingRow {
                            title: @tr("Fenêtre compagnon pendant les parties");
                            description: @tr("Petite fenêtre au premier plan : temps de session, succès, notes. Aucune injection dans le jeu : visible en mode fenêtré sans bordure ou sur un second écran. Pour les performances (i/s, températures), utilisez MangoHud (Linux) ou RTSS / la Xbox Game Bar (Windows).");
                            Toggle { y: (parent.height - self.height) / 2; checked: SystemUi.companion; toggled(v) => { SystemUi.set-option("companion", v); } }
                        }
                    }
                }
            }

            if SettingsUi.shown[6]: VerticalLayout {
                spacing: 18px;
                // --- Raccourcis ---
                SectionTitle { text: @tr("Raccourcis clavier"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 6px;
                        for sc in SystemUi.shortcuts: ShortcutEditor { action: sc.action; label: sc.label; combo: sc.combo; default-combo: sc.default-combo; }
                        HorizontalLayout {
                            height: 40px;
                            Text { text: @tr("Aller aux pages (Accueil, Bibliothèque, Que jouer ?, Succès, Statistiques, Journal, Mises à jour, Sauvegardes, Paramètres)"); color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                            Text { text: @tr("Ctrl+1 … Ctrl+9"); color: Theme.text-muted; font-size: Theme.t-small; font-weight: 600; vertical-alignment: center; }
                        }
                        Text { text: @tr("Cliquez sur une combinaison puis appuyez sur les nouvelles touches. Retour arrière : aucun raccourci. Échap : annuler."); color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
                        Rectangle { height: 1px; background: Theme.border; }
                        SettingRow {
                            title: @tr("Raccourci global");
                            description: SystemUi.global-status != "" ? SystemUi.global-status : @tr("Ouvre le lancement rapide même quand Halcyon est en arrière-plan.");
                            Toggle { y: (parent.height - self.height) / 2; checked: SystemUi.global-enabled; toggled(v) => { SystemUi.set-option("global", v); } }
                        }
                        if SystemUi.global-enabled: HorizontalLayout {
                            spacing: 8px;
                            gtf := TextField { text: SystemUi.global-hotkey; mono: true; placeholder: @tr("Ctrl+Alt+H"); accepted(t) => { SystemUi.set-global-hotkey(t); } }
                            SecondaryButton { h: 36px; text: @tr("Appliquer"); clicked => { SystemUi.set-global-hotkey(gtf.text); } }
                        }
                        HorizontalLayout {
                            alignment: start;
                            padding-top: 6px;
                            SecondaryButton { h: 34px; text: @tr("Rétablir les raccourcis par défaut"); clicked => { SystemUi.reset-shortcuts(); } }
                        }
                    }
                }
            }

            if SettingsUi.shown[7]: VerticalLayout {
                spacing: 18px;
                // --- Export / restauration ---
                SectionTitle { text: @tr("Exporter ou restaurer la configuration"); }
                ExportPanel { }
            }

            if SettingsUi.shown[8]: VerticalLayout {
                spacing: 18px;
                // --- Mises à jour (Halcyon Update System) ---
                SectionTitle { text: @tr("Mises à jour"); }
                UpdateStatusPanel { }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        SettingRow {
                            title: @tr("Canal");
                            description: HusUi.channel == 1
                                ? @tr("Beta : prépublications pour tester les nouveautés, et versions stables plus récentes.")
                                : (HusUi.channel-default ? @tr("Stable : versions finales uniquement. Canal par défaut de la version installée.") : @tr("Stable : versions finales uniquement."));
                            Segmented {
                                y: (parent.height - self.height) / 2;
                                items: [@tr("Stable"), @tr("Beta")];
                                selected: HusUi.channel;
                                activated(i) => { HusUi.set-channel(i); }
                            }
                        }
                        SettingRow {
                            title: @tr("Rechercher automatiquement");
                            description: @tr("Au démarrage puis toutes les 6 heures. Requête conditionnelle à GitHub : rien n'est retéléchargé si rien n'a changé.");
                            Badge { y: (parent.height - self.height) / 2; text: @tr("En ligne"); tint: Theme.warm; solid: true; }
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: SettingsUi.check-updates;
                                toggled(v) => { SettingsUi.set-option("check_updates", v); }
                            }
                        }
                        SettingRow {
                            title: @tr("Mises à jour automatiques");
                            description: HusUi.managed
                                ? @tr("Télécharge et vérifie les nouvelles versions en arrière-plan, puis les installe au démarrage suivant de Halcyon.")
                                : @tr("Indisponible pour cette installation : {}", HusUi.kind);
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                enabled: HusUi.managed;
                                checked: HusUi.auto && HusUi.managed;
                                toggled(v) => { HusUi.set-auto(v); }
                            }
                        }
                        if HusUi.can-install-user: SettingRow {
                            title: @tr("Installer Halcyon pour mon compte");
                            description: @tr("Copie cette AppImage dans ~/.local/opt/halcyon, ajoute Halcyon au menu des applications et à ~/.local/bin. Les mises à jour remplaceront ensuite ce fichier, sans toucher aux raccourcis.");
                            SecondaryButton { y: (parent.height - self.height) / 2; text: @tr("Installer"); icon: Icons.download; has-icon: true; clicked => { HusUi.install-user(); } }
                        }
                        HorizontalLayout {
                            TextSetting {
                                key: "update_repo";
                                label: @tr("Dépôt des versions");
                                hint: @tr("Vide : dépôt officiel (sebdss/halcyon). Un autre dépôt n'est utile que pour une version dérivée : ses manifestes doivent être signés par une clé intégrée à cette compilation.");
                                placeholder: @tr("sebdss/halcyon");
                                value: SettingsUi.update-repo;
                            }
                        }
                    }
                }
                if HusUi.notes != "": Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 10px;
                        Text { text: @tr("Nouveautés de la version {}", HusUi.latest); color: Theme.text; font-size: Theme.t-body; font-weight: 650; }
                        Text { text: HusUi.notes; color: Theme.text-muted; font-size: Theme.t-small; wrap: word-wrap; }
                    }
                }
                Text { text: HusUi.kind + ". " + HusUi.verification; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
            }

            if SettingsUi.shown[9]: VerticalLayout {
                spacing: 18px;
                // --- Stockage & diagnostic ---
                SectionTitle { text: @tr("Stockage et diagnostic"); }
                Panel {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 20px;
                        SettingRow {
                            title: @tr("Cache des miniatures");
                            description: @tr("{} — reconstruit automatiquement si vidé.", SettingsUi.cache-size);
                            SecondaryButton {
                                y: (parent.height - self.height) / 2;
                                text: @tr("Vider");
                                h: 34px;
                                clicked => { SettingsUi.clear-cache(); }
                            }
                        }
                        SettingRow {
                            title: @tr("Données de l'application");
                            description: SettingsUi.data-dir;
                            SecondaryButton {
                                y: (parent.height - self.height) / 2;
                                text: @tr("Ouvrir");
                                h: 34px;
                                clicked => { SettingsUi.open-data(); }
                            }
                        }
                        SettingRow {
                            title: @tr("Vérification d'intégrité");
                            description: @tr("Base de données, paramètres, dossier des données, jeux installés, jaquettes et extensions.");
                            SecondaryButton { y: (parent.height - self.height) / 2; text: SystemUi.integrity-running ? @tr("Vérification…") : @tr("Vérifier"); icon: Icons.shield; has-icon: true; h: 34px; clicked => { SystemUi.check-integrity(); } }
                        }
                        if SystemUi.integrity-status != "": Text { text: SystemUi.integrity-status; color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; }
                        SettingRow {
                            title: @tr("Journaux");
                            description: @tr("{} — dont security.log : clés d'API définies ou retirées (jamais leur valeur), extensions et autorisations, mises à jour vérifiées ou refusées, compte Microsoft.", SettingsUi.log-dir);
                            SecondaryButton {
                                y: (parent.height - self.height) / 2;
                                text: @tr("Ouvrir");
                                h: 34px;
                                clicked => { SettingsUi.open-logs(); }
                            }
                        }
                    }
                }
            }

            Text {
                text: @tr("Halcyon {}. Made with Slint. Police Archivo (SIL OFL).", SettingsUi.version);
                color: Theme.text-dim;
                font-size: Theme.t-caption;
                horizontal-alignment: center;
            }
        }
    }
}
