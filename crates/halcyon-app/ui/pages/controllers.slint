import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { PadsUi } from "../state.slint";
import { Panel, SectionTitle, PageHeader, SecondaryButton, PrimaryButton, TextField, Badge, Notice, IconButton, Dropdown, Icon, ListItem, Rubric } from "../components.slint";

export component ControllersPage inherits Rectangle {
    ScrollView {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.width;
            padding: Theme.page-padding;
            padding-top: 24px;
            spacing: 18px;
            alignment: start;

            PageHeader {
                title: @tr("Manettes");
                subtitle: @tr("Manettes connectées, profils de touches pour la navigation (Big Picture) et options transmises aux émulateurs.");
            }

            Rubric { title: @tr("Connectées"); note: PadsUi.pads.length > 0 ? @tr("{n} manette" | "{n} manettes" % PadsUi.pads.length) : ""; }
            if PadsUi.pads.length == 0: Text { text: @tr("Aucune manette détectée. Branchez-en une ou appairez-la en Bluetooth : elle apparaîtra ici automatiquement."); color: Theme.text-dim; font-size: Theme.t-small; wrap: word-wrap; }
            for p in PadsUi.pads: ListItem {
                height: 58px;
                active: p.last-used;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 14px;
                    Icon { source: Icons.gamepad; size: 22px; tint: p.last-used ? Theme.accent : Theme.text-muted; y: (parent.height - self.height) / 2; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: p.name; color: Theme.text; font-size: Theme.t-body; font-weight: 650; overflow: elide; }
                            Badge { text: p.brand; }
                            if p.last-used: Badge { text: @tr("Dernière utilisée"); tint: Theme.accent; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { text: p.power; color: Theme.text-dim; font-size: Theme.t-caption; }
                    }
                }
            }

            Rubric { title: @tr("Profils de manette"); }
            Notice {
                text: @tr("Un profil change les touches de navigation de Halcyon et peut ajouter des options à la ligne de commande d'un émulateur (ex. RetroArch : --appendconfig=…). Associez-le à un jeu depuis l'onglet Profils de sa fiche. Pour les jeux PC, la configuration des touches reste celle du jeu, de Steam Input ou de votre pilote : Halcyon n'intercepte pas la manette pendant une partie.");
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Dropdown {
                    prefix: @tr("Navigation :");
                    align-left: true;
                    popup-width: 240px;
                    options: PadsUi.profile-labels;
                    selected: PadsUi.active;
                    changed(i) => { PadsUi.set-active(i); }
                }
                SecondaryButton { h: 34px; text: @tr("Nouveau profil"); icon: Icons.plus; has-icon: true; clicked => { PadsUi.new-profile(); } }
            }
            for pr in PadsUi.profiles: ListItem {
                height: 54px;
                active: pr.active;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: pr.name; color: Theme.text; font-size: Theme.t-body; font-weight: 650; }
                            if pr.active: Badge { text: @tr("Navigation"); tint: Theme.accent; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { text: pr.summary; color: Theme.text-dim; font-size: Theme.t-caption; overflow: elide; }
                    }
                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.edit; tooltip: @tr("Modifier"); clicked => { PadsUi.edit(pr.id); } }
                    IconButton { y: (parent.height - self.height) / 2; icon: Icons.trash; active-tint: Theme.danger; tooltip: @tr("Supprimer"); clicked => { PadsUi.delete(pr.id); } }
                }
            }

            if PadsUi.editing >= 0: Panel {
                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    Text { text: PadsUi.editing == 0 ? @tr("Nouveau profil") : @tr("Modifier le profil"); color: Theme.text; font-size: Theme.t-subheading; font-weight: 700; }
                    name := TextField { text: PadsUi.edit-name; placeholder: @tr("Nom (ex. Disposition Nintendo)"); }
                    Text { text: @tr("Touches de navigation"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
                    for m in PadsUi.mapping: HorizontalLayout {
                        height: 40px;
                        spacing: 10px;
                        Text { text: m.label; color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; width: 220px; }
                        Badge { y: 10px; text: m.button; tint: PadsUi.capture == m.action ? Theme.warm : Theme.text-muted; }
                        SecondaryButton {
                            h: 32px;
                            text: PadsUi.capture == m.action ? @tr("Appuyez sur un bouton…") : @tr("Changer");
                            clicked => { if (PadsUi.capture == m.action) { PadsUi.capture-cancel(); } else { PadsUi.capture-start(m.action); } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if PadsUi.emu-args.length > 0: Text { text: @tr("Options transmises aux émulateurs détectés"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
                    for e in PadsUi.emu-args: HorizontalLayout {
                        spacing: 10px;
                        Text { text: e.name; color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; width: 220px; }
                        TextField { text: e.args; mono: true; placeholder: @tr("ex. --appendconfig=/chemin/manette.cfg"); edited(t) => { PadsUi.set-emu-arg(e.id, t); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        SecondaryButton { text: @tr("Annuler"); clicked => { PadsUi.capture-cancel(); PadsUi.editing = -1; } }
                        PrimaryButton { text: @tr("Enregistrer"); icon: Icons.check; has-icon: true; clicked => { PadsUi.save(name.text); } }
                    }
                }
            }
        }
    }
}
