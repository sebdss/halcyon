// Succès : vue d'ensemble de toutes les plateformes synchronisées.
//
// Composition « Berge » : le taux de complétion est le chiffre-titre de la page ; les
// rubriques (par plateforme, par mois, récents, rares, terminés) s'ouvrent par un filet et
// un titre, sans cartes.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Nav, Page, Actions, AchUi } from "../state.slint";
import { PrimaryButton, SecondaryButton, TextButton, SectionTitle, Icon, GameTile, BigStat, Notice, Rubric } from "../components.slint";
import { AchievementItem } from "game.slint";

export component AchievementsPage inherits Rectangle {
    ScrollView {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.width;
            padding: Theme.page-padding;
            padding-top: 32px;
            spacing: 36px;
            alignment: start;

            // Chiffre-titre et actions.
            HorizontalLayout {
                spacing: 28px;
                Text {
                    text: round(AchUi.percent * 1000) / 10 + " %";
                    color: AchUi.percent >= 1 ? Theme.warm : Theme.text;
                    font-family: Theme.display;
                    font-size: Theme.t-display + 12px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    Text { text: @tr("Complétion globale, {n} succès débloqué sur {}" | "Complétion globale, {n} succès débloqués sur {}" % AchUi.unlocked, AchUi.total); color: Theme.text; font-size: Theme.t-subheading; font-weight: 500; wrap: word-wrap; }
                    Rectangle {
                        height: 4px;
                        background: Theme.surface-active;
                        Rectangle { x: 0; width: parent.width * AchUi.percent; background: AchUi.percent >= 1 ? Theme.warm : Theme.accent; }
                    }
                    Text { text: AchUi.status; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
                }
                VerticalLayout {
                    alignment: center;
                    PrimaryButton {
                        text: AchUi.syncing ? @tr("Synchronisation…") : @tr("Synchroniser");
                        icon: Icons.refresh;
                        has-icon: true;
                        enabled: !AchUi.syncing && (AchUi.steam-ready || AchUi.ra-ready);
                        clicked => { AchUi.sync-all(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 48px;
                alignment: start;
                BigStat { value: AchUi.completed; label: @tr("jeux terminés à 100 %"); }
                BigStat { value: AchUi.games; label: @tr("jeux suivis"); }
                if AchUi.points > 0: BigStat { value: AchUi.points; label: @tr("points RetroAchievements"); }
            }

            if !AchUi.steam-ready || !AchUi.ra-ready: HorizontalLayout {
                spacing: 16px;
                Notice {
                    horizontal-stretch: 1;
                    warning: true;
                    text: (!AchUi.steam-ready ? @tr("Steam : ajoutez votre clé Web API pour synchroniser vos succès Steam. ") : "")
                        + (!AchUi.ra-ready ? @tr("RetroAchievements : renseignez votre nom d'utilisateur et votre clé Web API pour les jeux émulés. ") : "")
                        + @tr("Epic Games ne fournit pas d'API publique de succès : ils ne sont pas affichés.");
                }
                TextButton { y: 2px; text: @tr("Configurer les comptes"); clicked => { Nav.go(Page.settings); } }
            }

            HorizontalLayout {
                spacing: Theme.s6;
                Rubric {
                    horizontal-stretch: 1;
                    title: @tr("Par plateforme");
                    if AchUi.providers.length == 0: Text {
                        text: @tr("Aucun succès synchronisé pour l'instant.");
                        color: Theme.text-dim;
                        font-size: Theme.t-small;
                    }
                    for p in AchUi.providers: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            Text { text: p.name; color: Theme.text; font-size: Theme.t-small; font-weight: 600; horizontal-stretch: 1; }
                            Text { text: p.unlocked + " / " + p.total; color: Theme.text-muted; font-family: Theme.display; font-size: Theme.t-caption; font-weight: 600; }
                        }
                        Rectangle {
                            height: 4px;
                            background: Theme.surface-active;
                            Rectangle { x: 0; width: parent.width * p.percent; background: Theme.accent; }
                        }
                    }
                }
                Rubric {
                    horizontal-stretch: 1;
                    title: @tr("Déblocages par mois");
                    if AchUi.months.length == 0: Text {
                        text: @tr("La chronologie apparaîtra après vos premiers déblocages.");
                        color: Theme.text-dim;
                        font-size: Theme.t-small;
                    }
                    if AchUi.months.length > 0: HorizontalLayout {
                        height: 140px;
                        spacing: 8px;
                        for m in AchUi.months: VerticalLayout {
                            spacing: 6px;
                            Text { text: m.count; color: Theme.text-muted; font-size: Theme.t-overline; horizontal-alignment: center; }
                            Rectangle {
                                vertical-stretch: 1;
                                Rectangle {
                                    y: parent.height - self.height;
                                    height: max(2px, parent.height * m.ratio);
                                    border-radius: 1px;
                                    background: Theme.warm;
                                }
                            }
                            Text { text: m.label; color: Theme.text-dim; font-size: Theme.t-overline - 1px; horizontal-alignment: center; }
                        }
                    }
                }
            }

            if AchUi.recent.length > 0: Rubric {
                title: @tr("Récemment débloqués");
                for a in AchUi.recent: AchievementItem { item: a; reveal: true; show-game: true; }
            }

            if AchUi.rarest.length > 0: Rubric {
                title: @tr("Les plus rares");
                for a in AchUi.rarest: AchievementItem { item: a; reveal: true; show-game: true; }
            }

            if AchUi.completed-games.length > 0: Rubric {
                title: @tr("Terminés à 100 %");
                Rectangle {
                    height: 140px * 1.5 + 56px;
                    for g[i] in AchUi.completed-games: GameTile {
                        x: i * 160px;
                        visible: (i + 1) * 160px <= parent.width + 20px;
                        game: g;
                        cover-width: 140px;
                        open(id) => { Actions.open-game(id); }
                        play(id) => { Actions.play(id); }
                    }
                }
            }
        }
    }
}
