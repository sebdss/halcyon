import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Art } from "../theme.slint";
import { AchievementRow, ProfileRow, ModRow } from "../types.slint";
import { Nav, Page, Actions, DetailUi, AppUi, SystemUi, GameMenu } from "../state.slint";
import {
    GameCover, PrimaryButton, PlayButton, SecondaryButton, TextButton, IconButton, Badge, Panel, InfoRow, TextField, Icon,
    SectionTitle, Chip, Dropdown, TextArea, Toggle, Notice, Segmented, Overline, Rubric
} from "../components.slint";

/// Onglet de la fiche : texte, compteur discret, perche sous l'onglet actif.
component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <string> badge;
    callback clicked;
    height: 48px;
    width: lbl.preferred-width + (root.badge != "" ? 6px + cnt.preferred-width : 0px);
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;
    lbl := Text {
        x: 0;
        text: root.text;
        color: root.selected || ta.has-hover || fs.has-focus ? Theme.text : Theme.text-muted;
        font-size: Theme.t-body;
        font-weight: root.selected ? 650 : 500;
        vertical-alignment: center;
    }
    cnt := Text {
        visible: root.badge != "";
        x: lbl.preferred-width + 6px;
        text: root.badge;
        color: Theme.text-dim;
        font-family: Theme.display;
        font-size: Theme.t-caption;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 0;
        y: root.height - 2px;
        height: 2px;
        width: root.selected ? root.width : 0px;
        background: Theme.accent;
        animate width { duration: Theme.normal; easing: ease-out; }
    }
    if fs.has-focus: Rectangle { x: -6px; width: root.width + 12px; y: 10px; height: root.height - 20px; border-radius: Theme.radius-sm; border-width: Theme.focus-width; border-color: Theme.focus; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.t-caption;
        font-weight: 600;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.text-dim;
        font-size: Theme.t-caption;
        wrap: word-wrap;
    }
}

component PathField inherits HorizontalLayout {
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> folder;
    in property <bool> image;
    spacing: 8px;
    TextField { text <=> root.value; mono: true; placeholder: root.placeholder; }
    if AppUi.can-browse: SecondaryButton {
        text: @tr("Parcourir…");
        h: 36px;
        clicked => {
            let p = root.image ? DetailUi.browse-image() : root.folder ? AppUi.browse-folder() : AppUi.browse-file();
            if (p != "") { root.value = p; }
        }
    }
}

component LaunchSettings inherits VerticalLayout {
    in-out property <string> name: DetailUi.game.title;
    in-out property <string> exe: DetailUi.game.executable;
    in-out property <string> args: DetailUi.game.arguments;
    in-out property <string> wd: DetailUi.game.working-dir;
    spacing: 18px;

    Field {
        label: @tr("Nom affiché");
        TextField { text <=> root.name; }
    }
    Field {
        label: @tr("Exécutable");
        hint: DetailUi.game.platform-client
            ? @tr("Laisser vide pour lancer via le client de la plateforme (recommandé : succès, cloud et DRM restent gérés par la plateforme).")
            : "";
        PathField { value <=> root.exe; placeholder: DetailUi.game.platform-client ? @tr("Lancement via la plateforme") : @tr("Chemin de l'exécutable"); }
    }
    Field {
        label: @tr("Arguments de lancement");
        hint: DetailUi.game.platform-client && root.exe == ""
            ? @tr("Non transmis lors d'un lancement via la plateforme : définissez-les dans Steam / Epic, ou indiquez un exécutable ci-dessus.")
            : @tr("Séparés par des espaces ; utilisez des guillemets pour les valeurs contenant des espaces.");
        TextField { text <=> root.args; mono: true; placeholder: @tr("ex. -windowed -nosplash"); }
    }
    Field {
        label: @tr("Répertoire de travail");
        hint: @tr("Par défaut : le dossier de l'exécutable.");
        PathField { value <=> root.wd; folder: true; placeholder: @tr("Dossier de l'exécutable"); }
    }
    HorizontalLayout {
        alignment: start;
        PrimaryButton {
            text: @tr("Enregistrer le lancement");
            icon: Icons.check;
            has-icon: true;
            clicked => { DetailUi.save-launch(DetailUi.game.id, root.name, root.exe, root.args, root.wd); }
        }
    }
}

component EmulationSettings inherits VerticalLayout {
    in-out property <string> name: DetailUi.game.title;
    in-out property <string> ra: DetailUi.game.ra-id;
    spacing: 18px;
    Field {
        label: @tr("Nom affiché");
        HorizontalLayout {
            spacing: 8px;
            TextField { text <=> root.name; }
            SecondaryButton {
                text: @tr("Renommer");
                h: 36px;
                clicked => { DetailUi.save-launch(DetailUi.game.id, root.name, "", "", ""); }
            }
        }
    }
    Field {
        label: @tr("Émulateur");
        hint: @tr("« Par défaut » utilise l'émulateur choisi pour la plateforme dans la page Émulateurs.");
        HorizontalLayout {
            alignment: start;
            Dropdown {
                prefix: "";
                options: DetailUi.emulator-options;
                selected <=> DetailUi.emulator-index;
                changed(i) => { DetailUi.set-emulator(DetailUi.game.id, i); }
            }
        }
    }
    Field {
        label: @tr("Identifiant RetroAchievements");
        hint: @tr("Trouvé automatiquement par empreinte pour les consoles à cartouche. Pour les jeux sur disque, saisissez l'ID visible dans l'adresse de la page du jeu sur retroachievements.org.");
        HorizontalLayout {
            spacing: 8px;
            TextField { text <=> root.ra; placeholder: @tr("ex. 1446"); }
            SecondaryButton {
                text: @tr("Associer");
                h: 36px;
                clicked => { DetailUi.set-ra-id(DetailUi.game.id, root.ra); }
            }
        }
    }
}

component MetadataSettings inherits VerticalLayout {
    in-out property <string> description: DetailUi.game.description;
    in-out property <string> developer: DetailUi.game.developer;
    in-out property <string> publisher: DetailUi.game.publisher;
    in-out property <string> release: DetailUi.game.release;
    in-out property <string> genres: DetailUi.game.genres;
    in-out property <string> tags: DetailUi.game.tags;
    in-out property <string> cover;
    in-out property <string> banner;
    spacing: 18px;

    SectionTitle { text: @tr("Métadonnées"); }
    Field {
        label: @tr("Description");
        TextArea { text <=> root.description; height: 110px; }
    }
    HorizontalLayout {
        spacing: 12px;
        Field { label: @tr("Développeur"); TextField { text <=> root.developer; } }
        Field { label: @tr("Éditeur"); TextField { text <=> root.publisher; } }
    }
    HorizontalLayout {
        spacing: 12px;
        Field { label: @tr("Date de sortie"); TextField { text <=> root.release; placeholder: @tr("ex. 2023-02-10"); } }
        Field { label: @tr("Genres (séparés par des virgules)"); TextField { text <=> root.genres; placeholder: @tr("Action, RPG"); } }
    }
    Field {
        label: @tr("Étiquettes (séparées par des virgules)");
        hint: @tr("Utilisées par la recherche (tag:…) et les collections intelligentes, ex. multijoueur, coop, solo.");
        TextField { text <=> root.tags; placeholder: @tr("multijoueur, coop"); }
    }
    HorizontalLayout {
        alignment: start;
        PrimaryButton {
            text: @tr("Enregistrer les métadonnées");
            icon: Icons.check;
            has-icon: true;
            clicked => { DetailUi.save-metadata(DetailUi.game.id, root.description, root.developer, root.publisher, root.release, root.genres, root.tags); }
        }
    }

    SectionTitle { text: @tr("Visuels personnalisés"); }
    Field {
        label: @tr("Jaquette (portrait 2:3)");
        hint: @tr("L'image est copiée dans les données de Halcyon et remplace la jaquette de la plateforme.");
        HorizontalLayout {
            spacing: 8px;
            PathField { value <=> root.cover; image: true; placeholder: @tr("Fichier image (.jpg, .png, .webp)"); }
            SecondaryButton { text: @tr("Appliquer"); h: 36px; clicked => { DetailUi.set-artwork(DetailUi.game.id, "cover", root.cover); } }
        }
    }
    Field {
        label: @tr("Bannière (paysage)");
        HorizontalLayout {
            spacing: 8px;
            PathField { value <=> root.banner; image: true; placeholder: @tr("Fichier image (.jpg, .png, .webp)"); }
            SecondaryButton { text: @tr("Appliquer"); h: 36px; clicked => { DetailUi.set-artwork(DetailUi.game.id, "banner", root.banner); } }
        }
    }
    if DetailUi.game.can-remove: HorizontalLayout {
        alignment: start;
        SecondaryButton {
            text: @tr("Retirer de la bibliothèque");
            icon: Icons.trash;
            has-icon: true;
            danger: true;
            clicked => { DetailUi.remove(DetailUi.game.id); }
        }
    }
}

export component AchievementItem inherits Rectangle {
    in property <AchievementRow> item;
    in property <bool> reveal;
    in property <bool> show-game;
    height: 68px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.surface : transparent;
    ta := TouchArea { }
    property <bool> masked: root.item.hidden && !root.item.unlocked && !root.reveal;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    // Débloqué : perche orange (le succès est un moment vivant).
    if root.item.unlocked: Rectangle { x: 0; y: 14px; width: Theme.perch; height: parent.height - 28px; background: Theme.warm; }

    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: Theme.radius-sm;
            clip: true;
            background: Theme.surface-active;
            opacity: root.item.unlocked ? 1 : 0.45;
            if root.item.has-icon && !root.masked: Image {
                width: parent.width;
                height: parent.height;
                source: root.item.icon;
                image-fit: cover;
            }
            if !root.item.has-icon || root.masked: Icon {
                source: root.masked ? Icons.eye-off : Icons.trophy;
                size: 22px;
                tint: root.item.unlocked ? Theme.warm : Theme.text-dim;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.masked ? @tr("Succès caché") : root.item.name;
                    color: root.item.unlocked ? Theme.text : Theme.text-muted;
                    font-size: Theme.t-body;
                    font-weight: 650;
                    overflow: elide;
                }
                if root.item.hardcore: Badge { text: @tr("Hardcore"); tint: Theme.warm; solid: true; }
                if root.item.custom: Badge { text: @tr("Personnalisé, non vérifié"); }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.show-game ? root.item.game + (root.masked ? "" : " : " + root.item.description)
                    : root.masked ? @tr("Débloquez-le pour découvrir sa description.") : root.item.description;
                color: Theme.text-dim;
                font-size: Theme.t-caption;
                overflow: elide;
            }
            if root.item.has-progress: Rectangle {
                height: 3px;
                background: Theme.surface-active;
                Rectangle {
                    x: 0;
                    width: parent.width * root.item.progress;
                    background: Theme.accent;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            width: 170px;
            Text {
                text: root.item.unlocked ? root.item.date : @tr("Verrouillé");
                color: root.item.unlocked ? Theme.text : Theme.text-dim;
                font-size: Theme.t-caption;
                font-weight: 600;
                horizontal-alignment: right;
            }
            Text {
                text: root.item.has-rarity ? root.item.rarity : root.item.points;
                color: root.item.has-rarity && root.item.rarity-pct < 10 ? Theme.warm : Theme.text-dim;
                font-size: Theme.t-caption;
                horizontal-alignment: right;
            }
        }
        if root.item.custom: VerticalLayout {
            alignment: center;
            spacing: 4px;
            IconButton {
                size: 32px;
                icon-size: 16px;
                icon: root.item.unlocked ? Icons.close : Icons.check;
                tooltip: root.item.unlocked ? @tr("Marquer comme verrouillé") : @tr("Marquer comme débloqué");
                clicked => { DetailUi.toggle-custom-achievement(root.item.id); }
            }
        }
        if root.item.custom: VerticalLayout {
            alignment: center;
            IconButton {
                size: 32px;
                icon-size: 16px;
                icon: Icons.trash;
                active-tint: Theme.danger;
                tooltip: @tr("Supprimer");
                clicked => { DetailUi.delete-custom-achievement(root.item.id); }
            }
        }
    }
}

component AchievementsTab inherits VerticalLayout {
    in-out property <string> new-name;
    in-out property <string> new-desc;
    spacing: 14px;

    Rectangle {
        height: ach-head.preferred-height;
        ach-head := HorizontalLayout {
            padding-bottom: 8px;
            spacing: 18px;
            if DetailUi.ach-percent >= 0: Text {
                text: @tr("{} %", round(DetailUi.ach-percent * 100));
                color: DetailUi.ach-percent >= 1 ? Theme.warm : Theme.text;
                font-family: Theme.display;
                font-size: Theme.t-title + 6px;
                font-weight: 800;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    text: DetailUi.ach-summary;
                    color: Theme.text;
                    font-size: Theme.t-subheading;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if DetailUi.ach-percent >= 0: Rectangle {
                    height: 4px;
                    background: Theme.surface-active;
                    Rectangle {
                        x: 0;
                        width: parent.width * DetailUi.ach-percent;
                        background: DetailUi.ach-percent >= 1 ? Theme.warm : Theme.accent;
                    }
                }
                Text {
                    text: DetailUi.ach-status;
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                    wrap: word-wrap;
                }
            }
            if DetailUi.ach-mode == "steam" || DetailUi.ach-mode == "retroachievements": VerticalLayout {
                alignment: center;
                SecondaryButton {
                    text: DetailUi.ach-syncing ? @tr("Synchronisation…") : @tr("Synchroniser");
                    icon: Icons.refresh;
                    has-icon: true;
                    enabled: !DetailUi.ach-syncing;
                    clicked => { DetailUi.sync-achievements(DetailUi.game.id); }
                }
            }
            if DetailUi.ach-mode == "unconfigured": VerticalLayout {
                alignment: center;
                SecondaryButton {
                    text: @tr("Configurer les comptes");
                    clicked => { Nav.go(Page.settings); }
                }
            }
        }
    }

    if DetailUi.achievements.length > 0: HorizontalLayout {
        alignment: start;
        Chip {
            text: @tr("Révéler les succès cachés");
            checked: DetailUi.show-hidden-ach;
            toggled => { DetailUi.show-hidden-ach = !DetailUi.show-hidden-ach; }
        }
    }

    for a in DetailUi.achievements: AchievementItem {
        item: a;
        reveal: DetailUi.show-hidden-ach;
    }

    if DetailUi.ach-mode == "custom": Panel {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: @tr("Créer un succès personnalisé");
                color: Theme.text;
                font-size: Theme.t-body;
                font-weight: 700;
            }
            Text {
                text: @tr("Ce jeu ne dispose d'aucun système de succès reconnu. Vos succès personnalisés sont marqués comme tels et ne sont jamais présentés comme vérifiés par une plateforme.");
                color: Theme.text-dim;
                font-size: Theme.t-caption;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                TextField { text <=> root.new-name; placeholder: @tr("Nom (ex. Terminer en difficulté maximale)"); }
                TextField { text <=> root.new-desc; placeholder: @tr("Description (facultatif)"); }
                PrimaryButton {
                    text: @tr("Ajouter");
                    icon: Icons.plus;
                    has-icon: true;
                    h: 36px;
                    enabled: root.new-name != "";
                    clicked => {
                        DetailUi.add-custom-achievement(DetailUi.game.id, root.new-name, root.new-desc);
                        root.new-name = "";
                        root.new-desc = "";
                    }
                }
            }
        }
    }
}


component StatusChips inherits HorizontalLayout {
    spacing: 8px;
    alignment: start;
    for label[i] in [@tr("Aucun statut"), @tr("À jouer"), @tr("En cours"), @tr("Terminé"), @tr("Abandonné")]: Chip {
        text: label;
        checked: DetailUi.game.status == i;
        toggled => { DetailUi.set-status(DetailUi.game.id, i); }
    }
}

component TrackingTab inherits VerticalLayout {
    in-out property <string> notes: DetailUi.game.notes;
    in-out property <string> manual;
    spacing: 18px;

    SectionTitle { text: @tr("Statut"); }
    StatusChips { }

    SectionTitle { text: @tr("Temps de jeu"); }
    Panel {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: DetailUi.game.playtime; color: Theme.text; font-family: Theme.display; font-size: Theme.t-title - 2px; font-weight: 800; }
                if DetailUi.game.playtime-origin != "": Badge { y: 8px; text: DetailUi.game.playtime-origin; tint: DetailUi.game.has-manual ? Theme.warm : Theme.accent; }
                Rectangle { horizontal-stretch: 1; }
            }
            InfoRow { label: @tr("Rapporté par la plateforme"); value: DetailUi.game.playtime-platform; }
            InfoRow { label: @tr("Suivi par Halcyon"); value: DetailUi.game.playtime-local; }
            InfoRow { label: @tr("Session moyenne"); value: DetailUi.game.avg-session; }
            InfoRow { label: @tr("Première session suivie"); value: DetailUi.game.first-session; }
            InfoRow { label: @tr("Correction manuelle"); value: DetailUi.game.has-manual ? DetailUi.game.playtime-manual : @tr("Aucune"); }
            Rectangle { height: 1px; background: Theme.border; }
            HorizontalLayout {
                spacing: 8px;
                TextField { text <=> root.manual; placeholder: @tr("Temps réel, ex. 12h30 ou 45m"); mono: true; }
                SecondaryButton {
                    text: @tr("Corriger");
                    h: 36px;
                    enabled: root.manual != "";
                    clicked => { DetailUi.set-manual-playtime(DetailUi.game.id, root.manual); root.manual = ""; }
                }
                if DetailUi.game.has-manual: SecondaryButton {
                    text: @tr("Revenir au temps calculé");
                    h: 36px;
                    clicked => { DetailUi.set-manual-playtime(DetailUi.game.id, ""); }
                }
            }
            Text {
                text: @tr("La correction remplace le temps affiché partout (bibliothèque, statistiques). Les données de la plateforme et du suivi local sont conservées.");
                color: Theme.text-dim;
                font-size: Theme.t-caption;
                wrap: word-wrap;
            }
        }
    }

    SectionTitle { text: @tr("Notes"); }
    TextArea { text <=> root.notes; height: 120px; }
    HorizontalLayout {
        alignment: start;
        SecondaryButton {
            text: @tr("Enregistrer les notes");
            icon: Icons.check;
            has-icon: true;
            enabled: root.notes != DetailUi.game.notes;
            clicked => { DetailUi.save-notes(DetailUi.game.id, root.notes); }
        }
    }

    SectionTitle { text: @tr("Version"); }
    Panel {
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            InfoRow { label: @tr("Version installée"); value: DetailUi.game.version != "" ? DetailUi.game.version : @tr("Non fournie par la plateforme"); }
            InfoRow { label: @tr("État"); value: DetailUi.game.update-state; }
            if DetailUi.game.update-pending && DetailUi.game.update-progress > 0: Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.surface-active;
                Rectangle { x: 0; width: parent.width * DetailUi.game.update-progress; border-radius: 3px; background: Theme.accent; }
            }
            for v in DetailUi.versions: HorizontalLayout {
                Text { text: v.version; color: Theme.text-muted; font-size: Theme.t-caption; font-family: "monospace"; horizontal-stretch: 1; }
                Text { text: v.date; color: Theme.text-dim; font-size: Theme.t-caption; }
            }
        }
    }
    if DetailUi.prereqs.length > 0: Panel {
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: @tr("Prérequis fournis avec le jeu"); color: Theme.text; font-size: Theme.t-body; font-weight: 650; horizontal-stretch: 1; vertical-alignment: center; }
                SecondaryButton { text: @tr("Ouvrir le dossier"); h: 34px; clicked => { Actions.open-folder(DetailUi.prereq-dir); } }
            }
            Text { text: DetailUi.prereq-note; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for p in DetailUi.prereqs: Badge { text: p; }
            }
        }
    }

    SectionTitle { text: @tr("Sessions suivies"); }
    if DetailUi.sessions.length == 0: Text {
        text: @tr("Aucune session suivie par Halcyon pour ce jeu.");
        color: Theme.text-dim;
        font-size: Theme.t-small;
    }
    for r in DetailUi.sessions: HorizontalLayout {
        height: 30px;
        Text { text: r.date; color: Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: r.duration; color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; }
    }
}

component ProfileEditor inherits Panel {
    in property <ProfileRow> p;
    in-out property <string> name: root.p.name;
    in-out property <string> args: root.p.args;
    in-out property <bool> replace-args: root.p.replace-args;
    in-out property <string> resolution: root.p.resolution;
    in-out property <int> display: root.p.display;
    in-out property <string> fps: root.p.fps;
    in-out property <int> gpu: root.p.gpu;
    in-out property <bool> allow-gpu: root.p.allow-gpu-registry;
    in-out property <int> priority: root.p.priority;
    in-out property <string> wd: root.p.working-dir;
    in-out property <string> env: root.p.env;
    in-out property <string> pre: root.p.pre;
    in-out property <string> post: root.p.post;
    in-out property <bool> is-default: root.p.is-default;
    in-out property <int> mod-profile: root.p.mod-profile;
    in-out property <int> pad-profile: root.p.pad-profile;
    in-out property <string> comp-path;
    in-out property <string> comp-args;
    in-out property <bool> comp-close: true;

    VerticalLayout {
        padding: 22px;
        spacing: 16px;
        Text { text: root.p.id == 0 ? @tr("Nouveau profil") : @tr("Modifier « {} »", root.p.name); color: Theme.text; font-size: Theme.t-subheading; font-weight: 700; }
        Notice { text: @tr("Moteur détecté : {}. Les réglages sans équivalent pour ce jeu ou ce mode de lancement sont signalés à l'enregistrement, jamais simulés.", DetailUi.engine); }
        HorizontalLayout {
            spacing: 12px;
            Field { label: @tr("Nom du profil"); TextField { text <=> root.name; placeholder: @tr("ex. Performance, Fenêtré, Streaming"); } }
            VerticalLayout {
                spacing: 6px;
                Text { text: @tr("Profil par défaut"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
                Toggle { checked <=> root.is-default; }
            }
        }
        Field {
            label: @tr("Arguments");
            hint: @tr("Ajoutés à ceux du jeu, sauf si l'option ci-dessous est activée.");
            TextField { text <=> root.args; mono: true; placeholder: @tr("ex. -dx11 -novid"); }
        }
        HorizontalLayout {
            spacing: 10px;
            Toggle { checked <=> root.replace-args; }
            Text { text: @tr("Remplacer les arguments du jeu"); color: Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 12px;
            Field { label: @tr("Résolution"); TextField { text <=> root.resolution; mono: true; placeholder: "1920x1080"; } }
            Field { label: @tr("Limite d'images/s"); TextField { text <=> root.fps; mono: true; placeholder: @tr("ex. 60"); } }
        }
        HorizontalLayout {
            spacing: 18px;
            alignment: start;
            Field {
                label: @tr("Affichage");
                Dropdown { prefix: ""; align-left: true; popup-width: 240px; options: [@tr("Réglage du jeu"), @tr("Fenêtré"), @tr("Plein écran"), @tr("Fenêtré sans bordure")]; selected <=> root.display; }
            }
            Field {
                label: @tr("Carte graphique");
                Dropdown { prefix: ""; align-left: true; popup-width: 280px; options: [@tr("Choix du système"), @tr("Haute performance (GPU dédié)"), @tr("Économie d'énergie (GPU intégré)")]; selected <=> root.gpu; }
            }
            Field {
                label: @tr("Priorité du processus");
                Dropdown { prefix: ""; align-left: true; popup-width: 240px; options: [@tr("Basse"), @tr("Inférieure à la normale"), @tr("Normale"), @tr("Supérieure à la normale"), @tr("Haute")]; selected <=> root.priority; }
            }
        }
        if DetailUi.is-windows && root.gpu != 0: HorizontalLayout {
            spacing: 10px;
            Toggle { checked <=> root.allow-gpu; }
            Text {
                text: @tr("Autoriser Halcyon à modifier temporairement la préférence graphique Windows de cet exécutable (rétablie après la session).");
                color: Theme.text-muted;
                font-size: Theme.t-caption;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        Field {
            label: @tr("Répertoire de travail");
            PathField { value <=> root.wd; folder: true; placeholder: @tr("Celui du jeu"); }
        }
        if DetailUi.mod-launch-labels.length > 1: Field {
            label: @tr("Mods au lancement");
            hint: @tr("Le profil de mods choisi est appliqué avant le lancement s'il n'est pas déjà en place.");
            HorizontalLayout {
                alignment: start;
                Dropdown { prefix: ""; align-left: true; popup-width: 260px; options: DetailUi.mod-launch-labels; selected <=> root.mod-profile; }
            }
        }
        if DetailUi.game.is-emulated && DetailUi.pad-profile-labels.length > 1: Field {
            label: @tr("Profil de manette");
            hint: @tr("Les options de manette de ce profil pour l'émulateur sont ajoutées à la ligne de commande (page Manettes).");
            HorizontalLayout {
                alignment: start;
                Dropdown { prefix: ""; align-left: true; popup-width: 260px; options: DetailUi.pad-profile-labels; selected <=> root.pad-profile; }
            }
        }
        Field {
            label: @tr("Variables d'environnement");
            hint: @tr("Une par ligne : NOM=valeur.");
            TextArea { text <=> root.env; height: 70px; }
        }
        HorizontalLayout {
            spacing: 12px;
            Field { label: @tr("Commande avant le lancement"); hint: @tr("Attendue (60 s max)."); TextField { text <=> root.pre; mono: true; } }
            Field { label: @tr("Commande après la session"); hint: @tr("Exécutée à la fin de la session."); TextField { text <=> root.post; mono: true; } }
        }
        Field {
            label: @tr("Programmes lancés avec le jeu");
            hint: @tr("Démarrés avant le jeu ; « fermer après » les arrête à la fin de la session (uniquement ceux démarrés par Halcyon).");
            for c[i] in DetailUi.edit-companions: HorizontalLayout {
                height: 34px;
                spacing: 8px;
                Text { text: c.path; color: Theme.text; font-size: Theme.t-caption; font-family: "monospace"; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: c.args; color: Theme.text-dim; font-size: Theme.t-caption; vertical-alignment: center; overflow: elide; }
                if c.close-after: Badge { y: 8px; text: @tr("fermé après"); }
                IconButton { size: 30px; icon-size: 15px; icon: Icons.trash; active-tint: Theme.danger; clicked => { DetailUi.remove-companion(i); } }
            }
            HorizontalLayout {
                spacing: 8px;
                PathField { value <=> root.comp-path; placeholder: @tr("Programme"); }
                TextField { width: 160px; text <=> root.comp-args; placeholder: @tr("Arguments"); mono: true; }
                Chip { y: 3px; text: @tr("Fermer après"); checked: root.comp-close; toggled => { root.comp-close = !root.comp-close; } }
                SecondaryButton {
                    text: @tr("Ajouter");
                    h: 36px;
                    enabled: root.comp-path != "";
                    clicked => { DetailUi.add-companion(root.comp-path, root.comp-args, root.comp-close); root.comp-path = ""; root.comp-args = ""; }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            SecondaryButton { text: @tr("Annuler"); clicked => { DetailUi.editing-open = false; } }
            PrimaryButton {
                text: @tr("Enregistrer le profil");
                icon: Icons.check;
                has-icon: true;
                enabled: root.name != "";
                clicked => {
                    DetailUi.save-profile(DetailUi.game.id, {
                        id: root.p.id, name: root.name, is-default: root.is-default, args: root.args,
                        replace-args: root.replace-args, resolution: root.resolution, display: root.display, fps: root.fps,
                        gpu: root.gpu, allow-gpu-registry: root.allow-gpu, priority: root.priority, working-dir: root.wd,
                        env: root.env, pre: root.pre, post: root.post, mod-profile: root.mod-profile,
                        pad-profile: root.pad-profile
                    });
                }
            }
        }
    }
}

component ProfilesTab inherits VerticalLayout {
    spacing: 14px;
    HorizontalLayout {
        SectionTitle { text: @tr("Profils de lancement"); horizontal-stretch: 1; }
        if !DetailUi.editing-open: SecondaryButton {
            text: @tr("Nouveau profil");
            icon: Icons.plus;
            has-icon: true;
            clicked => { DetailUi.new-profile(DetailUi.game.id); }
        }
    }
    Text {
        text: @tr("Plusieurs façons de lancer ce jeu (arguments, résolution, GPU, scripts…). Choisissez le profil à côté du bouton Jouer. Les fichiers du jeu ne sont jamais modifiés.");
        color: Theme.text-dim;
        font-size: Theme.t-small;
        wrap: word-wrap;
    }
    if DetailUi.profile-notes.length > 0: Notice {
        warning: true;
        text: @tr("Remarques sur ce profil pour ce jeu (réglages limités par le mode de lancement) :");
    }
    for n in DetailUi.profile-notes: Text { text: "• " + n; color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; }
    if DetailUi.editing-open: ProfileEditor { p: DetailUi.editing; }
    if !DetailUi.editing-open && DetailUi.profiles.length == 0: Text {
        text: @tr("Aucun profil : le jeu se lance avec ses paramètres habituels.");
        color: Theme.text-muted;
        font-size: Theme.t-small;
    }
    if !DetailUi.editing-open: VerticalLayout {
        spacing: 8px;
        for p in DetailUi.profiles: Rectangle {
            height: 60px;
            border-radius: Theme.radius;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: p.name; color: Theme.text; font-size: Theme.t-body; font-weight: 650; }
                        if p.is-default: Badge { text: @tr("Par défaut"); tint: Theme.accent; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: p.summary; color: Theme.text-dim; font-size: Theme.t-caption; overflow: elide; }
                }
                IconButton { y: (parent.height - self.height) / 2; icon: Icons.play; tooltip: @tr("Lancer avec ce profil"); clicked => { DetailUi.play-with(DetailUi.game.id, p.id); } }
                IconButton { y: (parent.height - self.height) / 2; icon: Icons.edit; tooltip: @tr("Modifier"); clicked => { DetailUi.edit-profile(p.id); } }
                IconButton { y: (parent.height - self.height) / 2; icon: Icons.trash; active-tint: Theme.danger; tooltip: @tr("Supprimer"); clicked => { DetailUi.delete-profile(p.id); } }
            }
        }
    }
}


component SavesTab inherits VerticalLayout {
    in-out property <string> new-path;
    in-out property <string> note;
    spacing: 16px;

    HorizontalLayout {
        SectionTitle { text: @tr("Sauvegardes"); horizontal-stretch: 1; }
        if DetailUi.save-busy: Text { text: @tr("Analyse…"); color: Theme.text-dim; font-size: Theme.t-caption; vertical-alignment: center; }
    }
    Text {
        text: @tr("Halcyon conserve des copies versionnées de vos sauvegardes, avant et après chaque session. Une restauration crée toujours d'abord une copie de l'état actuel.");
        color: Theme.text-dim;
        font-size: Theme.t-small;
        wrap: word-wrap;
    }

    if DetailUi.save-state > 0: Notice {
        warning: DetailUi.save-state >= 3;
        text: DetailUi.save-state-text;
    }
    if DetailUi.save-state == 0: Notice { text: DetailUi.save-state-text; }
    if DetailUi.save-state == 3 || DetailUi.save-state == 4: HorizontalLayout {
        spacing: 10px;
        alignment: start;
        PrimaryButton { text: @tr("Restaurer la version de l'autre PC"); icon: Icons.restore; has-icon: true; clicked => { DetailUi.save-restore-remote(DetailUi.game.id); } }
        if DetailUi.save-state == 4: SecondaryButton { text: @tr("Garder la version de ce PC"); clicked => { DetailUi.save-keep-local(DetailUi.game.id); } }
    }

    SectionTitle { text: @tr("Emplacements"); }
    for l[i] in DetailUi.save-locs: Rectangle {
        height: 48px;
        border-radius: Theme.radius;
        background: Theme.surface;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 10px;
            Icon { source: Icons.folder; size: 16px; tint: l.exists ? Theme.accent : Theme.warm; y: (parent.height - self.height) / 2; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: l.path; color: Theme.text; font-size: Theme.t-caption; font-family: "monospace"; overflow: elide; }
                if !l.exists: Text { text: @tr("Introuvable pour l'instant (le jeu n'a peut-être pas encore sauvegardé)"); color: Theme.warm; font-size: Theme.t-overline; }
            }
            IconButton { y: (parent.height - self.height) / 2; icon: Icons.folder; tooltip: @tr("Ouvrir"); clicked => { Actions.open-folder(l.path); } }
            IconButton { y: (parent.height - self.height) / 2; icon: Icons.trash; active-tint: Theme.danger; tooltip: @tr("Retirer (les fichiers ne sont pas supprimés)"); clicked => { DetailUi.save-remove-location(DetailUi.game.id, i); } }
        }
    }
    if DetailUi.save-cands.length > 0: Text { text: @tr("Emplacements détectés"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
    for c[i] in DetailUi.save-cands: Rectangle {
        height: 48px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: c.reason + (c.confident ? "" : @tr(", correspondance approximative")); color: Theme.text; font-size: Theme.t-caption; font-weight: 600; overflow: elide; }
                Text { text: c.path; color: Theme.text-dim; font-size: Theme.t-overline; font-family: "monospace"; overflow: elide; }
            }
            SecondaryButton { y: (parent.height - self.height) / 2; h: 32px; text: @tr("Associer"); clicked => { DetailUi.save-associate(DetailUi.game.id, i); } }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        PathField { value <=> root.new-path; folder: true; placeholder: @tr("Ajouter un dossier ou fichier de sauvegarde"); }
        SecondaryButton { text: @tr("Ajouter"); h: 36px; enabled: root.new-path != ""; clicked => { DetailUi.save-add-location(DetailUi.game.id, root.new-path); root.new-path = ""; } }
    }
    HorizontalLayout {
        spacing: 22px;
        alignment: start;
        HorizontalLayout {
            spacing: 10px;
            Toggle { checked <=> DetailUi.save-auto-before; toggled(v) => { DetailUi.save-set-auto(DetailUi.game.id, v, DetailUi.save-auto-after); } }
            Text { text: @tr("Avant chaque session"); color: Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 10px;
            Toggle { checked <=> DetailUi.save-auto-after; toggled(v) => { DetailUi.save-set-auto(DetailUi.game.id, DetailUi.save-auto-before, v); } }
            Text { text: @tr("Après chaque session"); color: Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; }
        }
    }
    Text { text: DetailUi.save-root; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }

    if DetailUi.save-locs.length > 0: HorizontalLayout {
        spacing: 8px;
        TextField { text <=> root.note; placeholder: @tr("Note facultative (ex. avant le boss final)"); }
        PrimaryButton {
            text: @tr("Sauvegarder maintenant");
            icon: Icons.save;
            has-icon: true;
            enabled: !DetailUi.save-busy;
            clicked => { DetailUi.save-now(DetailUi.game.id, root.note); root.note = ""; }
        }
    }

    if DetailUi.snapshots.length > 0: SectionTitle { text: @tr("Historique ({})", DetailUi.snapshots.length); }
    for sn in DetailUi.snapshots: Rectangle {
        height: 58px;
        border-radius: Theme.radius;
        background: Theme.surface;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: sn.date; color: Theme.text; font-size: Theme.t-small; font-weight: 650; }
                    Badge { text: sn.reason; }
                    if sn.other-machine: Badge { text: sn.machine; tint: Theme.warm; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: @tr("{n} fichier, {}" | "{n} fichiers, {}" % sn.files, sn.size) + (sn.note != "" ? ", " + sn.note : "") + (sn.other-machine ? "" : ", " + sn.machine);
                    color: Theme.text-dim;
                    font-size: Theme.t-caption;
                    overflow: elide;
                }
            }
            IconButton { y: (parent.height - self.height) / 2; icon: Icons.compare; tooltip: @tr("Comparer avec les fichiers actuels"); clicked => { DetailUi.save-compare(DetailUi.game.id, sn.id); } }
            IconButton { y: (parent.height - self.height) / 2; icon: Icons.restore; tooltip: @tr("Restaurer"); clicked => { DetailUi.save-restore(DetailUi.game.id, sn.id); } }
            IconButton { y: (parent.height - self.height) / 2; icon: Icons.trash; active-tint: Theme.danger; tooltip: @tr("Supprimer"); clicked => { DetailUi.save-delete(DetailUi.game.id, sn.id); } }
        }
    }
    if DetailUi.save-diff-title != "": Panel {
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text { text: DetailUi.save-diff-title; color: Theme.text; font-size: Theme.t-small; font-weight: 650; wrap: word-wrap; }
            for line in DetailUi.save-diff: Text {
                text: line;
                color: Theme.text-muted;
                font-size: Theme.t-caption;
                font-family: "monospace";
                overflow: elide;
            }
        }
    }
}

component ModsTab inherits VerticalLayout {
    in-out property <string> import-path;
    in-out property <string> import-name;
    in-out property <string> new-profile;
    in-out property <string> editing-id;
    in-out property <string> edit-version;
    in-out property <string> edit-nexus;
    spacing: 16px;

    SectionTitle { text: @tr("Mods"); }
    Notice {
        warning: true;
        text: @tr("Les mods modifient les fichiers du jeu : évitez-les dans les jeux en ligne protégés par un anti-triche. Halcyon met de côté chaque fichier remplacé et peut tout retirer.");
    }
    if DetailUi.workshop.length > 0: VerticalLayout {
        spacing: 8px;
        Text {
            text: @tr("Steam Workshop : {n} objet installé" | "Steam Workshop : {n} objets installés" % DetailUi.workshop.length);
            color: Theme.text;
            font-size: Theme.t-body;
            font-weight: 600;
        }
        Text {
            text: @tr("Gérés par Steam : abonnez-vous ou désabonnez-vous dans le Workshop, Steam les installe et les met à jour.");
            color: Theme.text-dim;
            font-size: Theme.t-caption;
            wrap: word-wrap;
        }
        for w in DetailUi.workshop: Rectangle {
            height: 46px;
            border-radius: Theme.radius-sm + 2px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 6px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text { text: w.title; color: Theme.text; font-size: Theme.t-small; overflow: elide; }
                    Text { text: w.detail; color: Theme.text-dim; font-size: Theme.t-caption; overflow: elide; }
                }
                TextButton {
                    y: (parent.height - self.height) / 2;
                    text: @tr("Page du Workshop");
                    clicked => { Actions.open-url(w.url); }
                }
            }
        }
    }
    if !DetailUi.mod-available: Text { text: @tr("Dossier d'installation introuvable : les mods sont indisponibles pour ce jeu."); color: Theme.text-dim; font-size: Theme.t-small; }

    if DetailUi.mod-available: VerticalLayout {
        spacing: 16px;
        HorizontalLayout {
            spacing: 14px;
            alignment: start;
            Field {
                label: @tr("Méthode d'installation");
                Dropdown {
                    prefix: "";
                    align-left: true;
                    popup-width: 260px;
                    options: [@tr("Copie dans le dossier du jeu"), @tr("BepInEx (Unity)"), @tr("Paquets Unreal (.pak)")];
                    selected <=> DetailUi.mod-adapter;
                    changed(i) => { DetailUi.mod-set-adapter(DetailUi.game.id, i, i == 1 ? "" : DetailUi.mod-target); }
                }
            }
            if DetailUi.mod-adapter != 1: Field {
                label: DetailUi.mod-adapter == 2 ? @tr("Dossier Content/Paks") : @tr("Sous-dossier cible (facultatif)");
                HorizontalLayout {
                    spacing: 8px;
                    TextField { width: 260px; text <=> DetailUi.mod-target; mono: true; placeholder: DetailUi.mod-adapter == 2 ? @tr("MonJeu/Content/Paks") : @tr("ex. data"); }
                    SecondaryButton { h: 36px; text: @tr("Appliquer"); clicked => { DetailUi.mod-set-adapter(DetailUi.game.id, DetailUi.mod-adapter, DetailUi.mod-target); } }
                }
            }
        }
        if DetailUi.mod-hint != "": Text { text: DetailUi.mod-hint; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Dropdown {
                prefix: @tr("Profil :");
                align-left: true;
                popup-width: 240px;
                options: DetailUi.mod-profile-labels;
                selected <=> DetailUi.mod-profile;
                changed(i) => { DetailUi.mod-select-profile(DetailUi.game.id, i); }
            }
            TextField { width: 220px; text <=> root.new-profile; placeholder: @tr("Nouveau profil (ex. Vanilla+)"); }
            SecondaryButton { h: 34px; text: @tr("Créer"); enabled: root.new-profile != ""; clicked => { DetailUi.mod-new-profile(DetailUi.game.id, root.new-profile); root.new-profile = ""; } }
            SecondaryButton { h: 34px; text: @tr("Supprimer le profil"); clicked => { DetailUi.mod-delete-profile(DetailUi.game.id); } }
        }

        Text { text: DetailUi.mods.length == 0 ? @tr("Aucun mod dans la bibliothèque de ce jeu : importez une archive .zip ou un dossier.") : @tr("Ordre de chargement : en cas de conflit, le mod le plus bas l'emporte."); color: Theme.text-dim; font-size: Theme.t-caption; }
        for m[i] in DetailUi.mods: VerticalLayout {
            spacing: 6px;
            Rectangle {
                height: 54px;
                border-radius: Theme.radius;
                background: Theme.surface;
                border-width: m.conflicts > 0 && m.enabled ? 1px : 0px;
                border-color: Theme.warm.with-alpha(0.5);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 6px;
                    spacing: 10px;
                    Toggle { y: (parent.height - self.height) / 2; checked: m.enabled; toggled => { DetailUi.mod-toggle(DetailUi.game.id, m.id); } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: (i + 1) + ". " + m.name; color: Theme.text; font-size: Theme.t-small; font-weight: 650; overflow: elide; }
                            if m.version != "": Badge { text: "v" + m.version; }
                            if m.latest != "": Badge { text: @tr("v{} disponible", m.latest); tint: Theme.accent; solid: true; }
                            if m.deployed: Badge { text: @tr("Installé"); tint: Theme.success; }
                            if m.conflicts > 0 && m.enabled: Badge { text: @tr("{n} conflit" | "{n} conflits" % m.conflicts); tint: Theme.warm; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text { text: @tr("{n} fichier, {}" | "{n} fichiers, {}" % m.files, m.size) + (m.nexus-id != "" ? @tr(", Nexus {}", m.nexus-id) : ""); color: Theme.text-dim; font-size: Theme.t-overline; }
                    }
                    IconButton { y: (parent.height - self.height) / 2; size: 32px; icon: Icons.chevron-down; tooltip: @tr("Descendre"); clicked => { DetailUi.mod-move(DetailUi.game.id, m.id, 1); } }
                    IconButton { y: (parent.height - self.height) / 2; size: 32px; icon: Icons.chevron-up; tooltip: @tr("Monter"); clicked => { DetailUi.mod-move(DetailUi.game.id, m.id, -1); } }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 32px;
                        icon: Icons.edit;
                        tooltip: @tr("Version et identifiant Nexus");
                        clicked => {
                            root.editing-id = root.editing-id == m.id ? "" : m.id;
                            root.edit-version = m.version;
                            root.edit-nexus = m.nexus-id;
                        }
                    }
                    IconButton { y: (parent.height - self.height) / 2; size: 32px; icon: Icons.trash; active-tint: Theme.danger; tooltip: @tr("Supprimer de la bibliothèque"); clicked => { DetailUi.mod-delete(DetailUi.game.id, m.id); } }
                }
            }
            if root.editing-id == m.id: HorizontalLayout {
                spacing: 8px;
                padding-left: 12px;
                TextField { width: 160px; text <=> root.edit-version; placeholder: @tr("Version"); }
                TextField { width: 200px; text <=> root.edit-nexus; placeholder: @tr("ID Nexus Mods"); mono: true; }
                SecondaryButton { h: 36px; text: @tr("Enregistrer"); clicked => { DetailUi.mod-save-info(DetailUi.game.id, m.id, root.edit-version, root.edit-nexus); root.editing-id = ""; } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            PathField { value <=> root.import-path; placeholder: @tr("Archive .zip ou dossier du mod"); }
            TextField { width: 200px; text <=> root.import-name; placeholder: @tr("Nom (facultatif)"); }
            SecondaryButton { h: 36px; text: @tr("Importer"); icon: Icons.plus; has-icon: true; enabled: root.import-path != ""; clicked => { DetailUi.mod-import(DetailUi.game.id, root.import-path, root.import-name); root.import-path = ""; root.import-name = ""; } }
        }

        Panel {
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { text: DetailUi.mod-status; color: Theme.text-muted; font-size: Theme.t-small; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    PrimaryButton { text: @tr("Appliquer le profil au jeu"); icon: Icons.check; has-icon: true; clicked => { DetailUi.mod-deploy(DetailUi.game.id); } }
                    SecondaryButton { text: @tr("Retirer tous les mods"); clicked => { DetailUi.mod-undeploy(DetailUi.game.id); } }
                }
            }
        }

        if DetailUi.mod-conflicts.length > 0: Text { text: @tr("Conflits"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        for c in DetailUi.mod-conflicts: Text { text: "• " + c; color: Theme.warm; font-size: Theme.t-caption; wrap: word-wrap; }
        if DetailUi.mod-external.length > 0: Text { text: @tr("Fichiers de mods présents mais non installés par Halcyon (laissés tels quels)"); color: Theme.text-muted; font-size: Theme.t-caption; font-weight: 600; }
        for e in DetailUi.mod-external: Text { text: e; color: Theme.text-dim; font-size: Theme.t-caption; font-family: "monospace"; }

        HorizontalLayout {
            spacing: 8px;
            TextField { width: 280px; text <=> DetailUi.mod-nexus-domain; placeholder: @tr("Jeu sur Nexus (ex. stardewvalley)"); mono: true; }
            SecondaryButton { h: 36px; text: @tr("Vérifier les versions sur Nexus Mods"); icon: Icons.refresh; has-icon: true; clicked => { DetailUi.mod-check(DetailUi.game.id, DetailUi.mod-nexus-domain); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

component Overview inherits VerticalLayout {
    in-out property <string> new-collection;
    spacing: 14px;
    Rubric { title: @tr("À propos"); }
    Text {
        text: DetailUi.game.description != "" ? DetailUi.game.description : @tr("Aucune description disponible pour ce jeu.");
        color: DetailUi.game.description != "" ? Theme.text.mix(Theme.text-muted, 0.4) : Theme.text-dim;
        font-size: Theme.t-body;
        wrap: word-wrap;
    }
    if DetailUi.game.genres != "": Text {
        text: @tr("Genres : {}", DetailUi.game.genres);
        color: Theme.text-muted;
        font-size: Theme.t-small;
    }

    if DetailUi.screenshots.length > 0: Rectangle { height: 14px; }
    if DetailUi.screenshots.length > 0: Rubric { title: @tr("Captures d'écran"); }
    if DetailUi.screenshots.length > 0: Rectangle {
        height: 150px;
        property <length> w: 240px;
        for shot[i] in DetailUi.screenshots: Rectangle {
            x: i * (parent.w + 12px);
            width: parent.w;
            height: 135px;
            visible: (i + 1) * (parent.w + 12px) <= parent.width + 12px;
            border-radius: Theme.radius-sm;
            clip: true;
            background: Theme.surface;
            Image {
                width: parent.width;
                height: parent.height;
                source: shot;
                image-fit: cover;
            }
        }
    }

    if DetailUi.req-rows.length > 0 || DetailUi.req-status != "": Rectangle { height: 14px; }
    if DetailUi.req-rows.length > 0 || DetailUi.req-status != "": Rubric { title: @tr("Configuration requise"); }
    if DetailUi.req-status != "": Text { text: DetailUi.req-status; color: Theme.text-dim; font-size: Theme.t-small; }
    if DetailUi.req-rows.length > 0: HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: DetailUi.req-level == 1 ? Theme.danger : DetailUi.req-level == 2 ? Theme.warm : DetailUi.req-level == 3 ? Theme.success : Theme.text-dim;
        }
        Text { text: DetailUi.req-verdict; color: Theme.text; font-size: Theme.t-body; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
    }
    if DetailUi.req-rows.length > 0: VerticalLayout {
        spacing: 0;
        HorizontalLayout {
            spacing: 16px;
            padding-bottom: 6px;
            Rectangle { width: 120px; }
            Text { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; text: @tr("Minimale"); color: Theme.text-dim; font-size: Theme.t-overline; font-weight: 600; }
            Text { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; text: @tr("Recommandée"); color: Theme.text-dim; font-size: Theme.t-overline; font-weight: 600; }
            Text { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; text: @tr("Ce PC"); color: Theme.text-dim; font-size: Theme.t-overline; font-weight: 600; }
        }
        for r in DetailUi.req-rows: Rectangle {
            height: req-line.preferred-height;
            Rectangle { y: 0; height: 1px; background: Theme.border; }
            req-line := HorizontalLayout {
                spacing: 16px;
                padding-top: 9px;
                padding-bottom: 9px;
                Text { width: 120px; text: r.label; color: Theme.text-muted; font-size: Theme.t-small; font-weight: 600; wrap: word-wrap; }
                Text { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; text: r.minimum != "" ? r.minimum : "—"; color: Theme.text; font-size: Theme.t-small; wrap: word-wrap; }
                Text { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; text: r.recommended != "" ? r.recommended : "—"; color: Theme.text; font-size: Theme.t-small; wrap: word-wrap; }
                HorizontalLayout {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                    spacing: 8px;
                    if r.level > 0: Rectangle {
                        width: 8px;
                        height: 8px;
                        y: 6px;
                        border-radius: 4px;
                        background: r.level == 1 ? Theme.danger : r.level == 2 ? Theme.warm : Theme.success;
                    }
                    Text { horizontal-stretch: 1; text: r.yours != "" ? r.yours : "—"; color: r.level == 1 ? Theme.danger : Theme.text; font-size: Theme.t-small; wrap: word-wrap; }
                }
            }
        }
    }
    if DetailUi.req-note != "": Text { text: DetailUi.req-note; color: Theme.text-dim; font-size: Theme.t-caption; wrap: word-wrap; }

    if DetailUi.news.length > 0 || DetailUi.news-status != "": Rectangle { height: 14px; }
    if DetailUi.news.length > 0 || DetailUi.news-status != "": Rubric { title: @tr("Actualités"); }
    if DetailUi.news-status != "": Text { text: DetailUi.news-status; color: Theme.text-dim; font-size: Theme.t-small; }
    for n in DetailUi.news: Rectangle {
        height: news-col.preferred-height;
        border-radius: Theme.radius-sm;
        background: news-touch.has-hover ? Theme.surface : transparent;
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        news-touch := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-url(n.url); } }
        news-col := VerticalLayout {
            padding-top: 12px;
            padding-bottom: 14px;
            padding-left: 2px;
            spacing: 4px;
            Text { text: n.title; color: news-touch.has-hover ? Theme.accent : Theme.text; font-size: Theme.t-body; font-weight: 600; wrap: word-wrap; }
            Text { text: n.meta; color: Theme.text-dim; font-size: Theme.t-overline; }
            if n.excerpt != "": Text { text: n.excerpt; color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; }
        }
    }

    Rectangle { height: 14px; }
    Rubric { title: @tr("Collections"); }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for c in DetailUi.collections: Chip {
            text: c.name;
            checked: c.member;
            toggled => { DetailUi.toggle-collection(DetailUi.game.id, c.id); }
        }
        if DetailUi.collections.length == 0: Text {
            text: @tr("Aucune collection pour l'instant.");
            color: Theme.text-dim;
            font-size: Theme.t-small;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        TextField {
            width: 280px;
            text <=> root.new-collection;
            placeholder: @tr("Nouvelle collection (ex. Coop, À finir)");
            accepted(t) => {
                DetailUi.create-collection(DetailUi.game.id, t);
                root.new-collection = "";
            }
        }
        SecondaryButton {
            text: @tr("Créer et ajouter");
            icon: Icons.plus;
            has-icon: true;
            enabled: root.new-collection != "";
            clicked => {
                DetailUi.create-collection(DetailUi.game.id, root.new-collection);
                root.new-collection = "";
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

/// Captures : visuels du jeu (métadonnées) et captures locales (Steam, F12).
component CapturesTab inherits VerticalLayout {
    spacing: 16px;
    property <int> per-row: max(1, floor((self.width + 12px) / (300px + 12px)));
    property <length> tw: (self.width - (self.per-row - 1) * 12px) / self.per-row;
    if DetailUi.captures.length > 0: SectionTitle { text: @tr("Vos captures ({})", DetailUi.captures.length); }
    if DetailUi.captures.length > 0: Rectangle {
        height: ceil(DetailUi.captures.length / root.per-row) * (root.tw * 9 / 16 + 12px);
        for c[i] in DetailUi.captures: Rectangle {
            x: mod(i, root.per-row) * (root.tw + 12px);
            y: floor(i / root.per-row) * (root.tw * 9 / 16 + 12px);
            width: root.tw;
            height: root.tw * 9 / 16;
            border-radius: Theme.radius-cover;
            clip: true;
            background: Theme.surface;
            Image { width: parent.width; height: parent.height; source: c.image; image-fit: cover; }
            Rectangle {
                y: parent.height - 26px;
                height: 26px;
                background: Theme.scrim;
                opacity: lc-ta.has-hover ? 1 : 0;
                Text { x: 10px; text: c.date; color: #fff; font-size: Theme.t-caption; vertical-alignment: center; }
            }
            lc-ta := TouchArea { mouse-cursor: pointer; clicked => { DetailUi.open-capture(i); } }
        }
    }
    if DetailUi.screenshots.length > 0: SectionTitle { text: @tr("Visuels officiels"); }
    if DetailUi.screenshots.length > 0: Rectangle {
        height: ceil(DetailUi.screenshots.length / root.per-row) * (root.tw * 9 / 16 + 12px);
        for shot[i] in DetailUi.screenshots: Rectangle {
            x: mod(i, root.per-row) * (root.tw + 12px);
            y: floor(i / root.per-row) * (root.tw * 9 / 16 + 12px);
            width: root.tw;
            height: root.tw * 9 / 16;
            border-radius: Theme.radius-sm;
            clip: true;
            background: Theme.surface;
            Image { width: parent.width; height: parent.height; source: shot; image-fit: cover; }
        }
    }
    Text {
        text: @tr("Les vidéos ne sont pas lues dans Halcyon. Les captures Steam sont lues dans le dossier de votre compte local, sans modification.");
        color: Theme.text-dim;
        font-size: Theme.t-caption;
        wrap: word-wrap;
    }
}

/// Fait de l'en-tête : valeur dans la police d'affichage, légende dessous.
component HeroStat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 3px;
    Text { text: root.value; color: Theme.text; font-family: Theme.display; font-size: Theme.t-subheading + 2px; font-weight: 700; overflow: elide; }
    Text { text: root.label; color: Theme.text-dim; font-size: Theme.t-caption; }
}

/// Groupe de la fiche technique (colonne de droite) : petit titre et lignes.
component FactGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;
    Overline { text: root.title; }
    @children
}

export component GamePage inherits Rectangle {
    /// Bande illustrée en tête de fiche : hauteur bornée.
    property <length> band-height: clamp(root.height * 0.36, 220px, 360px);
    property <bool> wide: root.width > 1100px;
    property <length> cover-w: root.wide ? 188px : 132px;
    property <bool> has-ach: DetailUi.ach-mode != "unsupported";
    property <bool> has-captures: DetailUi.captures.length > 0 || DetailUi.screenshots.length > 0;
    // Onglets : 0 Aperçu, 2 Succès, 3 Statistiques, 7 Captures, 5 Sauvegardes, 6 Mods,
    // 1 Paramètres (lancement, profils, informations). L'ancien onglet 4 (profils) y mène.
    property <int> tab: DetailUi.tab == 4 ? 1 : (DetailUi.tab == 2 && !root.has-ach) || (DetailUi.tab == 7 && !root.has-captures) ? 0 : DetailUi.tab;
    property <bool> slideshow: DetailUi.slides.length >= 2;
    property <duration> slide-time: 8s;
    // La bande est visible (défilement) : sinon, plus d'animation.
    property <bool> band-visible: sv.content-y > -root.band-height;

    sv := ScrollView {
        content-height: content.preferred-height;
        scrolled => { AppUi.top-solid = self.content-y < -(root.band-height - 60px); }
        content := VerticalLayout {
            width: root.width;

            // En-tête : bande illustrée nette, jaquette qui chevauche son bord, titre dessous.
            Rectangle {
                height: root.band-height + head.preferred-height + 24px;
                band := Rectangle {
                    y: 0;
                    height: root.band-height;
                    clip: true;
                    background: DetailUi.game.color-a.mix(#101215, 0.45);
                    if DetailUi.game.has-banner && !root.slideshow: Image {
                        width: parent.width;
                        height: parent.height;
                        source: DetailUi.game.banner;
                        image-fit: cover;
                    }
                    // Bannière animée : fondu d'une image à l'autre et lent travelling (8 s
                    // par image). Arrêtée quand la bande sort de l'écran.
                    if root.slideshow: Rectangle {
                        property <int> n: DetailUi.slides.length;
                        property <float> phase: root.band-visible ? animation-tick() / root.slide-time : 0;
                        property <int> cur: mod(floor(self.phase), self.n);
                        property <int> prev: mod(self.cur - 1 + self.n, self.n);
                        property <float> p: Theme.motion == 0 ? self.phase - floor(self.phase) : 0;
                        for img[i] in DetailUi.slides: Image {
                            property <float> t: i == parent.cur ? parent.p : 1;
                            property <float> zoom: Theme.motion == 0 ? 1.04 + 0.08 * self.t : 1;
                            visible: i == parent.cur || i == parent.prev;
                            width: parent.width * self.zoom;
                            height: parent.height * self.zoom;
                            x: -(self.width - parent.width) * (mod(i, 2) == 0 ? self.t : 1 - self.t);
                            y: -(self.height - parent.height) / 2;
                            source: img;
                            image-fit: cover;
                            opacity: i == parent.cur ? 1 : 0;
                            animate opacity { duration: Theme.motion < 2 ? 1400ms : 0ms; easing: ease-in-out; }
                        }
                    }
                    if !DetailUi.game.has-banner && !root.slideshow: Image {
                        width: parent.width;
                        height: parent.height;
                        source: DetailUi.ambient;
                        image-fit: cover;
                        image-rendering: smooth;
                        opacity: 0.7;
                    }
                    // Badges d'état posés sur la bande, en bas à droite.
                    HorizontalLayout {
                        x: parent.width - self.preferred-width - Theme.page-padding;
                        y: parent.height - 34px;
                        height: 22px;
                        spacing: 6px;
                        Rectangle {
                            width: st.preferred-width + 14px;
                            background: #000000b8;
                            border-radius: Theme.radius-sm;
                            st := Text { text: DetailUi.game.install-state; color: DetailUi.game.installed ? Theme.success.brighter(0.3) : #ffffffc0; font-size: Theme.t-overline; font-weight: 600; }
                        }
                        if DetailUi.game.update-pending: Rectangle {
                            width: up.preferred-width + 14px;
                            background: #000000b8;
                            border-radius: Theme.radius-sm;
                            up := Text { text: DetailUi.game.update-state; color: Theme.warm; font-size: Theme.t-overline; font-weight: 600; }
                        }
                        if DetailUi.game.hidden: Rectangle {
                            width: hd.preferred-width + 14px;
                            background: #000000b8;
                            border-radius: Theme.radius-sm;
                            hd := Text { text: @tr("Masqué"); color: #ffffffc0; font-size: Theme.t-overline; font-weight: 600; }
                        }
                    }
                }
                jacket := GameCover {
                    x: Theme.page-padding;
                    y: root.band-height - self.height * 0.55;
                    width: root.cover-w;
                    height: root.cover-w * 1.5;
                    source: DetailUi.game.cover;
                    has-image: DetailUi.game.has-cover;
                    color-a: DetailUi.game.color-a;
                    color-b: DetailUi.game.color-b;
                    initials: DetailUi.game.initials;
                    title: DetailUi.game.title;
                    drop-shadow-blur: Theme.effects ? 24px : 0px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #00000090;
                }
                head := VerticalLayout {
                    x: Theme.page-padding + root.cover-w + 32px;
                    y: root.band-height + 20px;
                    width: root.width - self.x - Theme.page-padding;
                    height: self.preferred-height;
                    spacing: 10px;
                    // Source et plateforme, en texte : la provenance n'a pas besoin de boîte.
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text { text: DetailUi.game.source; color: Theme.accent; font-size: Theme.t-small; font-weight: 600; }
                        if DetailUi.game.platform != "": Text { text: DetailUi.game.platform; color: Theme.text-muted; font-size: Theme.t-small; font-weight: 600; }
                    }
                    if DetailUi.game.has-logo: Image {
                        height: min(96px, root.band-height * 0.3);
                        source: DetailUi.game.logo;
                        image-fit: contain;
                        horizontal-alignment: left;
                        vertical-alignment: bottom;
                    }
                    if !DetailUi.game.has-logo: Text {
                        text: DetailUi.game.title;
                        color: Theme.text;
                        font-family: Theme.display;
                        font-size: root.wide ? Theme.t-display - 6px : Theme.t-title;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    if DetailUi.game.developer != "" || DetailUi.game.genres != "": HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        if DetailUi.game.developer != "": Text { text: DetailUi.game.developer; color: Theme.text-muted; font-size: Theme.t-body; overflow: elide; }
                        if DetailUi.game.genres != "": Text { text: DetailUi.game.genres; color: Theme.text-dim; font-size: Theme.t-body; overflow: elide; }
                    }
                    // Actions à gauche, chiffres réels à droite (une valeur inconnue s'affiche « — »).
                    HorizontalLayout {
                        padding-top: 12px;
                        spacing: 8px;
                        PlayButton {
                            big: true;
                            text: DetailUi.game.installed ? @tr("Jouer") : DetailUi.game.can-install ? @tr("Installer via Steam") : @tr("Non installé");
                            enabled: DetailUi.game.installed || DetailUi.game.can-install;
                            clicked => { DetailUi.play-with(DetailUi.game.id, -1); }
                        }
                        if DetailUi.game.installed && DetailUi.profiles.length > 0: Dropdown {
                            y: 8px;
                            prefix: @tr("Profil");
                            align-left: true;
                            popup-width: 240px;
                            options: DetailUi.profile-labels;
                            selected <=> DetailUi.profile-index;
                        }
                        Rectangle { width: 4px; }
                        IconButton {
                            y: 3px;
                            size: 42px;
                            icon-size: 19px;
                            icon: DetailUi.game.favorite ? Icons.star-filled : Icons.star;
                            tint: DetailUi.game.favorite ? Theme.warm : Theme.text-muted;
                            active-tint: Theme.warm;
                            tooltip: DetailUi.game.favorite ? @tr("Retirer des favoris") : @tr("Ajouter aux favoris");
                            clicked => { Actions.toggle-favorite(DetailUi.game.id); }
                        }
                        IconButton {
                            y: 3px;
                            size: 42px;
                            icon-size: 19px;
                            icon: Icons.folder;
                            enabled: DetailUi.game.install-dir != "";
                            tooltip: DetailUi.game.install-dir != "" ? @tr("Ouvrir le dossier du jeu") : @tr("Aucun dossier connu");
                            clicked => { Actions.open-folder(DetailUi.game.install-dir); }
                        }
                        IconButton {
                            y: 3px;
                            size: 42px;
                            icon-size: 19px;
                            icon: Icons.more;
                            tooltip: @tr("Plus d'actions");
                            clicked => { GameMenu.request(DetailUi.game.id, self.absolute-position.x, self.absolute-position.y + 48px); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.width > 1180px: HorizontalLayout {
                            spacing: Theme.s6;
                            HeroStat { label: @tr("Temps de jeu"); value: DetailUi.game.playtime != "" ? DetailUi.game.playtime : "—"; }
                            HeroStat { label: @tr("Dernière session"); value: DetailUi.game.last-played != "" ? DetailUi.game.last-played : @tr("Jamais"); }
                            if DetailUi.ach-percent >= 0: HeroStat { label: @tr("Succès"); value: @tr("{} %", round(DetailUi.ach-percent * 100)); }
                        }
                    }
                }
            }

            // Onglets : seules les sections disponibles sont proposées.
            HorizontalLayout {
                padding-left: Theme.page-padding;
                padding-right: Theme.page-padding;
                padding-top: 8px;
                spacing: root.width < 1000px ? 18px : 28px;
                alignment: start;
                Tab { text: @tr("Aperçu"); selected: root.tab == 0; clicked => { DetailUi.tab = 0; } }
                if root.has-ach: Tab {
                    text: @tr("Succès");
                    badge: DetailUi.ach-percent >= 0 ? @tr("{} %", round(DetailUi.ach-percent * 100)) : "";
                    selected: root.tab == 2;
                    clicked => { DetailUi.tab = 2; }
                }
                Tab { text: @tr("Statistiques"); selected: root.tab == 3; clicked => { DetailUi.tab = 3; } }
                if root.has-captures: Tab {
                    text: @tr("Captures");
                    badge: DetailUi.captures.length > 0 ? DetailUi.captures.length : "";
                    selected: root.tab == 7;
                    clicked => { DetailUi.tab = 7; }
                }
                Tab {
                    text: @tr("Sauvegardes");
                    badge: DetailUi.snapshots.length > 0 ? DetailUi.snapshots.length : "";
                    selected: root.tab == 5;
                    clicked => { DetailUi.tab = 5; DetailUi.tools-refresh(); }
                }
                if !DetailUi.game.is-emulated: Tab {
                    text: @tr("Mods");
                    badge: DetailUi.mods.length > 0 ? DetailUi.mods.length : "";
                    selected: root.tab == 6;
                    clicked => { DetailUi.tab = 6; DetailUi.tools-refresh(); }
                }
                Tab {
                    text: root.width < 1100px ? @tr("Lancement") : @tr("Paramètres de lancement");
                    badge: DetailUi.profiles.length > 0 ? DetailUi.profiles.length : "";
                    selected: root.tab == 1;
                    clicked => { DetailUi.tab = 1; }
                }
            }
            HorizontalLayout {
                padding-left: Theme.page-padding;
                padding-right: Theme.page-padding;
                Rectangle { height: 1px; background: Theme.border; }
            }

            HorizontalLayout {
                padding: Theme.page-padding;
                padding-top: 32px;
                spacing: 48px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 32px;
                    alignment: start;
                    if root.tab == 0: Overview { }
                    if root.tab == 1 && !DetailUi.game.is-emulated: LaunchSettings { }
                    if root.tab == 1 && DetailUi.game.is-emulated: EmulationSettings { }
                    if root.tab == 1: ProfilesTab { }
                    if root.tab == 1: MetadataSettings { }
                    if root.tab == 2: AchievementsTab { }
                    if root.tab == 3: TrackingTab { }
                    if root.tab == 5: SavesTab { }
                    if root.tab == 6: ModsTab { }
                    if root.tab == 7: CapturesTab { }
                }

                // Fiche technique : sur l'aperçu seulement, pour laisser la place aux autres onglets.
                if root.tab == 0 && root.width > 900px: VerticalLayout {
                    width: 300px;
                    spacing: 28px;
                    alignment: start;
                    FactGroup {
                        title: @tr("Suivi");
                        InfoRow { label: @tr("Temps de jeu"); value: DetailUi.game.playtime + (DetailUi.game.playtime-origin != "" ? " (" + DetailUi.game.playtime-origin + ")" : ""); }
                        if DetailUi.game.status != 0: InfoRow { label: @tr("Statut"); value: ["", @tr("À jouer"), @tr("En cours"), @tr("Terminé"), @tr("Abandonné")][DetailUi.game.status]; }
                        InfoRow { label: @tr("Dernier lancement"); value: DetailUi.game.last-played; }
                        InfoRow { label: @tr("Sessions (Halcyon)"); value: DetailUi.game.sessions; }
                        if DetailUi.game.update-pending: InfoRow { label: @tr("Mise à jour"); value: DetailUi.game.update-state; }
                    }
                    FactGroup {
                        title: @tr("Installation");
                        InfoRow { label: @tr("Source"); value: DetailUi.game.source; }
                        if DetailUi.game.platform != "": InfoRow { label: @tr("Plateforme"); value: DetailUi.game.platform; }
                        InfoRow { label: @tr("Lancement"); value: DetailUi.game.launch-mode; }
                        InfoRow { label: @tr("Taille"); value: DetailUi.game.size; }
                        Text {
                            text: DetailUi.game.install-dir != "" ? DetailUi.game.install-dir : @tr("Emplacement inconnu");
                            color: Theme.text-dim;
                            font-size: Theme.t-caption;
                            wrap: word-wrap;
                        }
                    }
                    FactGroup {
                        title: @tr("Édition");
                        InfoRow { label: @tr("Développeur"); value: DetailUi.game.developer; }
                        InfoRow { label: @tr("Éditeur"); value: DetailUi.game.publisher; }
                        InfoRow { label: @tr("Sortie"); value: DetailUi.game.release; }
                    }
                    if DetailUi.links.length > 0: FactGroup {
                        title: @tr("Liens");
                        for l in DetailUi.links: HorizontalLayout {
                            alignment: start;
                            TextButton { text: l.label + " ↗"; clicked => { Actions.open-url(l.url); } }
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        SecondaryButton {
                            text: @tr("Créer un raccourci sur le Bureau");
                            icon: Icons.plus;
                            has-icon: true;
                            clicked => { SystemUi.create-shortcut(DetailUi.game.id); }
                        }
                        if DetailUi.can-publish: SecondaryButton {
                            text: @tr("Publier dans Sunshine…");
                            icon: Icons.monitor;
                            has-icon: true;
                            clicked => { DetailUi.publish-sunshine(DetailUi.game.id); }
                        }
                    }
                }
            }
        }
    }
}
