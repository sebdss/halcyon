// Statistiques : temps de jeu, sessions, sources, succès et jeux terminés.
//
// Composition « Berge » : le temps total est le chiffre-titre ; les autres chiffres forment
// une ligne de relevé ; les graphiques et listes sont des rubriques ouvertes par un filet.
// Chaque chiffre indique sa provenance.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Actions, StatsUi } from "../state.slint";
import { BarItem } from "../types.slint";
import { SectionTitle, BigStat, BarChart, MeterRow, Notice, GameCover, SecondaryButton, Rubric } from "../components.slint";

component ChartRubric inherits Rubric {
    in property <bool> empty;
    in property <string> empty-text;
    in property <[BarItem]> items;
    in property <color> bar-color: Theme.accent;
    horizontal-stretch: 1;
    Rectangle {
        height: 150px;
        BarChart { width: parent.width; height: parent.height; items: root.items; bar-color: root.bar-color; }
        if root.empty: Rectangle {
            background: Theme.bg;
            Text { x: 0; text: root.empty-text; color: Theme.text-dim; font-size: Theme.t-small; wrap: word-wrap; vertical-alignment: center; }
        }
    }
}

export component StatsPage inherits Rectangle {
    ScrollView {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.width;
            padding: Theme.page-padding;
            padding-top: 32px;
            spacing: 36px;
            alignment: start;

            // Chiffre-titre, provenance, exports.
            HorizontalLayout {
                spacing: 28px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    Text { text: StatsUi.total; color: Theme.text; font-family: Theme.display; font-size: Theme.t-display + 4px; font-weight: 800; }
                    Text { text: @tr("Temps de jeu total retenu. {}", StatsUi.total-detail); color: Theme.text-muted; font-size: Theme.t-small; wrap: word-wrap; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    SecondaryButton { text: @tr("Temps par jeu (CSV)"); icon: Icons.upload; has-icon: true; clicked => { StatsUi.export("csv-games"); } }
                    SecondaryButton { text: @tr("Sessions (CSV)"); icon: Icons.upload; has-icon: true; clicked => { StatsUi.export("csv-sessions"); } }
                    SecondaryButton { text: @tr("Tout (JSON)"); icon: Icons.upload; has-icon: true; clicked => { StatsUi.export("json"); } }
                }
            }

            HorizontalLayout {
                spacing: 44px;
                alignment: start;
                BigStat { value: StatsUi.games-played; label: @tr("jeux lancés au moins une fois"); }
                BigStat { value: StatsUi.sessions; label: @tr("sessions suivies"); }
                BigStat { value: StatsUi.avg-session; label: @tr("durée moyenne d'une session"); }
                BigStat { value: StatsUi.week-total; label: @tr("joué cette semaine"); }
                BigStat { value: @tr("{} j", StatsUi.streak); label: @tr("série de jours joués"); }
                BigStat { value: StatsUi.completed; label: @tr("jeux terminés"); }
            }

            if !StatsUi.has-local: Notice {
                text: @tr("Aucune session n'a encore été suivie par Halcyon. Les graphiques hebdomadaires et mensuels se remplissent à mesure que vous lancez vos jeux depuis Halcyon (y compris les jeux Steam et Epic, détectés pendant leur exécution).");
            }

            HorizontalLayout {
                spacing: Theme.s6;
                ChartRubric {
                    title: @tr("Par semaine");
                    note: @tr("suivi local, 12 semaines");
                    empty: !StatsUi.has-local;
                    empty-text: @tr("Pas encore de session suivie.");
                    items: StatsUi.weeks;
                }
                ChartRubric {
                    title: @tr("Par mois");
                    note: @tr("suivi local, 12 mois");
                    empty: !StatsUi.has-local;
                    empty-text: @tr("Pas encore de session suivie.");
                    items: StatsUi.months;
                }
            }

            HorizontalLayout {
                spacing: Theme.s6;
                Rubric {
                    horizontal-stretch: 3;
                    title: @tr("Jeux les plus joués");
                    if StatsUi.top.length == 0: Text { text: @tr("Aucun temps de jeu connu pour l'instant."); color: Theme.text-dim; font-size: Theme.t-small; }
                    for t[i] in StatsUi.top: Rectangle {
                        height: 54px;
                        border-radius: Theme.radius-sm;
                        background: ta.has-hover ? Theme.surface : transparent;
                        ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-game(t.id); } }
                        HorizontalLayout {
                            padding: 4px;
                            spacing: 14px;
                            // Rang, composé dans la police d'affichage.
                            Text { width: 22px; text: i + 1; color: Theme.text-dim; font-family: Theme.display; font-size: Theme.t-small; font-weight: 700; vertical-alignment: center; }
                            GameCover {
                                width: 30px;
                                height: 45px;
                                source: t.card.cover;
                                has-image: t.card.has-cover;
                                color-a: t.card.color-a;
                                color-b: t.card.color-b;
                                initials: t.card.initials;
                                title: t.title;
                                show-title: false;
                                corner: 2px;
                            }
                            MeterRow {
                                y: (parent.height - self.preferred-height) / 2;
                                label: t.title;
                                value: t.value + ", " + t.origin;
                                ratio: t.ratio;
                            }
                        }
                    }
                }
                Rubric {
                    horizontal-stretch: 2;
                    title: @tr("Par source");
                    for s in StatsUi.sources: MeterRow { label: s.label; value: s.value; ratio: s.ratio; }
                }
            }

            HorizontalLayout {
                spacing: Theme.s6;
                ChartRubric {
                    title: @tr("Succès débloqués");
                    note: @tr("données des plateformes, 12 mois");
                    items: StatsUi.unlocks;
                    bar-color: Theme.warm;
                }
                ChartRubric {
                    title: @tr("Jeux terminés");
                    note: @tr("statut « Terminé », 12 mois");
                    items: StatsUi.completions;
                    bar-color: Theme.success;
                }
            }

            Rubric {
                title: @tr("Sessions récentes");
                if StatsUi.recent.length == 0: Text { text: @tr("Aucune session suivie."); color: Theme.text-dim; font-size: Theme.t-small; }
                for r in StatsUi.recent: Rectangle {
                    height: 38px;
                    border-radius: Theme.radius-sm;
                    background: rta.has-hover ? Theme.surface : transparent;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    rta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-game(r.game-id); } }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 12px;
                        Text { text: r.game; color: Theme.text; font-size: Theme.t-small; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: r.date; color: Theme.text-dim; font-size: Theme.t-caption; vertical-alignment: center; width: 200px; }
                        Text { text: r.duration; color: Theme.text; font-family: Theme.display; font-size: Theme.t-caption; font-weight: 600; vertical-alignment: center; width: 90px; horizontal-alignment: right; }
                    }
                }
            }
        }
    }
}
