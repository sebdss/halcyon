import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { AssistUi, Actions } from "../state.slint";
import { SuggestRow } from "../types.slint";
import { SectionTitle, PageHeader, SecondaryButton, PrimaryButton, Chip, GameCover, Notice } from "../components.slint";

component SuggestList inherits VerticalLayout {
    in property <string> title;
    in property <string> empty;
    in property <[SuggestRow]> items;
    spacing: 14px;
    Rectangle { height: 1px; background: Theme.border-strong; }
    SectionTitle { text: root.title; }
    if root.items.length == 0: Text { text: root.empty; color: Theme.text-dim; font-size: Theme.t-small; }
    if root.items.length > 0: Flickable {
        height: 120px;
        content-width: row.preferred-width;
        row := HorizontalLayout {
            spacing: 28px;
            alignment: start;
            // Chaque suggestion : jaquette, titre, et la raison qui la justifie.
            for s in root.items: Rectangle {
                width: 260px;
                height: 120px;
                ta := TouchArea { mouse-cursor: pointer; clicked => { Actions.open-game(s.id); } double-clicked => { Actions.play(s.id); } }
                HorizontalLayout {
                    spacing: 14px;
                    GameCover {
                        width: 80px;
                        height: 120px;
                        source: s.card.cover;
                        has-image: s.card.has-cover;
                        color-a: s.card.color-a;
                        color-b: s.card.color-b;
                        initials: s.card.initials;
                        title: s.card.title;
                        show-title: false;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: s.card.title; color: ta.has-hover ? Theme.accent : Theme.text; font-size: Theme.t-small; font-weight: 650; wrap: word-wrap; max-height: 36px; overflow: elide; }
                        Text { text: s.reason; color: Theme.text-muted; font-size: Theme.t-caption; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

export component AssistantPage inherits Rectangle {
    ScrollView {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.width;
            padding: Theme.page-padding;
            padding-top: 28px;
            spacing: 32px;
            alignment: start;

            PageHeader {
                title: @tr("Que jouer ?");
                subtitle: @tr("Suggestions calculées sur ce PC à partir de vos données réelles : sessions, temps de jeu, statut, succès et genres préférés. Aucun service distant.");
                PrimaryButton { y: 6px; text: @tr("Surprends-moi"); icon: Icons.sparkle; has-icon: true; clicked => { AssistUi.surprise(); } }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: @tr("J'ai :"); color: Theme.text-muted; font-size: Theme.t-small; vertical-alignment: center; }
                for m[i] in [15, 30, 60, 120, 0]: Chip {
                    text: m == 0 ? @tr("Toute la soirée") : m < 60 ? @tr("{} min", m) : @tr("{} h", m / 60);
                    checked: AssistUi.minutes == m;
                    toggled => { AssistUi.minutes = m; AssistUi.refresh(); }
                }
            }
            if AssistUi.genres != "": Text { text: @tr("Vos genres les plus joués : {}", AssistUi.genres); color: Theme.text-dim; font-size: Theme.t-caption; }

            if AssistUi.minutes > 0: SuggestList {
                title: AssistUi.minutes < 60 ? @tr("Pour {n} minute" | "Pour {n} minutes" % AssistUi.minutes) : @tr("Pour {n} heure" | "Pour {n} heures" % AssistUi.minutes / 60);
                empty: @tr("Pas assez de sessions suivies pour estimer la durée de vos parties : lancez vos jeux depuis Halcyon pour affiner.");
                items: AssistUi.for-time;
            }
            SuggestList { title: @tr("À reprendre"); empty: @tr("Aucune partie en cours."); items: AssistUi.resume; }
            SuggestList { title: @tr("Presque terminés"); empty: @tr("Aucun jeu à plus de 70 % de ses succès."); items: AssistUi.almost-done; }
            SuggestList { title: @tr("À découvrir"); empty: @tr("Vous avez lancé tous vos jeux installés !"); items: AssistUi.discover; }
            SuggestList { title: @tr("À redécouvrir"); empty: @tr("Aucun jeu longuement joué puis délaissé."); items: AssistUi.rediscover; }
        }
    }
}
