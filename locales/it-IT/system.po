msgstr "Attiva la modalità prestazioni all'avvio di un gioco da Halcyon e ripristina tutto alla sua chiusura."

#: crates/halcyon-app/ui/pages/appearance.slint:186
msgid "Fond d'écran"
msgstr "Sfondo"

#: crates/halcyon-app/ui/pages/appearance.slint:193
msgid "Image (.jpg, .png, .webp) affichée en fond, assombrie"
msgstr "Immagine (.jpg, .png, .webp) mostrata sullo sfondo, scurita"

