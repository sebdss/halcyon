#: crates/halcyon-app/ui/pages/appearance.slint:37
msgid "Thème, couleurs, fond, densité et organisation de l'interface. Les changements s'appliquent immédiatement."
msgstr "Design, Farben, Hintergrund, Dichte und Aufbau der Oberfläche. Änderungen gelten sofort."

