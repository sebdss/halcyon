#: crates/halcyon-app/ui/pages/appearance.slint:81
msgid "Couleur d'accent"
msgstr "Akzentfarbe"

#: crates/halcyon-app/ui/pages/appearance.slint:82
msgid "Boutons, sélection et indicateurs. Une teinte personnalisée s'écrit #RRGGBB."
msgstr "Schaltflächen, Auswahl und Anzeigen. Ein eigener Farbton wird als #RRGGBB angegeben."

