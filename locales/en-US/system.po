msgstr "Checks the running game to notify you: Steam every 20 s from disk (2 min online with a key), RetroAchievements every 90 s."

#: crates/halcyon-app/ui/pages/settings.slint:638
msgid "Notifications de succès"
msgstr "Achievement notifications"

#: crates/halcyon-app/ui/pages/settings.slint:639
