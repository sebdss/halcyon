<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-halcyon-theme">
    <comment>Thème Halcyon</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.halcyontheme"/>
  </mime-type>
  <mime-type type="application/x-halcyon-plugin">
    <comment>Extension Halcyon</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.halcyonplugin"/>
  </mime-type>
</mime-info>
